68, 238978392), (53, 183264, 238241942), (52, 181585, 237512258), (51, 179932, 236789237), (51, 178303, 236072769), (50, 176700, 235362777), (49, 175120, 234659153), (48, 173563, 233961801), (47, 172029, 233270629), (47, 170518, 232585538), (46, 169029, 231906458), (45, 167561, 231233292), (45, 166114, 230565944), (44, 164688, 229904352), (44, 163283, 229248411), (43, 161897, 228598063), (42, 160531, 227953219), (42, 159184, 227313793), (41, 157855, 226679725), (41, 156545, 226050925), (40, 155253, 225427340), (39, 153979, 224808886), (39, 152722, 224195486), (38, 151482, 223587090), (38, 150259, 222983610), (37, 149052, 222385000), (37, 147861, 221791176), (37, 146686, 221202083), (36, 145526, 220617669), (35, 144382, 220037861), (35, 143252, 219462595), (35, 142138, 218891815), (34, 141037, 218325477), (34, 139951, 217763501), (33, 138878, 217205852), (33, 137820, 216652456), (32, 136775, 216103278), (32, 135742, 215558246), (32, 134723, 215017318), (31, 133716, 214480450), (31, 132722, 213947574), (31, 131741, 213418652), (30, 130770, 212893641), (30, 129812, 212372477), (29, 128866, 211855133), (29, 127931, 211341539), (29, 127007, 210831665), (28, 126095, 210325473), (28, 125193, 209822899), (28, 124302, 209323909), (27, 123422, 208828473), (27, 122551, 208336530), (27, 121691, 207848046), (26, 120841, 207362994), (26, 120001, 206881310), (26, 119170, 206402968), (26, 118350, 205927930), (25, 117538, 205456166), (25, 116736, 204987618), (25, 115943, 204522262), (24, 115158, 204060072), (24, 114383, 203600991), (24, 113616, 203144995), (24, 112858, 202692049), (23, 112108, 202242127), (23, 111366, 201795179), (23, 110632, 201351183), (23, 109907, 200910105), (22, 109189, 200471921), (22, 108480, 200036585), (22, 107778, 199604069), (22, 107083, 199174349), (21, 106395, 198747401), (21, 105716, 198323176), (21, 105044, 197901658), (21, 104377, 197482814), (20, 103720, 197066632), (20, 103068, 196653058), (20, 102423, 196242078), (20, 101785, 195833664), (20, 101154, 195427788), (19, 100528, 195024434), (19, 99910, 194623560), (19, 99297, 194225148), (19, 98691, 193829172), (19, 98092, 193435607), (19, 97497, 193044431), (18, 96909, 192655627), (18, 96328, 192269155), (18, 95751, 191884999), (18, 95180, 191503135), (18, 94616, 191123543), (17, 94056, 190746209), (17, 93502, 190371093), (17, 92954, 189998179))\\n\\n\\ndef load_or_build_tables(path=None, regenerate=False):\\n    \\\"\\\"\\\"Read explicit public numeric coefficients; optional open regeneration.\\n\\n    No circuit binary is reused. The 256-row table is Kozykorpesh's published\\n    exact-domain calibration, pinned to datasetVersionId 21136269. Keeping\\n    these ordinary integer triples explicit avoids numerical-environment\\n    changes silently modifying the scored model. The notebook independently\\n    certifies all 3,133,452 original inputs before building circuits.\\n    \\\"\\\"\\\"\\n    import json\\n    from pathlib import Path\\n    cfg = selected_cfg()\\n    expected_rows = [list(row) for row in _PUBLISHED_COEFFICIENT_ROWS]\\n    worst = 0.9628198889674466 / 2**24\\n    if regenerate:\\n        tables, worst = build_tables(cfg)\\n        regenerated = [list(tables[(e,a)]) for e in range(2) for a in range(128)]\\n        assert regenerated == expected_rows, 'Regenerated numeric coefficients differ from the explicit public table.'\\n    else:\\n        tables = {(i//128, i%128):tuple(row) for i,row in enumerate(expected_rows)}\\n    path = Path(path) if path else None\\n    if path and path.exists():\\n        saved = json.loads(path.read_text())\\n        assert saved['config'] == config_record(cfg)\\n        assert saved['rows'] == expected_rows, 'Cached coefficient table differs from the explicitly selected model.'\\n    elif path:\\n        path.write_text(json.dumps({'source':'Kozykorpesh exact-domain calibration; Atlas datasetVersionId21136269',\\n            'config':config_record(cfg), 'normalized_worst_relative_error':worst,\\n            'regeneration_is_optional':True, 'rows':expected_rows},indent=2))\\n    return cfg, tables, worst\\n\\n\\ndef integer_model(xs,cfg,tabs):\\n    \\\"\\\"\\\"Exact emitted arithmetic in units 2^-(cfg.fy+10) turns, before mod 1.\\\"\\\"\\\"\\n    xs=np.asarray(xs,dtype=np.int64)\\n    if not ((xs>=1)&(xs<=3133452)).all():\\n        raise ValueError('The supported competition domain is x=1..3133452')\\n    # All inputs fit exactly in float64; frexp gives the exact binary exponent.\\n    shifts=21-(np.frexp(xs)[1].astype(np.int64)-1)\\n    norm=xs << shifts\\n    assert ((norm >> 21)==1).all(), 'Normalized top-bit borrowing requires x[21]=1'\\n    parity=shifts&1\\n    index=((norm >> 14)&127)+128*parity\\n    table=np.asarray([tabs[(e,a)] for e in range(2) for a in range(128)],dtype=np.int64)\\n    K2,K1,K0=(table[index,j] for j in range(3))\\n    d=norm&((1 << DB)-1)\\n    signs=[2*((d >> i)&1)-1 for i in range(DB)]\\n    R=K1.copy()\\n    for i in cfg.rrow_list():\\n        R-=signs[i]*rd(K2,cfg.sh2[i])\\n    Q=np.zeros_like(xs)\\n    for i in reversed(range(DB)):\\n        Q+=signs[i]*rd(R,cfg.sh1[i])\\n    Y=((K0-Q) >> cfg.gy) << cfg.gy\\n    if (R<0).any() or (Y<0).any():\\n        raise OverflowError('An unsigned intermediate is negative')\\n    return Y << (shifts >> 1)\\n\\n\\ndef exhaustive_certificate(cfg,tabs,chunk_size=131072):\\n    \\\"\\\"\\\"Every promised basis input, exact integer target and tolerance.\\n\\n    This is an arithmetic certificate. Ancillas, restored inputs and phase\\n    feed-forward require fresh circuit simulation and the official verifier.\\n    \\\"\\\"\\\"\\n    output_fraction=cfg.fy+10\\n    worst_ratio,worst_x,min_margin=0.,0,1 << 64\\n    for start in range(1,3133453,chunk_size):\\n        xs=np.arange(start,min(start+chunk_size,3133453),dtype=np.int64)\\n        values=integer_model(xs,cfg,tabs).astype(np.uint64)\\n        phase=values << np.uint64(64-output_fraction)\\n        roots=[math.isqrt((1 << 130)//int(x)) for x in xs]\\n        target=np.array([((r+1) >> 1)&((1 << 64)-1) for r in roots],dtype=np.uint64)\\n        tolerance=np.array([min(r >> 25,1 << 63) for r in roots],dtype=np.uint64)\\n        error=np.abs((phase-target).view(np.int64)).view(np.uint64)\\n        ratio=error/tolerance\\n        i=int(np.argmax(ratio))\\n        if float(ratio[i])>worst_ratio:\\n            worst_ratio,worst_x=float(ratio[i]),int(xs[i])\\n        if (error>tolerance).any():\\n            i=int(np.flatnonzero(error>tolerance)[0])\\n            return {'pass':False,'first_bad_x':int(xs[i]),'ratio':float(ratio[i])}\\n        min_margin=min(min_margin,int((tolerance-error).min()))\\n    return {'pass':True,'tested_inputs':3133452,'worst_ratio':worst_ratio,\\n            'worst_x':worst_x,'min_margin_units':min_margin,\\n            'phase_fraction_bits':output_fraction}\\n\\n\\ndef conditional_toffoli_discount(circuit):\\n    \\\"\\\"\\\"Mean discount for this emitted family's fair HMR conditional branches.\\\"\\\"\\\"\\n    depth=0\\n    total=0\\n    discount=0.\\n    for line in str(circuit).splitlines():\\n        opcode=line.split(' ',1)[0]\\n        if opcode=='PUSH_CONDITION':depth+=1\\n        elif opcode=='POP_CONDITION':depth-=1\\n        elif opcode in ['CCX','CSWAP']:\\n            total+=1\\n            if depth:\\n                assert depth==1,'Expected one fair measurement bit in a Toffoli branch.'\\n                discount+=.5\\n    assert total==int(circuit.operation_statistics().num_toffoli_like)\\n    assert depth==0\\n    return discount\\n\\ndef estimated_resources(circuit,certificate):\\n    \\\"\\\"\\\"Model-based cost; full unchanged official verification remains required.\\\"\\\"\\\"\\n    assert certificate['pass'] and certificate['min_margin_units']>0\\n    stats=circuit.operation_statistics()\\n    rotations=int(stats.num_z_pow(min_clifford_hierarchy_level=4))\\n    epsilon=math.pi*(certificate['min_margin_units']/2**64)/rotations\\n    per_rotation=0.56*math.log2(1/epsilon)+5.3\\n    static_toffoli=int(stats.num_toffoli_like)\\n    # Fair flag measurements activate the emitted normalization phase-fixup\\n    # Toffolis on half the shots. Read their actual branch counts so the\\n    # original schedules discount 11 and the promise rewrite discounts 10.5.\\n    normalization_discount=conditional_toffoli_discount(circuit)\\n    expected_toffoli=static_toffoli-normalization_discount\\n    t_like=int(stats.num_t_like)\\n    extra=(t_like+rotations*per_rotation)/4\\n    return {'qubits':circuit.num_qubits,'static_toffoli':static_toffoli,\\n            'expected_mean_toffoli':expected_toffoli,'t_like':t_like,\\n            'rotations':rotations,'rotation_epsilon':epsilon,\\n            'estimated_expected_cost':circuit.num_qubits*(expected_toffoli+extra),\\n            'static_cost_upper_estimate':circuit.num_qubits*(static_toffoli+extra),\\n            'full_official_verification_required':True}\\n\\n\\n\\n\\n# ---- Our isolated phase scheduling, folded carry and borrowed workspace ----\\ndef folded_gadd(b,a,t,cin=None,sub=False,borrowed=()):\\n    a,t=list(a),list(t)\\n    o,n=len(a),len(t)\\n    assert o<=n and n>=1\\n    if sub:\\n        for q in t:b.x(q)\\n    if n==1:\\n        if o:b.cx(a[0],t[0])\\n        if cin is not None:b.cx(cin,t[0])\\n        if sub:\\n            for q in t:b.x(q)\\n        return\\n    borrowed=list(borrowed)[:max(0,n-2)]\\n    count=max(0,n-2-len(borrowed))\\n    allocated=b.alloc_qubits(count) if count else []\\n    c=borrowed+list(allocated)\\n    def C(i):return cin if i==0 else c[i-1]\\n    for i in range(n-2):\\n        if i==0 and cin is None:\\n            if o:b.init_and(a[0],t[0],C(1))\\n        elif i<o:\\n            b.cx(C(i),a[i]);b.cx(C(i),t[i])\\n            b.init_and(a[i],t[i],C(i+1));b.cx(C(i),C(i+1))\\n        else:\\n            b.init_and(C(i),t[i],C(i+1))\\n    i=n-2\\n    carry=C(i)\\n    if carry is None:\\n        if i<o:\\n            b.ccx(a[i],t[i],t[-1]);b.cx(a[i],t[i])\\n    elif i<o:\\n        b.cx(carry,a[i]);b.cx(carry,t[i])\\n        b.ccx(a[i],t[i],t[-1]);b.cx(carry,t[-1])\\n        b.cx(carry,a[i]);b.cx(a[i],t[i])\\n    else:\\n        b.ccx(carry,t[i],t[-1]);b.cx(carry,t[i])\\n    if n-1<o:b.cx(a[n-1],t[n-1])\\n    for i in reversed(range(n-2)):\\n        if i==0 and cin is None:\\n            if o:b.del_and(a[0],t[0],C(1));b.cx(a[0],t[0])\\n        elif i<o:\\n            b.cx(C(i),C(i+1));b.del_and(a[i],t[i],C(i+1))\\n            b.cx(C(i),a[i]);b.cx(a[i],t[i])\\n        else:\\n            b.del_and(C(i),t[i],C(i+1));b.cx(C(i),t[i])\\n    if count:b.free(allocated)\\n    if sub:\\n        for q in t:b.x(q)\\n\\n\\ndef truth_table_check(max_width=6,borrowed_count=0):\\n    class Bits:\\n        def __init__(self):self.v=[]\\n        def alloc_qubits(self,n):\\n            ids=list(range(len(self.v),len(self.v)+n));self.v.extend([0]*n);return ids\\n        def x(self,q):self.v[q]^=1\\n        def cx(self,a,t):self.v[t]^=self.v[a]\\n        def ccx(self,a,b,t):self.v[t]^=self.v[a]&self.v[b]\\n        def init_and(self,a,b,t):\\n            assert self.v[t]==0\\n            self.v[t]=self.v[a]&self.v[b]\\n        def del_and(self,a,b,t):\\n            assert self.v[t]==(self.v[a]&self.v[b])\\n            self.v[t]=0\\n        def free(self,reg):assert not any(self.v[q] for q in reg)\\n        def put(self,reg,value):\\n            for i,q in enumerate(reg):self.v[q]=(value >> i)&1\\n        def read(self,reg):return sum(self.v[q] << i for i,q in enumerate(reg))\\n    count=0\\n    for n in range(1,max_width+1):\\n        for m in range(n+1):\\n            for a in range(1 << m):\\n                for value in range(1 << n):\\n                    for cin_value in (None,0,1):\\n                        for sub in (False,True):\\n                            b=Bits();areg=b.alloc_qubits(m);target=b.alloc_qubits(n)\\n                            cin=b.alloc_qubits(1)[0] if cin_value is not None else None\\n                            if cin is not None:b.v[cin]=cin_value\\n                            b.put(areg,a);b.put(target,value)\\n                            borrowed=b.alloc_qubits(borrowed_count)\\n                            folded_gadd(b,areg,target,cin,sub,borrowed=borrowed)\\n                            delta=a+(cin_value or 0)\\n                            expected=(value-delta if sub else value+delta) % (1 << n)\\n                            assert b.read(target)==expected,(n,m,a,value,cin_value,sub)\\n                            assert b.read(areg)==a\\n                            assert cin is None or b.v[cin]==cin_value\\n                            assert not any(b.v[q] for q in borrowed)\\n                            count+=1\\n    return count\\n\\n\\ndef build_split_circuit(cfg,tabs,lay,adder=None,borrow_top=False):\\n    if adder is None:adder=gadd\\n    w2,w1,LB,S,whi=cfg.w2,lay['w1'],lay['LB'],lay['S'],lay['whi']\\n    b=km.CircuitBuilder()\\n    x=b.create_quantum_register(W,name='x')\\n    flags=b.alloc_qubits(5)\\n    normalize(b,x,flags)\\n    # Every promised positive input normalizes to x[21]=1. The arithmetic\\n    # address uses x[14:21] and delta x[:14], so this wire is idle in the core.\\n    if borrow_top:\\n        b.x(x[-1])\\n        raw_adder=adder\\n        def adder(builder,a,t,cin=None,sub=False):\\n            return raw_adder(builder,a,t,cin,sub,borrowed=(x[-1],))\\n    c2=b.alloc_qubits(w2)\\n    R=b.alloc_qubits(w1)\\n    Lr=b.alloc_qubits(LB)\\n    Yh=b.alloc_qubits(whi)\\n    remaining=km.array(list(Lr)+list(R)+list(c2))\\n    target=km.array(list(remaining)+list(Yh))\\n    table=[0]*256\\n    rest_table=[0]*256\\n    high_table=[0]*256\\n    for (e,a),(K2,K1,K0) in tabs.items():\\n        idx=a+128*e\\n        rest_table[idx]=lay['lo'][(e,a)] | (K1 << LB) | (K2 << (LB+w1))\\n        high_table[idx]=lay['hi'][(e,a)]\\n        table[idx]=rest_table[idx] | (high_table[idx] << (LB+w1+w2))\\n    address=km.array(list(x[14:21])+[flags[0]])\\n    delta=x[:DB]\\n    def rrows(inverse):\\n        seq=cfg.rrow_list()\\n        if inverse:seq=list(reversed(seq))\\n        for i in seq:\\n            sh=cfg.sh2[i]\\n            if sh>=0:off=c2[sh:w2];t=R[:w1];cin=c2[sh-1] if sh>=1 else None\\n            else:off=c2[:w2];t=R[-sh:w1];cin=None\\n            b.cx(delta[i],t);adder(b,off,t,cin,sub=inverse);b.cx(delta[i],t)\\n    def yrows(inverse):\\n        seq=list(reversed(range(DB)))\\n        if inverse:seq.reverse()\\n        for i in seq:\\n            sh=cfg.sh1[i]\\n            assert 0<=sh<w1\\n            cin=R[sh-1] if sh>=1 else None\\n            b.cx(delta[i],Lr);adder(b,R[sh:w1],Lr,cin,sub=inverse);b.cx(delta[i],Lr)\\n    def phase(reg,base_bit):\\n        ext=b.alloc_qubits(10)\\n        word=km.array(list(reg)+list(ext))\\n        shift_stages(b,flags,word,len(reg),False)\\n        for j in range(len(word)):\\n            exponent=base_bit+j-cfg.fy-10\\n            if exponent<0:b.z_pow(word[j],Fraction(2)**(exponent+1))\\n        shift_stages(b,flags,word,len(reg),True)\\n        b.free(ext)\\n    b.init_lookup(table=table,address=address,target=target)\\n    phase(Yh,S)\\n    b.del_lookup(table=high_table,address=address,target=Yh)\\n    b.free(Yh)\\n    rrows(False)\\n    yrows(False)\\n    phase(Lr[cfg.gy:LB],cfg.gy)\\n    yrows(True)\\n    rrows(True)\\n    b.del_lookup(table=rest_table,address=address,target=remaining)\\n    b.free(remaining)\\n    if borrow_top:b.x(x[-1])\\n    unnormalize(b,x,flags)\\n    b.free(flags)\\n    return b.finish_circuit()\\n\\n\\n\\ndef build_previous_schedule(cfg,tabs,lay=None):\\n    \\\"\\\"\\\"Regenerate 91Q circuit from the explicit model and credited schedules.\\\"\\\"\\\"\\n    if lay is None: lay=layout(cfg,tabs)\\n    return build_split_circuit(cfg,tabs,lay,adder=folded_gadd,borrow_top=True)\\n\\n\\n# The derivative-split version of this API is defined below.\\n\\n# The derivative-split version of this API is defined below.\\n\\n\\n\\n# The derivative-split version of this API is defined below.\\n\\n\\n\\n# The derivative-split version of this API is defined below.\\n\\n\\ndef cli():\\n    import argparse\\n    import json\\n    from pathlib import Path\\n    parser = argparse.ArgumentParser(description='Generate the credited signed-digit circuit and memory-schedule adaptation.')\\n    parser.add_argument('output', nargs='?', default='invsqrt.kmb')\\n    parser.add_argument('--baseline', action='store_true')\\n    args = parser.parse_args()\\n    cfg, tabs, _ = load_or_build_tables()\\n    certificate = exhaustive_certificate(cfg, tabs)\\n    if not certificate['pass']:\\n        raise ArithmeticError(certificate)\\n    lay = layout(cfg, tabs)\\n    circuit = build_memory_baseline(cfg, tabs, lay) if args.baseline else build_selected(cfg, tabs, lay)\\n    circuit.to_file(args.output, format='kmb')\\n    report = estimated_resources(circuit, certificate)\\n    report['arithmetic_certificate'] = certificate\\n    report['variant'] = 'sumit_baseline' if args.baseline else selected_descriptor()['variant']\\n    Path(args.output + '.resources.json').write_text(json.dumps(report, indent=2), encoding='utf-8')\\n    print(json.dumps(report, indent=2))\\n\\n\\n\\n\\n\\ndef _rudra_gadd_top_reused(b, source, target, cin=None, sub=False):\\n    \\\"\\\"\\\"Gidney addition with n-2 clean carries; the last carry targets the MSB.\\\"\\\"\\\"\\n    import kickmix as km\\n    a, t = list(source), list(target)\\n    n, m = len(t), len(a)\\n    assert n >= 1 and m <= n\\n    if sub:\\n        b.x(km.array(t))\\n    carries = b.alloc_qubits(n - 2) if n > 2 else km.array([])\\n    for i in range(n - 1):\\n        previous = cin if i == 0 else carries[i - 1]\\n        last = i == n - 2\\n        out = t[-1] if last else carries[i]\\n        if previous is None:\\n            if i < m:\\n                (b.ccx if last else b.init_and)(a[i], t[i], out)\\n        elif i < m:\\n            b.cx(previous, a[i]); b.cx(previous, t[i])\\n            (b.ccx if last else b.init_and)(a[i], t[i], out)\\n            b.cx(previous, out)\\n        else:\\n            (b.ccx if last else b.init_and)(previous, t[i], out)\\n    if n - 1 < m:\\n        b.cx(a[n - 1], t[n - 1])\\n    if n == 1 and cin is not None:\\n        b.cx(cin, t[0])\\n    for i in reversed(range(n - 1)):\\n        previous = cin if i == 0 else carries[i - 1]\\n        last = i == n - 2\\n        if previous is None:\\n            if i < m:\\n                if not last:\\n                    b.del_and(a[i], t[i], carries[i])\\n                b.cx(a[i], t[i])\\n        elif i < m:\\n            if not last:\\n                b.cx(previous, carries[i]); b.del_and(a[i], t[i], carries[i])\\n            b.cx(previous, a[i]); b.cx(a[i], t[i])\\n        else:\\n            if not last:\\n                b.del_and(previous, t[i], carries[i])\\n            b.cx(previous, t[i])\\n    if n > 2:\\n        b.free(carries)\\n    if sub:\\n        b.x(km.array(t))\\n\\ndef prepare_derivative_split(reference, cfg, tables):\\n    d = np.arange(1 << reference.DB, dtype=np.int64)\\n    coarse, residual = {}, {}\\n    bounds = {'normalized_addresses_checked': 0, 'min_residual': 1 << 30,\\n              'max_residual': 0, 'max_table_residual': 0, 'max_coarse': 0}\\n    for key, (k2, k1, _) in tables.items():\\n        derivative, _ = reference.pipeline(cfg, k2, k1, d)\\n        base = int(derivative.min()) >> 11\\n        low = derivative - (base << 11)\\n        coarse[key], residual[key] = base, k1 - (base << 11)\\n        assert 0 <= residual[key] < 1 << 12\\n        assert (low >= 0).all() and (low < 1 << 12).all()\\n        assert ((base + (low >> 11)) < 1 << 7).all()\\n        joined = (low & 2047) + ((base + (low >> 11)) << 11)\\n        assert np.array_equal(joined, derivative)\\n        bounds['normalized_addresses_checked'] += len(d)\\n        bounds['min_residual'] = min(bounds['min_residual'], int(low.min()))\\n        bounds['max_residual'] = max(bounds['max_residual'], int(low.max()))\\n        bounds['max_table_residual'] = max(bounds['max_table_residual'], residual[key])\\n        bounds['max_coarse'] = max(bounds['max_coarse'], base)\\n    assert cfg.w2 >= 6 and len(cfg.rrow_list()) == 8\\n    return {'coarse': coarse, 'residual': residual}, bounds\\n\\ndef _build_derivative_circuit(reference, cfg, tables, layout, split, borrow_top=False):\\n    import kickmix as km\\n    assert (layout['w1'], layout['LB'], layout['S'], layout['whi']) == (18, 21, 20, 8)\\n    b = km.CircuitBuilder()\\n    x = b.create_quantum_register(22, name='x')\\n    flags = b.alloc_qubits(5)\\n    # These coefficients are still zero during normalization; allocate afterward.\\n    reference.normalize(b, x, flags)\\n    if borrow_top: b.x(x[-1])\\n    def adder(builder,a,t,cin=None,sub=False):\\n        if borrow_top: return folded_gadd(builder,a,t,cin,sub,borrowed=(x[-1],))\\n        return _rudra_gadd_top_reused(builder,a,t,cin,sub)\\n    c2, residual, coarse, low, high = [b.alloc_qubits(n) for n in [cfg.w2, 12, 7, 21, 8]]\\n    full_target = km.array(list(low) + list(residual) + list(c2) + list(high) + list(coarse))\\n    rest_target = km.array(list(low) + list(residual) + list(c2) + list(coarse))\\n    full_table, rest_table, high_table = [0] * 256, [0] * 256, [0] * 256\\n    for (parity, address), (k2, _, _) in tables.items():\\n        key, index = (parity, address), address + 128 * parity\\n        common = layout['lo'][key] | (split['residual'][key] << 21) | (k2 << 33)\\n        full_table[index] = common | (layout['hi'][key] << (33+cfg.w2)) | (split['coarse'][key] << (41+cfg.w2))\\n        rest_table[index] = common | (split['coarse'][key] << (33+cfg.w2))\\n        high_table[index] = layout['hi'][key]\\n    address = km.array(list(x[14:21]) + [flags[0]])\\n    delta = x[:14]\\n\\n    def phase_register(register, low_bit):\\n        ext = b.alloc_qubits(10)\\n        word = km.array(list(register) + list(ext))\\n        reference.shift_stages(b, flags, word, len(register), False)\\n        for i, qubit in enumerate(word):\\n            exponent = low_bit + i - cfg.fy - 10\\n            if exponent < 0:\\n                b.z_pow(qubit, Fraction(2) ** (exponent + 1))\\n        reference.shift_stages(b, flags, word, len(register), True)\\n        b.free(ext)\\n\\n    def inner(inverse):\\n        rows = cfg.rrow_list()\\n        for i in reversed(rows) if inverse else rows:\\n            shift = cfg.sh2[i]\\n            # A narrower curvature coefficient can require an exact left shift.\\n            # Add to the corresponding residual suffix, leaving lower bits intact.\\n            if shift>=0:\\n                addend=c2[shift:];target=residual\\n                carry=c2[shift-1] if shift else None\\n            else:\\n                addend=c2;target=residual[-shift:];carry=None\\n            b.cx(delta[i],target)\\n            adder(b,addend,target,carry,sub=inverse)\\n            b.cx(delta[i],target)\\n\\n    def outer(derivative, inverse):\\n        for i in range(14) if inverse else reversed(range(14)):\\n            shift = cfg.sh1[i]\\n            carry = derivative[shift - 1] if shift else None\\n            b.cx(delta[i], low)\\n            adder(b, derivative[shift:], low, carry, sub=inverse)\\n            b.cx(delta[i], low)\\n\\n    b.init_lookup(table=full_table, address=address, target=full_target)\\n    phase_register(high, 20)\\n    # High and the shift workspace have been restored. For every X-measurement\\n    # mask m, unlookup contributes (-1)^(m.high(address)); its phase correction\\n    # contributes the same sign. Their product is +1, preserving our phase.\\n    # Address and its parity flag stay live and unchanged until after erasure.\\n    b.del_lookup(table=high_table, address=address, target=high)\\n    b.free(high)\\n    inner(False)\\n    adder(b, residual[11:], coarse)\\n    derivative = residual[:11] + coarse\\n    outer(derivative, False)\\n    # Include bit20 here. There is no output join: floor((L+2^20H)/4)\\n    # equals floor(L/4)+2^18H, so the two diagonal phases add exactly.\\n    phase_register(low[cfg.gy:], cfg.gy)\\n    outer(derivative, True)\\n    adder(b, residual[11:], coarse, sub=True)\\n    inner(True)\\n    b.del_lookup(table=rest_table, address=address, target=rest_target)\\n    b.free(rest_target)\\n    if borrow_top: b.x(x[-1])\\n    reference.unnormalize(b, x, flags)\\n    b.free(flags)\\n    return b.finish_circuit()\\n\\n\\ndef _derivative_reference(promise):\\n    return types.SimpleNamespace(**dict(globals(),\\n        normalize=normalize if promise else _combined_normalize,\\n        unnormalize=unnormalize if promise else _baseline_unnormalize))\\n\\n\\ndef _build_derivative_variant(cfg,tabs,lay,borrow,promise):\\n    if lay is None:lay=layout(cfg,tabs)\\n    reference=_derivative_reference(promise)\\n    split,bounds=prepare_derivative_split(reference,cfg,tabs)\\n    return _build_derivative_circuit(reference,cfg,tabs,lay,split,borrow_top=borrow)\\n\\n\\ndef build_selected(cfg,tabs,lay=None):\\n    \\\"\\\"\\\"Regenerate selected92Q derivative split with borrowed carry and domain rewrite.\\\"\\\"\\\"\\n    return _build_derivative_variant(cfg,tabs,lay,borrow=True,promise=True)\\n\\n\\ndef build_memory_baseline(cfg,tabs,lay=None):\\n    \\\"\\\"\\\"Same Kozykorpesh coefficient model, Rudra/Kirill derivative schedule:93Q.\\\"\\\"\\\"\\n    return _build_derivative_variant(cfg,tabs,lay,borrow=False,promise=False)\\n\\n\\ndef build_borrowed_baseline(cfg,tabs,lay=None):\\n    \\\"\\\"\\\"Same derivative schedule with the normalized input bit borrowed:92Q.\\\"\\\"\\\"\\n    return _build_derivative_variant(cfg,tabs,lay,borrow=True,promise=False)\\n\\n\\ndef build_combined_baseline(cfg,tabs,lay=None):\\n    \\\"\\\"\\\"Compatibility alias for the borrowed-carry comparison.\\\"\\\"\\\"\\n    return build_borrowed_baseline(cfg,tabs,lay)\\n\\n\\ndef comparison_report(cfg,tabs,certificate,lay=None):\\n    \\\"\\\"\\\"One fixed coefficient table: derivative schedule, borrow, domain rewrite.\\\"\\\"\\\"\\n    if lay is None:lay=layout(cfg,tabs)\\n    return {\\n        'baseline':estimated_resources(build_memory_baseline(cfg,tabs,lay),certificate),\\n        'borrowed':estimated_resources(build_borrowed_baseline(cfg,tabs,lay),certificate),\\n        'selected':estimated_resources(build_selected(cfg,tabs,lay),certificate),\\n        'selected_descriptor':selected_descriptor()}\\n\\n\\ndef selected_descriptor():\\n    return {\\n        'variant':'kozy_table_rudra_split_alex_schedule_borrow_and_domain',\\n        'source_author':'Sumit Chongder; Rudra Bhaskar; Alex Chilton; Kozykorpesh; Kirill Tymchishin; anazemcev / Artem1410',\\n        'source_url':'https://www.kaggle.com/code/kirilltym/quantum-circuits-qrom-tower42?scriptVersionId=361491814',\\n        'coefficient_source':'Kozykorpesh Quantum Circuit Toolbox datasetVersionId21136269, code/coefficients.json; same256-row model as our preceding91Q revision',\\n        'configuration':{'f2':8,'f1':19,'fyr':27,'gy':1,'drop2':[5]},\\n        'license_as_published':'Apache-2.0, subject to retained upstream notices',\\n        'baseline_definition':'Same fixed Kozykorpesh table with the Rudra derivative split and Alex normalization/shifts, before normalized-input carry borrowing:93Q',\\n        'baseline_canonical_sha256':'9e67c00941ff0623cfaf22f133fe7f70740f8b0a163a4ba64c6fdcd1c9446295',\\n        'borrowed_canonical_sha256':'f3f8457058aecdcf2650e00b411234899cb01933b79a1f6519c0bf28b49591bc',\\n        'selected_canonical_sha256':'63f70e623dd995f4f87ca13254f46f991a5ae545d4c20c80e8510f5ff0a49bbd',\\n        'historical_kirill95_sha256':'497b161bc468654b5b2570cfaa006ce336dec9b8c89f82f048fcca4e6e8f7919',\\n        'previous_same_table91_sha256':'e3db0cc65b4771b640fbcd73d770d2015c232e9f54bd69479786fb5445ca76b9',\\n        'measured_counts':{'qubits':92,'static_toffoli':1472,'rotations':45},\\n        'expected_mean_toffoli':1461.5,\\n        'estimated_cost':164645.89641938862,\\n        'own_changes_in_this_revision':[\\n            'Combine the published derivative-split representation with the previously selected explicit Kozykorpesh coefficient model',\\n            'Parameterize curvature storage and exact left-shift rows without changing the integer pipeline',\\n            'Borrow normalized x[21] as clean adder carry, restoring it before inverse normalization',\\n            'Retain our exact original-input top-bit mutual-exclusion rewrite'],\\n        'upstream_contributions':'Rudra derivative split/top-carry/static-high phase checkpoint; Alex prefix flags/empty-target shift; Kirill exact integration; Sumit model; Kozykorpesh precision calibration',\\n        'full_official_verification':'Required separately; actual unchanged full-verifier report identifies the selected hash'}\\n\\n\\nif __name__ == '__main__':\\n    cli()\\n\"},{\"cell_type\":\"code\",\"execution_count\":null,\"id\":\"b0d63cb1\",\"metadata\":{},\"outputs\":[],\"source\":\"implementation_path = Path('signed_digit_lab.py').resolve()\\nspec = importlib.util.spec_from_file_location('signed_digit_lab', implementation_path)\\nsigned_lab = importlib.util.module_from_spec(spec)\\nsys.modules[spec.name] = signed_lab\\nspec.loader.exec_module(signed_lab)\\nsigned_cfg, signed_tables, normalized_worst = signed_lab.load_or_build_tables(WORK / 'coefficient_table.json')\\nsigned_layout = signed_lab.layout(signed_cfg, signed_tables)\\nsigned_certificate = signed_lab.exhaustive_certificate(signed_cfg, signed_tables)\\nassert signed_certificate['pass'] and signed_certificate['tested_inputs'] == 3_133_452\\nsave_json(REPORTS / 'invsqrt_integer_certificate.json', signed_certificate)\\nprint(json.dumps(signed_certificate, indent=2))\\nsigned_comparison = signed_lab.comparison_report(signed_cfg, signed_tables, signed_certificate, signed_layout)\\nsave_json(REPORTS / 'invsqrt_resource_comparison.json', signed_comparison)\\ncomparison_rows = []\\nfor key, label in [('baseline', 'Derivative split + public schedules'),\\n                   ('borrowed', '+ Our constant carry borrowing'),\\n                   ('selected', '+ Our promised-domain simplification')]:\\n    item = signed_comparison[key]\\n    comparison_rows.append({'Construction': label, 'Qubits': item['qubits'],\\n        'Static Toffolis': item['static_toffoli'], 'Expected mean Toffolis': item['expected_mean_toffoli'],\\n        'Rotations': item['rotations'], 'Estimated cost': item['estimated_expected_cost']})\\ndisplay(pd.DataFrame(comparison_rows).style.format({'Estimated cost': '{:,.3f}'}))\\nprint('All three comparisons hold the coefficient table fixed. Full measured costs follow below.')\\ndescriptor = signed_lab.selected_descriptor()\\nfor key, constructor, hash_key in [\\n    ('baseline', signed_lab.build_memory_baseline, 'baseline_canonical_sha256'),\\n    ('borrowed', signed_lab.build_borrowed_baseline, 'borrowed_canonical_sha256')]:\\n    circuit = constructor(signed_cfg, signed_tables, signed_layout)\\n    path = PUBLIC / f'{key}.kmb'\\n    circuit.to_file(str(path), format='kmb')\\n    assert digest(path) == descriptor[hash_key], key\\n    del circuit\\ninv_candidate = signed_lab.build_selected(signed_cfg, signed_tables, signed_layout)\\ninv_candidate.to_file(str(FINAL / 'invsqrt.kmb'), format='kmb')\\nassert digest(FINAL / 'invsqrt.kmb') == descriptor['selected_canonical_sha256']\\nprint('All three canonical circuit hashes reproduced; selected arithmetic is 92Q/1472staticT.')\\n\"},{\"cell_type\":\"code\",\"execution_count\":null,\"id\":\"49adf1d7\",\"metadata\":{},\"outputs\":[],\"source\":\"labels = ['Derivative split\\\\n+ public schedules', '+ carry borrowing', '+ promised domain']\\ncounts = [signed_comparison[key] for key in ['baseline', 'borrowed', 'selected']]\\nfig, axes = plt.subplots(1, 2, figsize=(11.3, 4.1))\\nvalues = [row['estimated_expected_cost'] for row in counts]\\nbars = axes[0].bar(labels, values, color=[COLORS['muted'], COLORS['blue'], COLORS['green']], width=0.58)\\naxes[0].bar_label(bars, labels=[f'{value:,.0f}' for value in values], padding=4)\\naxes[0].set(title='Ablation with one coefficient table', ylabel='Estimated arithmetic cost', ylim=(0, max(values)*1.16))\\naxes[0].grid(axis='y',alpha=0.15);axes[0].set_axisbelow(True)\\npoints = [\\n    (92, 173371.4789622425, 'Previous 92Q release', COLORS['muted'], (5, 7)),\\n    (91, 170500.2819152706, '91Q Horner alternative', COLORS['blue'], (6, 4)),\\n    (95, 168521.12561328438, 'Kirill 95Q integration', COLORS['orange'], (-113, 6)),\\n    (92, signed_comparison['selected']['estimated_expected_cost'], 'This 92Q derivative split', COLORS['green'], (7, -17))]\\nfor qubits, cost, label, color, offset in points:\\n    axes[1].scatter(qubits,cost,s=85,color=color,zorder=3)\\n    axes[1].annotate(label,(qubits,cost),xytext=offset,textcoords='offset points',fontsize=9)\\naxes[1].set(title='Memory and gate cost together', xlabel='Peak qubits', ylabel='Arithmetic circuit cost',\\n            xlim=(90.5,95.6),ylim=(162000,176000),xticks=range(91,96))\\naxes[1].grid(alpha=0.15);axes[1].set_axisbelow(True)\\nfig.tight_layout()\\nfig.savefig(FIGURES / 'arithmetic_ablation.png',dpi=180,bbox_inches='tight')\\nplt.show();plt.close(fig)\\nprint('Historical points use their full verifier reports; this run point uses its certified resource model.')\\nprint('The 91Q alternative shares the current table. The previous 92Q and Kirill 95Q used their published coefficient models.')\\n\"},{\"cell_type\":\"markdown\",\"id\":\"57fa9e79\",\"metadata\":{},\"source\":\"## Chemistry: turn lookup tables into Boolean polynomials\\n\\nThe unchanged chemistry factorization supplies **3,976 addresses and 75 ten-bit angle words**. Five words per batch produce **15 ANGLE circuits**. The full objective remains $\\\\lambda_{\\\\rm eff}TQ$, including persistent words and the shared maximum temporary workspace.\\n\\nKozykorpesh and Sumit's banked lookup, integrated with our factors by Kirill, writes $a=2h+\\\\ell$ and applies\\n\\n$$z\\\\mapsto z\\\\oplus d_0[h]\\\\oplus\\\\ell\\\\bigl(d_0[h]\\\\oplus d_1[h]\\\\bigr).$$\\n\\nOur previous compiler removed zero and linearly dependent difference coordinates. A reversible CNOT basis change $T$ acts on **both** lookup tables and conjugates the arbitrary target:\\n\\n$$T^{-1}(Tz\\\\oplus Tf(a))=z\\\\oplus f(a).$$\\n\\nThis revision also changes how the table and its measurement cleanup are evaluated.\\n\\n### 1. Compute the main table in algebraic normal form\\n\\nFor a Boolean table column $F$, the GF(2) Mobius transform gives coefficients $c_m$ such that\\n\\n$$F(h)=\\\\bigoplus_{m\\\\subseteq h}c_m,\\\\qquad\\n c_m=\\\\bigoplus_{r\\\\subseteq m}F(r).$$\\n\\nA depth-first schedule computes each needed monomial with a temporary AND, updates the output coordinates with CNOTs, then clears the monomial with measurement and its phase correction. Constant and linear terms need no Toffoli.\\n\\nHere $0\\\\le h<1988$. If a mask $m\\\\ge1988$ were a bit-subset of $h$, it would imply $m\\\\le h$, a contradiction. Those monomials vanish on every legal address and can be omitted exactly. The remaining nonlinear count is **1988 - 1 - 11 = 1976**, saving ten Toffoli per batch against the earlier loader.\\n\\n### 2. Use polynomial phase cleanup\\n\\nMeasurement of the lookup bank induces a Boolean phase polynomial in the address. We compute its coefficients classically from the measurement bits, then apply the corresponding Z/CZ corrections with the same monomial schedule. Six address bits require **57** nonlinear monomials; with the other five-bit part, cleanup uses **83** Toffoli instead of **88**. No measurement phase is dropped or approximated.\\n\\nAcross 15 batches and the complete forward/reverse use, the two changes save\\n\\n$$2\\\\times15\\\\times(10+5)=\\\\mathbf{450}\\\\ \\\\text{Toffoli}.$$\\n\\nThe full verifier measures **71,958 Toffoli and 681 system qubits**. The largest ANGLE circuit uses **121 qubits**, below the 128-qubit cap. Coefficients, angle words and numerical approximation are unchanged. Integer table certificates cover every address; the unchanged official verifier checks emitted values, cleanup and phases.\\n\"},{\"cell_type\":\"code\",\"execution_count\":null,\"id\":\"cdbea49d\",\"metadata\":{\"_kg_hide-input\":true,\"_kg_hide-output\":true,\"collapsed\":true,\"hide_input\":true,\"jupyter\":{\"source_hidden\":true}},\"outputs\":[],\"source\":\"%%writefile banked_lab.py\\n\\\"\\\"\\\"Truncated ANF bank loading and split ANF erasure for exact ANGLES XOR.\\n\\nThe contiguous prefix of1988 high addresses uses1976 nonlinear monomials\\nversus1986 unary products. All legal rows are certified unchanged. A precise\\npolynomial extension defines the other60 rows and is used for cleanup too.\\n\\nOwn follow-up: eleven-bit measurement correction uses 83 Toffoli instead of88,\\nusing a split Boolean algebraic normal form and measurement-erased products.\\n\\nSPDX-License-Identifier: Apache-2.0\\n\\nBanked QROM construction adapted from Kozykorpesh / Sumit Chongder:\\nhttps://www.kaggle.com/code/kozykappa/quantum-ai-compact-arithmetic-banked-qrom?scriptVersionId=361433617\\nhttps://www.kaggle.com/code/sumitchongder/notebook2f196e646b?scriptVersionId=361357149\\nRead through Kirill Tym's public quantum-circuits-qrom-tower42 v10 source.\\n\\nOur change: allocate only nonzero difference columns. Optionally conjugate the\\ntarget by a reversible CNOT change of basis, reducing the difference bank to\\nits GF(2) column rank. The same change is applied to BOTH lookup tables. Thus\\nthe input target can be arbitrary: T^-1(T z XOR T f(a)) = z XOR f(a).\\nNo coefficient, angle word, address, or measurement branch is approximated.\\n\\nNumeric/profile operations work without kickmix. Circuit building/testing\\nrequires the competition's Linux kickmix package.\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport argparse\\nimport hashlib\\nimport json\\nfrom math import ceil\\nfrom pathlib import Path\\n\\nimport numpy as np\\n\\n\\ndef batch_deltas(words, J=5):\\n    words = np.asarray(words, dtype=np.int64)\\n    nv, na = words.shape\\n    padded = np.zeros((nv, ceil(na / J) * J), dtype=np.int64)\\n    padded[:, :na] = words\\n    batches = padded.reshape(nv, -1, J).transpose(1, 0, 2)\\n    result = batches.copy()\\n    result[1:] ^= batches[:-1]\\n    return result\\n\\n\\ndef pack(row, brot):\\n    return sum(int(value) << (j * brot) for j, value in enumerate(row))\\n\\n\\ndef _change_basis(values, operations):\\n    result = list(values)\\n    for source, target in operations:\\n        result = [value ^ (((value >> source) & 1) << target)\\n                  for value in result]\\n    return result\\n\\n\\ndef difference_tables(delta, brot=10, mode=\\\"zero\\\"):\\n    \\\"\\\"\\\"Return packed d0, compact dd, and exact reversible output transforms.\\\"\\\"\\\"\\n    if mode not in {\\\"baseline\\\", \\\"zero\\\", \\\"linear\\\"}:\\n        raise ValueError(\\\"mode must be baseline, zero, or linear\\\")\\n    delta = np.asarray(delta, dtype=np.int64)\\n    if delta.ndim != 2 or len(delta) < 4:\\n        raise ValueError(\\\"expected at least four address rows\\\")\\n    if np.any(delta < 0) or np.any(delta >= (1 << brot)):\\n        raise ValueError(\\\"angle word out of range\\\")\\n    A, J = delta.shape\\n    width = J * brot\\n    d0 = [pack(row, brot) for row in delta[::2]]\\n    d1 = [pack(delta[2 * h + 1], brot) if 2 * h + 1 < A else value\\n          for h, value in enumerate(d0)]\\n    dd = [a ^ b for a, b in zip(d0, d1)]\\n    paired = delta[::2].copy()\\n    paired[:len(delta[1::2])] ^= delta[1::2]\\n    if A & 1:\\n        paired[-1] = 0\\n    bit_columns = ((paired[:, :, None] >> np.arange(brot)) & 1).reshape(H := len(d0), width).T\\n    packed_columns = np.packbits(bit_columns.astype(np.uint8), axis=1, bitorder=\\\"little\\\")\\n    columns = [int.from_bytes(column.tobytes(), \\\"little\\\") for column in packed_columns]\\n    active = [bit for bit, column in enumerate(columns) if column]\\n    unique = len(set(columns) - {0})\\n    basis = {}\\n    operations = []\\n    reduced = columns.copy()\\n    for bit, original in enumerate(columns):\\n        column = original\\n        relation = 0\\n        while column:\\n            pivot = column.bit_length() - 1\\n            if pivot not in basis:\\n                basis[pivot] = (column, relation ^ (1 << bit))\\n                break\\n            value, combination = basis[pivot]\\n            column ^= value\\n            relation ^= combination\\n        if not column:\\n            # Independent coordinates retain their original values. A dependent\\n            # coordinate is zeroed by XORing only independent coordinates into it.\\n            # In particular, identical columns need just one CNOT each way.\\n            operations.extend((source, bit) for source in range(width)\\n                              if (relation >> source) & 1)\\n            reduced[bit] = 0\\n    rank = len(basis)\\n    if mode == \\\"linear\\\":\\n        d0 = _change_basis(d0, operations)\\n        transformed_dd = _change_basis(dd, operations)\\n        active = [bit for bit, column in enumerate(reduced) if column]\\n    else:\\n        transformed_dd = dd\\n        operations = []\\n        if mode == \\\"baseline\\\":\\n            active = list(range(width))\\n    compact = [sum(((value >> bit) & 1) << target\\n                   for target, bit in enumerate(active))\\n               for value in transformed_dd]\\n    # A complete integer certificate of the table identity for every legal a.\\n    reconstructed = [sum(((value >> target) & 1) << bit\\n                         for target, bit in enumerate(active)) for value in compact]\\n    restored = _change_basis(\\n        [d0[a // 2] ^ (reconstructed[a // 2] if a & 1 else 0)\\n         for a in range(A)], reversed(operations))\\n    assert restored == [pack(row, brot) for row in delta]\\n    return d0, compact, active, operations, {\\n        \\\"rows\\\": A, \\\"width\\\": width, \\\"active_columns\\\": sum(bool(c) for c in columns),\\n        \\\"unique_nonzero_columns\\\": unique, \\\"gf2_rank\\\": rank,\\n        \\\"bank_width\\\": len(active), \\\"basis_cnot_count\\\": 2 * len(operations),\\n        \\\"integer_table_certificate\\\": \\\"PASS\\\", \\\"mode\\\": mode,\\n    }\\n\\n\\ndef mobius_transform(table):\\n    \\\"\\\"\\\"Packed-output Boolean truth table <-> ANF coefficient table over GF(2).\\\"\\\"\\\"\\n    result = list(map(int, table))\\n    if not result or len(result) & (len(result) - 1):\\n        raise ValueError(\\\"truth-table length must be a power of two\\\")\\n    n = (len(result) - 1).bit_length()\\n    for bit in range(n):\\n        step = 1 << bit\\n        for start in range(0, len(result), 2 * step):\\n            for offset in range(step):\\n                result[start + step + offset] ^= result[start + offset]\\n    return result\\n\\n\\ndef del_lookup_anf(builder, *, table, address, target, low_bits=None):\\n    \\\"\\\"\\\"Clear table[address] with exact conditional ANF phase correction.\\n\\n    `target` must contain the given lookup value and remain allocated. Extra\\n    scratch is allocated only when the reset target is too narrow. Clean target\\n    wires are reused internally; all target and extra scratch finish at zero.\\n    \\\"\\\"\\\"\\n    import kickmix as km\\n    address = list(address)\\n    target = list(target)\\n    n = len(address)\\n    if len(table) != 1 << n:\\n        raise ValueError(\\\"lookup table must cover the complete address space\\\")\\n    if n < 2:\\n        raise ValueError(\\\"split ANF cleanup expects at least two address bits\\\")\\n    low_bits = n // 2 if low_bits is None else low_bits\\n    if not 0 < low_bits < n:\\n        raise ValueError(\\\"both address halves must be nonempty\\\")\\n    if any(value < 0 or value >= (1 << len(target)) for value in table):\\n        raise ValueError(\\\"lookup value does not fit the target\\\")\\n    coefficients = mobius_transform(table)\\n    assert mobius_transform(coefficients) == list(table), \\\"exact ANF identity failed\\\"\\n    measurements = builder.alloc_bits(len(target))\\n    builder.hmr(km.array(target), measurements)\\n    parity = builder.alloc_bits(1)[0]\\n\\n    low_count = 1 << low_bits\\n    high_bits = n - low_bits\\n    retained_masks = [mask for mask in range(1, low_count) if mask.bit_count() > 1]\\n    scratch_count = len(retained_masks) + high_bits - 1\\n    extra = builder.alloc_qubits(max(0, scratch_count - len(target)))\\n    scratch = target + list(extra)\\n    low = {1 << bit: address[bit] for bit in range(low_bits)}\\n    for mask, qubit in zip(retained_masks, scratch):\\n        bit = mask.bit_length() - 1\\n        parent = mask ^ (1 << bit)\\n        builder.init_and(low[parent], address[bit], qubit)\\n        low[mask] = qubit\\n    carries = scratch[len(retained_masks):scratch_count]\\n\\n    def correct(high_mask, high_qubit):\\n        for low_mask in range(low_count):\\n            coefficient = coefficients[low_mask | (high_mask << low_bits)]\\n            if not coefficient:\\n                continue\\n            builder.bit_store(parity, False)\\n            while coefficient:\\n                bit = (coefficient & -coefficient).bit_length() - 1\\n                builder.cx(measurements[bit], parity)\\n                coefficient &= coefficient - 1\\n            if not low_mask and not high_mask:\\n                builder.neg_if(parity)\\n                continue\\n            builder.push_condition(parity)\\n            if not low_mask:\\n                builder.z(high_qubit)\\n            elif not high_mask:\\n                builder.z(low[low_mask])\\n            else:\\n                builder.cz(low[low_mask], high_qubit)\\n            builder.pop_condition()\\n\\n    def walk(mask, highest_bit, control):\\n        correct(mask, control)\\n        for bit in range(highest_bit + 1, high_bits):\\n            child_mask = mask | (1 << bit)\\n            if not mask:\\n                walk(child_mask, bit, address[low_bits + bit])\\n            else:\\n                child = carries[mask.bit_count() - 1]\\n                builder.init_and(control, address[low_bits + bit], child)\\n                walk(child_mask, bit, child)\\n                builder.del_and(control, address[low_bits + bit], child)\\n\\n    walk(0, -1, None)\\n    for mask in reversed(retained_masks):\\n        bit = mask.bit_length() - 1\\n        parent = mask ^ (1 << bit)\\n        builder.del_and(low[parent], address[bit], low[mask])\\n    builder.free(extra)\\n    return {\\\"address_bits\\\": n, \\\"low_bits\\\": low_bits, \\\"high_bits\\\": high_bits,\\n            \\\"retained_products\\\": len(retained_masks), \\\"traversal_carries\\\": high_bits - 1,\\n            \\\"anf_toffoli\\\": (1 << low_bits) - low_bits - 1 + (1 << high_bits) - high_bits - 1,\\n            \\\"scratch_count\\\": scratch_count, \\\"anf_table_identity\\\": \\\"PASS\\\"}\\n\\n\\ndef init_banked_truncated_anf(builder, *, d0, dd, address, target, bank, scratch):\\n    \\\"\\\"\\\"XOR d0[h] into target, dd[h] into bank; return the completed dd table.\\n\\n    Requires `mobius_transform` in the surrounding module (anf_cleanup.py).\\n    Legal h ranges from zero through len(d0)-1. `scratch` is clean and remains\\n    clean. All target bits may start arbitrary; bank initialization is the\\n    caller's usual clean lookup bank.\\n    \\\"\\\"\\\"\\n    import kickmix as km\\n    address, target, bank, scratch = map(list, (address, target, bank, scratch))\\n    H, n, W = len(d0), len(address), len(target)\\n    if len(dd) != H or H > (1 << n) or H <= (1 << (n - 1)):\\n        raise ValueError(\\\"expected a nonempty prefix using every address bit\\\")\\n    if len(scratch) < n - 1:\\n        raise ValueError(\\\"need n-1 clean traversal carry wires\\\")\\n    original = [int(first) | (int(second) << W) for first, second in zip(d0, dd)]\\n    coefficients = mobius_transform(original + [0] * ((1 << n) - H))\\n    coefficients[H:] = [0] * ((1 << n) - H)\\n    completed = mobius_transform(coefficients)\\n    assert completed[:H] == original, \\\"truncated ANF changed a legal table row\\\"\\n    assert mobius_transform(completed) == coefficients\\n    outputs = target + bank\\n\\n    def load(mask, control):\\n        value = coefficients[mask]\\n        targets = [outputs[bit] for bit in range(len(outputs)) if (value >> bit) & 1]\\n        if targets:\\n            if control is None:\\n                builder.x(km.array(targets))\\n            else:\\n                builder.cx(control, km.array(targets))\\n\\n    def walk(mask, highest_bit, control):\\n        load(mask, control)\\n        for bit in range(highest_bit + 1, n):\\n            child_mask = mask | (1 << bit)\\n            if child_mask >= H:\\n                continue\\n            if not mask:\\n                walk(child_mask, bit, address[bit])\\n            else:\\n                child = scratch[mask.bit_count() - 1]\\n                builder.init_and(control, address[bit], child)\\n                walk(child_mask, bit, child)\\n                builder.del_and(control, address[bit], child)\\n\\n    walk(0, -1, None)\\n    return [value >> W for value in completed], {\\n        \\\"legal_high_addresses\\\": H, \\\"address_bits\\\": n,\\n        \\\"nonlinear_products\\\": H - 1 - n,\\n        \\\"previous_unary_products\\\": H - 2,\\n        \\\"exact_legal_table_identity\\\": \\\"PASS\\\",\\n        \\\"extension_mobius_identity\\\": \\\"PASS\\\",\\n        \\\"completed_high_addresses\\\": (1 << n) - H,\\n        \\\"max_required_carries\\\": n - 1,\\n    }\\n\\n\\ndef build_qroam2(delta, brot=10, *, mode=\\\"zero\\\", return_report=False):\\n    \\\"\\\"\\\"Exact banked XOR oracle; same public register contract as upstream.\\\"\\\"\\\"\\n    import kickmix as km\\n    delta = np.asarray(delta, dtype=np.int64)\\n    A, J = delta.shape\\n    nbits = (A - 1).bit_length()\\n    H = (A + 1) // 2\\n    hbits = nbits - 1\\n    W = J * brot\\n    d0, dd, active, transforms, report = difference_tables(delta, brot, mode)\\n    b = km.CircuitBuilder()\\n    sel = b.create_quantum_register(nbits, \\\"selection\\\")\\n    words = [b.create_quantum_register(brot, f\\\"word_{j}\\\") for j in range(J)]\\n    tgt = [q for word in words for q in word]\\n    for source, target in transforms:\\n        b.cx(tgt[source], tgt[target])\\n    B = b.alloc_qubits(len(active))\\n    hreg = sel[1:nbits]\\n    anc = b.alloc_qubits(hbits - 1)\\n    completed_dd, load_report = init_banked_truncated_anf(\\n        b, d0=d0, dd=dd, address=hreg, target=tgt, bank=B, scratch=anc)\\n    report[\\\"anf_bank_load\\\"] = load_report\\n    b.free(anc)\\n    for bank_bit, target in enumerate(active):\\n        b.ccx(sel[0], B[bank_bit], tgt[target])\\n    if active:\\n        table = completed_dd\\n        report[\\\"anf_cleanup\\\"] = del_lookup_anf(b, table=table, address=hreg, target=B)\\n    b.free(B)\\n    for source, target in reversed(transforms):\\n        b.cx(tgt[source], tgt[target])\\n    circuit = b.finish_circuit()\\n    report.update(num_qubits=circuit.num_qubits,\\n                  static_toffoli=int(circuit.operation_statistics().num_toffoli_like))\\n    return (circuit, report) if return_report else circuit\\n\\n\\ndef profile(words, brot=10, Js=(4, 5, 6, 7)):\\n    return {str(J): [difference_tables(delta, brot, \\\"linear\\\")[-1]\\n                    for delta in batch_deltas(words, J)] for J in Js}\\n\\n\\ndef test_random_targets(circuits, deltas, *, brot=10, repeats=8, seed=20261023):\\n    \\\"\\\"\\\"Every legal address, random dirty targets, HMR phase and scratch checks.\\n\\n    This is simulation evidence; the exhaustive integer identity is separately\\n    certified above. This test is not a proof over all measurement branches.\\n    The full official verifier remains the acceptance check for the family.\\n    \\\"\\\"\\\"\\n    import kickmix as km\\n    from dfthcsos.scoreinfra.circuits import register_layout, _check_state\\n    rng = np.random.default_rng(seed)\\n    layout = register_layout(circuits)\\n    A = len(deltas[0])\\n    addresses = np.tile(np.arange(A, dtype=np.int64), repeats)\\n    address_bits = ((addresses[None, :] >> np.arange(len(layout.selection))[:, None]) & 1).astype(bool)\\n    sim = km.Simulator(batch_size=len(addresses), debug_print=False,\\n                       seed=seed, counting_operations=True)\\n    sim.use_same_registers_as(circuits[0])\\n    place_values = np.int64(1) << np.arange(brot)\\n    toffolis = []\\n    for k, (circuit, delta) in enumerate(zip(circuits, deltas)):\\n        sim.clear_for_shot()\\n        sim.write_across_shots(layout.selection, address_bits)\\n        dirty = rng.integers(0, 1 << brot, size=(len(addresses), len(layout.words)), dtype=np.int64)\\n        for j, word in enumerate(layout.words):\\n            sim.write_across_shots(word, ((dirty[:, j][None, :] >> np.arange(brot)[:, None]) & 1).astype(bool))\\n        before = sim.operation_statistics().num_toffoli_like\\n        sim.do(circuit)\\n        _check_state(sim, circuit, layout, address_bits, f\\\"random-target ANGLE_{k}\\\")\\n        result = np.stack([place_values @ sim.read_across_shots(word).astype(np.int64)\\n                           for word in layout.words], axis=1)\\n        assert np.array_equal(result, dirty ^ delta[addresses]), f\\\"ANGLE_{k} wrong XOR\\\"\\n        toffolis.append((sim.operation_statistics().num_toffoli_like - before) / len(addresses))\\n    return {\\\"status\\\": \\\"PASS\\\", \\\"addresses\\\": A, \\\"repeats\\\": repeats,\\n            \\\"shots_per_circuit\\\": len(addresses), \\\"num_circuits\\\": len(circuits),\\n            \\\"random_target_xor\\\": \\\"PASS\\\", \\\"unchanged_selection\\\": \\\"PASS\\\",\\n            \\\"clean_workspace\\\": \\\"PASS\\\", \\\"zero_observed_phase_errors\\\": True,\\n            \\\"toffoli_per_circuit\\\": toffolis, \\\"toffoli_per_pass\\\": sum(toffolis),\\n            \\\"full_official_verification\\\": \\\"PENDING\\\", \\\"seed\\\": seed}\\n\\n\\ndef main():\\n    parser = argparse.ArgumentParser(description=__doc__)\\n    parser.add_argument(\\\"words\\\", type=Path)\\n    parser.add_argument(\\\"output\\\", type=Path)\\n    parser.add_argument(\\\"--mode\\\", choices=(\\\"baseline\\\", \\\"zero\\\", \\\"linear\\\"), default=\\\"zero\\\")\\n    parser.add_argument(\\\"--J\\\", type=int, default=5)\\n    parser.add_argument(\\\"--brot\\\", type=int, default=10)\\n    parser.add_argument(\\\"--profile-only\\\", action=\\\"store_true\\\")\\n    parser.add_argument(\\\"--repeats\\\", type=int, default=8)\\n    args = parser.parse_args()\\n    words = np.loadtxt(args.words, delimiter=\\\",\\\", dtype=np.int64)\\n    args.output.mkdir(parents=True, exist_ok=True)\\n    report = {\\\"source_csv\\\": str(args.words), \\\"source_csv_sha256\\\": hashlib.sha256(args.words.read_bytes()).hexdigest(),\\n              \\\"shape\\\": list(words.shape), \\\"brot\\\": args.brot, \\\"J\\\": args.J, \\\"mode\\\": args.mode,\\n              \\\"profiles\\\": profile(words, args.brot)}\\n    if not args.profile_only:\\n        deltas = batch_deltas(words, args.J)\\n        circuits, resources = [], []\\n        for k, delta in enumerate(deltas):\\n            circuit, resource = build_qroam2(delta, args.brot, mode=args.mode, return_report=True)\\n            if circuit.num_qubits > 128:\\n                raise ValueError(f\\\"ANGLE_{k} exceeds the 128-qubit cap\\\")\\n            path = args.output / f\\\"angle_k_{k}.kmb\\\"\\n            circuit.to_file(path, format=\\\"kmb\\\")\\n            resource.update(k=k, sha256=hashlib.sha256(path.read_bytes()).hexdigest(), bytes=path.stat().st_size)\\n            circuits.append(circuit)\\n            resources.append(resource)\\n            print(json.dumps(resource), flush=True)\\n        report[\\\"circuits\\\"] = resources\\n        report[\\\"random_target_test\\\"] = test_random_targets(circuits, deltas, brot=args.brot, repeats=args.repeats)\\n        toffoli = 8794 + 2 * report[\\\"random_target_test\\\"][\\\"toffoli_per_pass\\\"]\\n        report[\\\"estimate_using_unchanged_c5_coefficients\\\"] = {\\n            \\\"full_system_qubits\\\": 631 + args.J * args.brot,\\n            \\\"full_system_toffoli\\\": toffoli, \\\"lambda_eff\\\": 47.558542335159316,\\n            \\\"estimated_cost\\\": (631 + args.J * args.brot) * toffoli * 47.558542335159316,\\n            \\\"label\\\": \\\"RESOURCE ESTIMATE; full official verifier pending\\\"}\\n    (args.output / \\\"report.json\\\").write_text(json.dumps(report, indent=2), encoding=\\\"utf8\\\")\\n    print(json.dumps({key: value for key, value in report.items() if key != \\\"profiles\\\" and key != \\\"circuits\\\"}, indent=2), flush=True)\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n\"},{\"cell_type\":\"code\",\"execution_count\":null,\"id\":\"855a8c35\",\"metadata\":{},\"outputs\":[],\"source\":\"implementation_path = Path('banked_lab.py').resolve()\\nspec = importlib.util.spec_from_file_location('banked_lab', implementation_path)\\nbanked_lab = importlib.util.module_from_spec(spec)\\nsys.modules[spec.name] = banked_lab\\nspec.loader.exec_module(banked_lab)\\n\\nBANKED_MODE = 'linear'\\nBANKED_BATCH_SIZE = 5\\nBANKED_BROT = 10\\nfactor_path = FINAL / 'dfthcsos/submission.npz'\\nassert digest(factor_path) == BASE_MEMBERS['dfthcsos/submission.npz']['sha256']\\nwith np.load(factor_path, allow_pickle=False) as factorization:\\n    banked_words = factorization['angle_words'].astype(np.int64)\\nassert banked_words.shape == (3976, 75)\\nassert int(banked_words.min()) >= 0 and int(banked_words.max()) < (1 << BANKED_BROT)\\nbanked_deltas = banked_lab.batch_deltas(banked_words, BANKED_BATCH_SIZE)\\nEXPECTED_ANGLE_COUNT = math.ceil(banked_words.shape[1] / BANKED_BATCH_SIZE)\\nassert len(banked_deltas) == EXPECTED_ANGLE_COUNT == 15\\n\\nchemistry_directory = FINAL / 'dfthcsos'\\n# The input cell copies no old angle circuits. Remove any files left by rerunning this build cell.\\nfor old_angle in chemistry_directory.glob('angle_k_*.kmb'):\\n    old_angle.unlink()\\nbanked_rows = []\\nfor index, delta in enumerate(banked_deltas):\\n    circuit, row = banked_lab.build_qroam2(delta, BANKED_BROT, mode=BANKED_MODE, return_report=True)\\n    assert row['integer_table_certificate'] == 'PASS'\\n    assert circuit.num_qubits <= 128\\n    name = f'angle_k_{index}.kmb'\\n    circuit.to_file(str(chemistry_directory / name), format='kmb')\\n    banked_rows.append({'batch': index, 'file': name, **row})\\n    del circuit\\nbanked_build_report = {\\n    'mode': BANKED_MODE, 'batch_size': BANKED_BATCH_SIZE, 'brot': BANKED_BROT,\\n    'angle_words_shape': list(banked_words.shape), 'num_angle_circuits': len(banked_rows),\\n    'max_angle_qubits': max(row['num_qubits'] for row in banked_rows),\\n    'static_toffoli_per_pass': sum(row['static_toffoli'] for row in banked_rows),\\n    'factorization_sha256': digest(factor_path), 'batches': banked_rows,\\n    'complete_official_chemistry_verification': 'PENDING'}\\nsave_json(REPORTS / 'banked_build.json', banked_build_report)\\ndisplay(pd.DataFrame(banked_rows)[['batch', 'width', 'active_columns', 'gf2_rank', 'bank_width',\\n                                'basis_cnot_count', 'num_qubits', 'static_toffoli']])\\nprint('All lookup table identities certified; complete official chemistry verification follows first.')\\nprint('Generated ANGLE circuits:', EXPECTED_ANGLE_COUNT,\\n      '| Static Toffolis per forward pass:', banked_build_report['static_toffoli_per_pass'])\\nassert digest(factor_path) == BASE_MEMBERS['dfthcsos/submission.npz']['sha256']\\n\"},{\"cell_type\":\"markdown\",\"id\":\"de7d6be1\",\"metadata\":{},\"source\":\"## DQI: compile a proof, then keep the simulator contract\\n\\nIf a clean target becomes $t=a\\\\land b$, then $t\\\\Rightarrow a$ and $t\\\\Rightarrow b$. A later Toffoli controlled by $t$ and either unchanged parent can use one control. Transitive chains give the same identity over more than one computation step.\\n\\nKozykorpesh published this implication pass. Our C++ implementation works directly on the binary columns with fixed quantum IDs. Every fact records the target and control versions; any value-changing write invalidates the corresponding dependency. Measurements, phase gates, classical instructions and their order are preserved.\\n\\nA useful extension makes branch handling explicit. If $t$ is zero on **all active and inactive branches**, a conditional computation gives $t'=c\\\\,a\\\\,b$. It still implies $a$ and $b$ globally, so that fact can survive the branch join. A target that is only locally zero receives a local fact, which is discarded at the join. Regression cases check both situations, changed controls and changed targets.\\n\\nFor this decoder the fast pass reproduces **exactly the published Kozykorpesh output hash**, saving **231 static Toffoli** from our previous DQI binary, with **1818 qubits** unchanged. The global-fact extension adds no further gates saved on this particular input. Our Python ANF/implication experiment saved one extra Toffoli but took about nine minutes; the direct C++ pass took about **three seconds** on Kaggle, so this release uses the faster construction. The code below compiles locally with the image's C++17 toolchain and needs no Internet access.\\n\\nThe compiled decoder still originates from k256.dev's public binary. Its original generator is unavailable; this notebook exposes and verifies the transformations applied to that dependency.\\n\"},{\"cell_type\":\"code\",\"execution_count\":null,\"id\":\"3fba43b6\",\"metadata\":{\"_kg_hide-input\":true,\"_kg_hide-output\":true,\"collapsed\":true,\"hide_input\":true,\"jupyter\":{\"source_hidden\":true}},\"outputs\":[],\"source\":\"%%writefile and_implication_fast.cpp\\n// SPDX-License-Identifier: Apache-2.0\\n// Exact, fixed-qubit-id KMB v2 transitive-AND pass, C++17.\\n//\\n// Boolean implication algorithm: Kozykorpesh's Apache-2.0 exact_compile.py,\\n// https://www.kaggle.com/code/kozykappa/quantum-ai-compact-arithmetic-banked-qrom?scriptVersionId=361456406\\n// Binary compiler integration and globally-clean conditional facts follow our\\n// src/dqi_portfolio_v2.py. Compiled decoder provenance remains k256.dev:\\n// https://www.kaggle.com/code/k256net/claude?scriptVersionId=361337610\\n//\\n// Only CCX is rewritten (CX, X, or deletion). Every other instruction, including\\n// all phases, resets, measurements, classical writes and conditions, keeps its\\n// order and operands. Registers, quantum IDs, rotations and INFO bytes persist.\\n// Scratch starts zero; registered quantum inputs are unknown. Facts require\\n// unchanged per-logical-wire epochs. Local facts are discarded at every POP;\\n// facts created from a target zero on ALL active/inactive branches survive POP.\\n// Full official semantic verification is still required for real candidates.\\n\\n#include <algorithm>\\n#include <array>\\n#include <chrono>\\n#include <cstdint>\\n#include <cstring>\\n#include <fstream>\\n#include <functional>\\n#include <iostream>\\n#include <limits>\\n#include <stdexcept>\\n#include <string>\\n#include <vector>\\n\\nusing U8 = std::uint8_t;\\nusing U32 = std::uint32_t;\\nusing U64 = std::uint64_t;\\nusing Value = std::int8_t;\\nconstexpr Value UNKNOWN = -1;\\n\\nstatic U32 u32(const U8* p) {\\n    return U32(p[0]) | (U32(p[1]) << 8) | (U32(p[2]) << 16) | (U32(p[3]) << 24);\\n}\\nstatic U64 u64(const U8* p) {\\n    return U64(u32(p)) | (U64(u32(p + 4)) << 32);\\n}\\nstatic void put64(U8* p, U64 v) {\\n    for (int k = 0; k < 8; ++k) p[k] = U8(v >> (8 * k));\\n}\\nstatic Value xorr(Value a, Value b) {\\n    return a == UNKNOWN || b == UNKNOWN ? UNKNOWN : Value(a ^ b);\\n}\\nstatic Value product(Value a, Value b) {\\n    if (a == 0 || b == 0) return 0;\\n    if (a == 1 && b == 1) return 1;\\n    return UNKNOWN;\\n}\\n\\nstruct Packet { std::size_t offset = 0, length = 0; };\\nstruct Kmb {\\n    std::vector<U8> bytes;\\n    std::array<U64, 9> counts{};\\n    std::array<Packet, 12> packets{};\\n    U32 width = 0, bits = 0, registers = 0;\\n    std::size_t register_end = 104;\\n    std::vector<U8> protected_q;\\n\\n    explicit Kmb(const std::string& path) {\\n        std::ifstream f(path, std::ios::binary | std::ios::ate);\\n        if (!f) throw std::runtime_error(\\\"cannot open source\\\");\\n        auto size = f.tellg();\\n        if (size < 104) throw std::runtime_error(\\\"truncated KMB header\\\");\\n        bytes.resize(std::size_t(size));\\n        f.seekg(0);\\n        if (!f.read(reinterpret_cast<char*>(bytes.data()), bytes.size()))\\n            throw std::runtime_error(\\\"failed reading source\\\");\\n        const U8 magic[16] = {0xd7,0x50,0xc7,0xd5,0xc3,0x29,0xd3,0x26,\\n                             0xe3,0xcc,0x9f,0x68,0x34,0xf2,0xb8,0xbf};\\n        if (std::memcmp(bytes.data(), magic, 16) || u32(bytes.data() + 16) != 2)\\n            throw std::runtime_error(\\\"expected Kickmix KMB version 2\\\");\\n        width = u32(bytes.data() + 20);\\n        bits = u32(bytes.data() + 24);\\n        registers = u32(bytes.data() + 28);\\n        protected_q.assign(width, 0);\\n        for (int k = 0; k < 9; ++k) counts[k] = u64(bytes.data() + 32 + 8 * k);\\n        std::size_t pos = 104;\\n        auto check = [&](std::size_t p, U64 n) {\\n            if (p > bytes.size() || n > bytes.size() - p)\\n                throw std::runtime_error(\\\"truncated or oversized KMB packet\\\");\\n        };\\n        for (U32 k = 0; k < registers; ++k) {\\n            check(pos, 16);\\n            const U64 kind = u64(bytes.data() + pos), length = u64(bytes.data() + pos + 8);\\n            pos += 16; check(pos, length);\\n            if (kind || length < 8) throw std::runtime_error(\\\"invalid register packet\\\");\\n            const U32 namesize = u32(bytes.data() + pos), targets = u32(bytes.data() + pos + 4);\\n            if (U64(8) + namesize + U64(4) * targets != length)\\n                throw std::runtime_error(\\\"inconsistent register packet\\\");\\n            for (U32 j = 0; j < targets; ++j) {\\n                const U32 target = u32(bytes.data() + pos + 8 + namesize + 4 * std::size_t(j));\\n                if (target & 0x80000000u) {\\n                    const U32 q = target & 0x7fffffffu;\\n                    if (q >= width) throw std::runtime_error(\\\"register qubit exceeds width\\\");\\n                    protected_q[q] = 1;\\n                }\\n            }\\n            pos += std::size_t(length);\\n        }\\n        register_end = pos;\\n        for (U64 kind = 1; kind <= 11; ++kind) {\\n            check(pos, 16);\\n            const U64 actual = u64(bytes.data() + pos), length = u64(bytes.data() + pos + 8);\\n            pos += 16; check(pos, length);\\n            if (kind != actual) throw std::runtime_error(\\\"unexpected column packet kind\\\");\\n            packets[kind] = {pos, std::size_t(length)};\\n            pos += std::size_t(length);\\n        }\\n        if (pos != bytes.size()) throw std::runtime_error(\\\"trailing KMB bytes\\\");\\n        const std::array<U64, 11> lengths = {\\n            counts[0], counts[1]*4, counts[1]*4, counts[1]*4,\\n            counts[2]*4, counts[2]*4, counts[3]*4,\\n            counts[4]*4, counts[5]*4, counts[6]*16,\\n            (counts[7]+1)*8 + counts[8]\\n        };\\n        for (int k = 1; k <= 11; ++k)\\n            if (packets[k].length != lengths[k-1])\\n                throw std::runtime_error(\\\"header count does not match packet length\\\");\\n    }\\n    U32 operand(int column, U64 index) const {\\n        const auto& p = packets[column];\\n        if (index >= p.length / 4) throw std::runtime_error(\\\"operand column exhausted\\\");\\n        return u32(bytes.data() + p.offset + 4 * std::size_t(index));\\n    }\\n};\\n\\nstruct Fact {\\n    bool valid = false, global = false;\\n    U8 ncontrols = 0;\\n    U64 target_epoch = 0, local_generation = 0;\\n    std::array<U32,2> control{};\\n    std::array<U64,2> epoch{};\\n};\\n\\nint main(int argc, char** argv) {\\n    try {\\n        if (argc < 3) throw std::runtime_error(\\n            \\\"usage: and_implication_fast source.kmb target.kmb [--facts=both|global|local|none] [--no-rewrite]\\\");\\n        const std::string source = argv[1], destination = argv[2];\\n        if (source == destination) throw std::runtime_error(\\\"source and destination must differ\\\");\\n        bool global_facts = true, local_facts = true, rewrite = true;\\n        for (int k = 3; k < argc; ++k) {\\n            const std::string arg = argv[k];\\n            if (arg == \\\"--no-rewrite\\\") rewrite = false;\\n            else if (arg == \\\"--facts=both\\\") { global_facts = true; local_facts = true; }\\n            else if (arg == \\\"--facts=global\\\") { global_facts = true; local_facts = false; }\\n            else if (arg == \\\"--facts=local\\\") { global_facts = false; local_facts = true; }\\n            else if (arg == \\\"--facts=none\\\") { global_facts = false; local_facts = false; }\\n            else throw std::runtime_error(\\\"unknown argument: \\\" + arg);\\n        }\\n        const auto start = std::chrono::steady_clock::now();\\n        const U32 endian = 1;\\n        if (*reinterpret_cast<const U8*>(&endian) != 1)\\n            throw std::runtime_error(\\\"this build currently writes on little-endian hosts only\\\");\\n        Kmb in(source);\\n        std::vector<Value> values(in.width, 0);\\n        for (U32 q = 0; q < in.width; ++q) if (in.protected_q[q]) values[q] = UNKNOWN;\\n        std::vector<std::vector<Value>> stack;\\n        std::vector<U64> epochs(in.width, 0), visited(in.width, 0);\\n        std::vector<Fact> facts(in.width);\\n        U64 local_generation = 1, traversal = 0;\\n        std::function<bool(U32,U32)> search = [&](U32 a, U32 b) -> bool {\\n            if (a == b || values[b] == 1 || values[a] == 0) return true;\\n            if (visited[a] == traversal) return false;\\n            visited[a] = traversal;\\n            const Fact& fact = facts[a];\\n            if (!fact.valid || fact.target_epoch != epochs[a] ||\\n                (!fact.global && fact.local_generation != local_generation)) return false;\\n            for (U8 j = 0; j < fact.ncontrols; ++j)\\n                if (fact.epoch[j] != epochs[fact.control[j]]) return false;\\n            for (U8 j = 0; j < fact.ncontrols; ++j)\\n                if (fact.control[j] == b || search(fact.control[j], b)) return true;\\n            return false;\\n        };\\n        auto implies = [&](U32 a, U32 b) { ++traversal; return search(a, b); };\\n        auto globally_zero = [&](U32 q) {\\n            if (values[q] != 0) return false;\\n            for (const auto& old : stack) if (old[q] != 0) return false;\\n            return true;\\n        };\\n        std::vector<U8> types;\\n        types.reserve(std::size_t(in.counts[0]));\\n        std::array<std::vector<U32>, 10> columns;\\n        for (int k = 2; k < 10; ++k) columns[k].reserve(in.packets[k].length / 4);\\n        U64 n1i=0, n2i=0, n3i=0, bi=0, ci=0;\\n        U64 zero_drop=0, constant_x=0, one_cx=0, and_cx=0, globals_created=0, locals_created=0;\\n        U64 input_ccx=0, output_ccx=0;\\n        std::array<U64,256> frequencies{};\\n        const U8* input_types = in.bytes.data() + in.packets[1].offset;\\n        for (U64 number = 0; number < in.counts[0]; ++number) {\\n            const U8 raw = input_types[number], op = raw & 0x7f;\\n            const U8 nq = (raw >> 4) & 3;\\n            const bool conditional = raw & 0x80;\\n            std::array<U32,3> qs{};\\n            if (nq == 3) {\\n                qs = {in.operand(2,n3i), in.operand(3,n3i), in.operand(4,n3i)}; ++n3i;\\n            } else if (nq == 2) {\\n                qs = {in.operand(5,n2i), in.operand(6,n2i), 0}; ++n2i;\\n            } else if (nq == 1) {\\n                qs[0] = in.operand(7,n1i++);\\n            }\\n            for (U8 j = 0; j < nq; ++j)\\n                if (qs[j] >= in.width) throw std::runtime_error(\\\"qubit exceeds declared width\\\");\\n            const U32 bit = (raw & 0x40) ? in.operand(8,bi++) : 0;\\n            const U32 condition = conditional ? in.operand(9,ci++) : 0;\\n            if (((raw & 0x40) && bit >= in.bits) || (conditional && condition >= in.bits))\\n                throw std::runtime_error(\\\"classical bit exceeds declared width\\\");\\n            if (raw == 0x81) stack.push_back(values);\\n            else if (raw == 1) {\\n                if (stack.empty()) throw std::runtime_error(\\\"unbalanced POP_CONDITION\\\");\\n                const auto& old = stack.back();\\n                for (U32 q = 0; q < in.width; ++q)\\n                    if (values[q] != old[q]) values[q] = UNKNOWN;\\n                stack.pop_back();\\n                ++local_generation;\\n            }\\n            const bool target_zero = (op == 0x21 || op == 0x31) && values[qs[nq-1]] == 0;\\n            const bool target_global_zero = target_zero && globally_zero(qs[nq-1]);\\n            int newop = op;\\n            U8 newnq = nq;\\n            auto newqs = qs;\\n            if (op == 0x31) {\\n                ++input_ccx;\\n                const U32 a=qs[0], b=qs[1], t=qs[2];\\n                if (a == b || a == t || b == t) throw std::runtime_error(\\\"aliased CCX operands\\\");\\n                if (rewrite) {\\n                    if (values[a] == 0 || values[b] == 0) {\\n                        newop = -1; ++zero_drop;\\n                    } else if (values[a] == 1 && values[b] == 1) {\\n                        newop = 0x11; newnq=1; newqs={t,0,0}; ++constant_x;\\n                    } else if (values[a] == 1) {\\n                        newop = 0x21; newnq=2; newqs={b,t,0}; ++one_cx;\\n                    } else if (values[b] == 1) {\\n                        newop = 0x21; newnq=2; newqs={a,t,0}; ++one_cx;\\n                    } else if (implies(a,b)) {\\n                        newop = 0x21; newnq=2; newqs={a,t,0}; ++and_cx;\\n                    } else if (implies(b,a)) {\\n                        newop = 0x21; newnq=2; newqs={b,t,0}; ++and_cx;\\n                    }\\n                }\\n            }\\n            std::array<U32,3> writes{};\\n            std::array<Value,3> result{};\\n            U8 nwrites = 0;\\n            if (op == 0x31) {\\n                writes[0]=qs[2]; result[0]=xorr(values[qs[2]],product(values[qs[0]],values[qs[1]])); nwrites=1;\\n            } else if (op == 0x21) {\\n                writes[0]=qs[1]; result[0]=xorr(values[qs[1]],values[qs[0]]); nwrites=1;\\n            } else if (op == 0x11) {\\n                writes[0]=qs[0]; result[0]=xorr(values[qs[0]],1); nwrites=1;\\n            } else if (op == 0x12 || op == 0x50) {\\n                writes[0]=qs[0]; result[0]=0; nwrites=1;\\n            } else if (op == 0x22) {\\n                writes[0]=qs[0]; writes[1]=qs[1]; result[0]=values[qs[1]]; result[1]=values[qs[0]]; nwrites=2;\\n            } else if (op == 0x32) {\\n                const Value c=values[qs[0]], a=values[qs[1]], b=values[qs[2]];\\n                writes[0]=qs[1]; writes[1]=qs[2]; nwrites=2;\\n                result[0] = c == 0 || a == b ? a : (c == 1 ? b : UNKNOWN);\\n                result[1] = c == 0 || a == b ? b : (c == 1 ? a : UNKNOWN);\\n            } else if (op == 0 || op == 1 || op == 6 || op == 7 || op == 0x10 ||\\n                       op == 0x13 || op == 0x17 || op == 0x20 || op == 0x30 ||\\n                       op == 0x40 || op == 0x41 || op == 0x42 || op == 0x47) {\\n                // Phase, debug, classical and scope operations do not change Boolean qubit values.\\n            } else {\\n                for (U8 j=0; j<nq; ++j) { writes[j]=qs[j]; result[j]=UNKNOWN; }\\n                nwrites=nq;\\n            }\\n            for (U8 j=0; j<nwrites; ++j) {\\n                const U32 q=writes[j];\\n                values[q] = !conditional || values[q] == result[j] ? result[j] : UNKNOWN;\\n                ++epochs[q]; facts[q].valid=false;\\n            }\\n            if (newop == 0x21 || newop == 0x31) {\\n                const bool global = global_facts && target_global_zero;\\n                const bool local = local_facts && !conditional && target_zero;\\n                if (global || local) {\\n                    const U32 target=newqs[newnq-1];\\n                    bool alias=false;\\n                    for (U8 j=0; j<newnq-1; ++j) alias |= newqs[j] == target;\\n                    if (!alias) {\\n                        Fact fact; fact.valid=true; fact.global=global;\\n                        fact.ncontrols=newnq-1; fact.target_epoch=epochs[target];\\n                        fact.local_generation=local_generation;\\n                        for (U8 j=0; j<fact.ncontrols; ++j) {\\n                            fact.control[j]=newqs[j]; fact.epoch[j]=epochs[newqs[j]];\\n                        }\\n                        facts[target]=fact;\\n                        if (global) ++globals_created; else ++locals_created;\\n                    }\\n                }\\n            }\\n            if (newop < 0) continue;\\n            const U8 outtype=U8(newop) | (raw & 0x80);\\n            types.push_back(outtype); ++frequencies[outtype];\\n            if (newop == 0x31) ++output_ccx;\\n            if (newnq == 3) {\\n                columns[2].push_back(newqs[0]); columns[3].push_back(newqs[1]); columns[4].push_back(newqs[2]);\\n            } else if (newnq == 2) {\\n                columns[5].push_back(newqs[0]); columns[6].push_back(newqs[1]);\\n            } else if (newnq == 1) columns[7].push_back(newqs[0]);\\n            if (raw & 0x40) columns[8].push_back(bit);\\n            if (raw & 0x80) columns[9].push_back(condition);\\n        }\\n        if (!stack.empty()) throw std::runtime_error(\\\"unbalanced condition stack at EOF\\\");\\n        if (n3i != in.counts[1] || n2i != in.counts[2] || n1i != in.counts[3] ||\\n            bi != in.counts[4] || ci != in.counts[5]) throw std::runtime_error(\\\"operand cursors disagree with header\\\");\\n        if (frequencies[0x13]+frequencies[0x93] != in.counts[6] || frequencies[6] != in.counts[7])\\n            throw std::runtime_error(\\\"rotation or info count mismatch\\\");\\n        auto counts=in.counts;\\n        counts[0]=types.size(); counts[1]=columns[2].size(); counts[2]=columns[5].size();\\n        counts[3]=columns[7].size(); counts[4]=columns[8].size(); counts[5]=columns[9].size();\\n        std::array<U8,104> header{};\\n        std::copy_n(in.bytes.begin(),104,header.begin());\\n        for (int k=0;k<9;++k) put64(header.data()+32+8*k,counts[k]);\\n        std::ofstream out(destination,std::ios::binary|std::ios::trunc);\\n        if (!out) throw std::runtime_error(\\\"cannot open destination\\\");\\n        out.write(reinterpret_cast<const char*>(header.data()),header.size());\\n        out.write(reinterpret_cast<const char*>(in.bytes.data()+104),in.register_end-104);\\n        auto packet = [&](U64 kind, const void* data, std::size_t length) {\\n            std::array<U8,16> h{}; put64(h.data(),kind); put64(h.data()+8,length);\\n            out.write(reinterpret_cast<const char*>(h.data()),h.size());\\n            if (length) out.write(reinterpret_cast<const char*>(data),length);\\n        };\\n        packet(1,types.data(),types.size());\\n        for (int k=2;k<=9;++k) packet(k,columns[k].data(),columns[k].size()*4);\\n        for (int k=10;k<=11;++k) packet(k,in.bytes.data()+in.packets[k].offset,in.packets[k].length);\\n        out.close();\\n        if (!out) throw std::runtime_error(\\\"failed writing candidate\\\");\\n        const double seconds=std::chrono::duration<double>(std::chrono::steady_clock::now()-start).count();\\n        std::cout << \\\"{\\\\\\\"num_qubits\\\\\\\":\\\" << in.width << \\\",\\\\\\\"num_bits\\\\\\\":\\\" << in.bits\\n                  << \\\",\\\\\\\"input_ops\\\\\\\":\\\" << in.counts[0] << \\\",\\\\\\\"output_ops\\\\\\\":\\\" << counts[0]\\n                  << \\\",\\\\\\\"input_ccx\\\\\\\":\\\" << input_ccx << \\\",\\\\\\\"output_ccx\\\\\\\":\\\" << output_ccx\\n                  << \\\",\\\\\\\"removed_static_toffoli\\\\\\\":\\\" << input_ccx-output_ccx\\n                  << \\\",\\\\\\\"rewrites\\\\\\\":{\\\\\\\"zero_control_toffoli\\\\\\\":\\\" << zero_drop\\n                  << \\\",\\\\\\\"constant_toffoli\\\\\\\":\\\" << constant_x\\n                  << \\\",\\\\\\\"one_control_toffoli\\\\\\\":\\\" << one_cx\\n                  << \\\",\\\\\\\"transitive_and_implication\\\\\\\":\\\" << and_cx\\n                  << \\\"},\\\\\\\"global_facts_created\\\\\\\":\\\" << globals_created\\n                  << \\\",\\\\\\\"local_facts_created\\\\\\\":\\\" << locals_created\\n                  << \\\",\\\\\\\"global_facts_enabled\\\\\\\":\\\" << (global_facts?\\\"true\\\":\\\"false\\\")\\n                  << \\\",\\\\\\\"local_facts_enabled\\\\\\\":\\\" << (local_facts?\\\"true\\\":\\\"false\\\")\\n                  << \\\",\\\\\\\"seconds\\\\\\\":\\\" << seconds\\n                  << \\\",\\\\\\\"verification_status\\\\\\\":\\\\\\\"UNVERIFIED; fresh full official verification required\\\\\\\"}\\\\n\\\";\\n        return 0;\\n    } catch (const std::exception& error) {\\n        std::cerr << \\\"and_implication_fast: \\\" << error.what() << '\\\\n';\\n        return 1;\\n    }\\n}\\n\"},{\"cell_type\":\"code\",\"execution_count\":null,\"id\":\"eaf9a582\",\"metadata\":{},\"outputs\":[],\"source\":\"import subprocess\\nassert shutil.which('g++'), 'C++17 compiler required.'\\ncompiler_path = WORK / 'and_implication_fast'\\ncompiler_source = Path('and_implication_fast.cpp').resolve()\\nassert digest(compiler_source) == '256e443313aada79e070555e94ab339ac2b7a56e366d5acdfaff9179ec73847a'\\ncompiled = subprocess.run(['g++', '-O3', '-std=c++17', str(compiler_source), '-o', str(compiler_path)], capture_output=True, text=True)\\nif compiled.returncode:\\n    raise RuntimeError(compiled.stderr)\\nsource_dqi = PUBLIC / 'dqi_input.kmb'\\nif not source_dqi.exists():\\n    shutil.move(str(FINAL / 'dqi.kmb'), str(source_dqi))\\nassert digest(source_dqi) == BASE_MEMBERS['dqi.kmb']['sha256']\\nstart = time.monotonic()\\nrewritten = subprocess.run([str(compiler_path), str(source_dqi), str(FINAL / 'dqi.kmb')], capture_output=True, text=True)\\nif rewritten.returncode:\\n    raise RuntimeError(rewritten.stderr)\\ncompiler_report = json.loads(rewritten.stdout)\\ncompiler_report.update(candidate_sha256=digest(FINAL / 'dqi.kmb'), compiler_source_sha256=digest(compiler_source), wall_seconds=time.monotonic()-start)\\nassert compiler_report['num_qubits'] == 1818\\nassert compiler_report['removed_static_toffoli'] > 0\\nsave_json(REPORTS / 'dqi_compilation.json', compiler_report)\\nprint(json.dumps(compiler_report, indent=2))\\n\\nassert compiler_report['candidate_sha256'] == '05453a3aec72bb0f62db66fe6e3326804475233f4e92cfe5f37ca446146969c4'\\nassert compiler_report['removed_static_toffoli'] == 231\\n\"},{\"cell_type\":\"markdown\",\"id\":\"5aaee2ec\",\"metadata\":{},\"source\":\"## Full verification and the complete objective\\n\\nThe integer arithmetic certificate and lookup identities are development evidence. They do not replace quantum simulation. This run calls all three unchanged official verifiers with the same development salt used in our previous release:\\n\\n- inverse square root: **200,540,928** shots;\\n- DQI: **102,400** shots, with the original confidence bound;\\n- chemistry: **254,464** shots, including full factorization checks.\\n\\nThe combined value is the geometric mean of reference-to-candidate task costs. The table includes rotations, repetitions, persistent storage and temporary workspace through the official objectives. A development projection remains distinct from an observed competition score.\\n\"},{\"cell_type\":\"code\",\"execution_count\":null,\"id\":\"d3a717c9\",\"metadata\":{\"_kg_hide-input\":true,\"_kg_hide-output\":true,\"collapsed\":true,\"hide_input\":true,\"jupyter\":{\"source_hidden\":true}},\"outputs\":[],\"source\":\"%%writefile metric_preflight.py\\n\\\"\\\"\\\"Official Kaggle metric v10 readers, unchanged except formatting.\\nSource: https://www.kaggle.com/code/metric/google-quantum-ai-metric\\nAdapter preflight_directory only checks the file contract; task verification is separate.\\n\\\"\\\"\\\"\\nimport json\\nimport math\\nimport pathlib\\nimport random\\nimport stat\\nimport sys\\nimport time\\nimport tokenize\\nimport zipfile\\nimport zlib\\nfrom collections.abc import Callable, Mapping\\nfrom typing import Any\\nimport numpy as np\\nimport pandas as pd\\nALLOWED_INSTRUCTIONS = {'X', 'CX', 'CCX', 'Z', 'CZ', 'CCZ', 'Z_POW', 'NEG', 'SWAP', 'CSWAP', 'R', 'HMR', 'BIT_INVERT', 'BIT_STORE0', 'BIT_STORE1', 'PUSH_CONDITION', 'POP_CONDITION', 'INFO_TAG', 'DEBUG_PRINT'}\\nMAX_QUBIT_OR_BIT_ID = 2 ** 30 // 1536\\nMAX_NPZ_BYTES = 2 ** 26\\n\\nclass ParticipantVisibleError(Exception):\\n    pass\\n\\ndef read_circuit(path: pathlib.Path, max_registers: int) -> Any:\\n    \\\"\\\"\\\"Return a submitted .kmx or .kmb circuit as a kickmix.Circuit; raise ValueError unless it is fit to verify.\\n\\n    kickmix validates a file as it parses it, within limits that keep parsing cheap, but simulating\\n    takes memory that grows with the largest qubit and bit ids, which kickmix allows up to ~5e8,\\n    so those are capped at MAX_QUBIT_OR_BIT_ID. kickmix also allows a million registers, at\\n    ~110 bytes each even if empty, so a circuit may have at most `max_registers`, the most its\\n    benchmark needs. Every register must be named: the dfthcsos verifier crashes on an unnamed one.\\n    \\\"\\\"\\\"\\n    import kickmix\\n    circuit = kickmix.Circuit.from_file(path, format=path.suffix.removeprefix('.'))\\n    unsupported = set(circuit.operation_statistics()) - ALLOWED_INSTRUCTIONS\\n    if unsupported:\\n        raise ValueError(f'unsupported instructions {sorted(unsupported)}')\\n    largest_id = max(circuit.num_qubits, circuit.num_bits) - 1\\n    if largest_id >= MAX_QUBIT_OR_BIT_ID:\\n        raise ValueError(f'qubit or bit id {largest_id} is above the limit of {MAX_QUBIT_OR_BIT_ID - 1}')\\n    if circuit.num_registers > max_registers:\\n        raise ValueError(f'{circuit.num_registers} registers, above the limit of {max_registers} for this benchmark')\\n    if not all((isinstance(name, str) for name in circuit.register_data)):\\n        raise ValueError('every register needs a name, given by its REGISTER line')\\n    return circuit\\n\\ndef read_npz(path: pathlib.Path, spec: Mapping[str, tuple[str, tuple[int | str, ...]]]) -> dict[str, np.ndarray]:\\n    \\\"\\\"\\\"Return the arrays `spec` names from an .npz; raise ValueError unless each is a plain number array as specified.\\n\\n    `spec` maps each key to the numpy dtype kinds it may have, such as 'f' for floats, and its shape,\\n    in which a string names a dimension of any positive size that must agree wherever it recurs.\\n\\n    Each array's header is a Python literal of its dtype and shape, which np.load trusts: a few KB\\n    of deflated zeros can claim a terabyte-sized array, and the dtype can be anything numpy can\\n    describe, from structured and nested types to Python objects that need unpickling. So the\\n    headers are read first, and the arrays loaded only if each is a plain number type of its kind,\\n    not big-endian, with its shape, and they total at most MAX_NPZ_BYTES. Only format 1.0 headers,\\n    which numpy.savez writes, are accepted, and numpy refuses any over 10 KB before parsing it.\\n    \\\"\\\"\\\"\\n    dimensions: dict[str, int] = {}\\n    total = 0\\n    with zipfile.ZipFile(path) as archive:\\n        members = {name.removesuffix('.npy'): name for name in archive.namelist()}\\n        missing = [key for key in spec if key not in members]\\n        if missing:\\n            raise ValueError(f'{path.name} has no {missing}')\\n        for key, (kinds, expected_shape) in spec.items():\\n            with archive.open(members[key]) as member:\\n                if np.lib.format.read_magic(member) != (1, 0):\\n                    raise ValueError(f'{key} in {path.name} is not in .npy format 1.0, which numpy.savez writes')\\n                shape, _, dtype = np.lib.format.read_array_header_1_0(member)\\n            if dtype.kind not in kinds or dtype.names is not None or dtype.subdtype is not None or (dtype.byteorder == '>'):\\n                raise ValueError(f'{key} in {path.name} has dtype {dtype}, not a plain number type of numpy kind {kinds!r}')\\n            matches = len(shape) == len(expected_shape) and all((size > 0 and size == (dimensions.setdefault(expected, size) if isinstance(expected, str) else expected) for size, expected in zip(shape, expected_shape, strict=True)))\\n            if not matches:\\n                raise ValueError(f'{key} in {path.name} has shape {shape}, not {expected_shape} with its named dimensions as in {dimensions}')\\n            total += math.prod(shape) * dtype.itemsize\\n    if total > MAX_NPZ_BYTES:\\n        raise ValueError(f'the arrays in {path.name} take {total:,} bytes, above the limit of {MAX_NPZ_BYTES:,}')\\n    with np.load(path, allow_pickle=False) as npz:\\n        return {key: np.array(npz[key]) for key in spec}\\n\\ndef find_one(root: pathlib.Path, name: str, description: str, is_dir: bool=False) -> pathlib.Path:\\n    \\\"\\\"\\\"The one path called `name` (a glob) under `root`, where the submission unpacked; raise ParticipantVisibleError otherwise.\\\"\\\"\\\"\\n    paths = [path for path in root.rglob(name) if path.is_dir() == is_dir and '__MACOSX' not in path.relative_to(root).parts]\\n    if len(paths) != 1:\\n        raise ParticipantVisibleError(f'The submission must contain exactly one {description}, found {len(paths)}.')\\n    return paths[0]\\n\\n\\ndef preflight_directory(directory):\\n    root = pathlib.Path(directory).resolve()\\n    inv_path = find_one(root, 'invsqrt.km[xb]', 'inverse circuit')\\n    dqi_path = find_one(root, 'dqi.km[xb]', 'DQI circuit')\\n    chemistry = find_one(root, 'dfthcsos', 'chemistry directory', is_dir=True)\\n    inv = read_circuit(inv_path, 1)\\n    inv_qubits = inv.num_qubits\\n    del inv\\n    decoder = read_circuit(dqi_path, 4095 + 70)\\n    decoder_qubits = decoder.num_qubits\\n    del decoder\\n    angles = sorted(chemistry.glob('angle_k_*.km[xb]'))\\n    if not angles or {p.stem for p in angles} != {f'angle_k_{i}' for i in range(len(angles))}:\\n        raise ValueError('Angle circuits must have consecutive numbering with no duplicate formats')\\n    angle_widths = []\\n    for path in angles:\\n        circuit = read_circuit(path, 128)\\n        if circuit.num_qubits > 128:\\n            raise ValueError('ANGLE circuit exceeds the 128-qubit cap')\\n        angle_widths.append(circuit.num_qubits)\\n        del circuit\\n    specification = {\\n        'U': ('f', ('R', 'B', 76)), 'W': ('f', ('R', 'B', 'C')),\\n        'H2_I': ('f', ('R', 'C')), 'H1_I': ('f', ()),\\n        'Hsym_lower': ('f', (2926,)), 'tree_edges': ('iu', (75, 2))\\n    }\\n    npz_path = find_one(chemistry, 'submission.npz', 'factorization')\\n    arrays = read_npz(npz_path, specification)\\n    paths = [inv_path, dqi_path, *sorted(angles, key=lambda p: int(p.stem.rsplit('_', 1)[1])), npz_path]\\n    return {'status': 'PASS', 'scope': 'Official file readers and archive layout; separate task PASS required',\\n            'invsqrt_qubits': inv_qubits, 'dqi_qubits': decoder_qubits,\\n            'angle_qubits': angle_widths, 'factorization_shape': list(arrays['W'].shape),\\n            'archive_members': [str(p.relative_to(root)).replace('\\\\\\\\', '/') for p in paths]}\\n\"},{\"cell_type\":\"code\",\"execution_count\":null,\"id\":\"72ddb4ca\",\"metadata\":{},\"outputs\":[],\"source\":\"if not RUN_FULL_VERIFICATION:\\n    raise RuntimeError('This release requires full verification before producing a submission archive.')\\n\\n# Verify the changed component first; each full official task check runs once.\\nchemistry_result = measured('chemistry_full', lambda: verify_chemistry(FINAL / 'dfthcsos', salt=SALT))\\nassert chemistry_result['status'] == 'PASS'\\nassert chemistry_result['verified_shots'] == 254_464\\nassert chemistry_result['num_circuits'] == EXPECTED_ANGLE_COUNT\\n\\n\\ninv_result = measured('invsqrt_full', lambda: IV.verify(inv_candidate,\\n    IV.ProblemSpecInvSqrt.for_n_p(10), salt=SALT, max_workers=WORKERS))\\nassert inv_result['status'] == 'PASS' and inv_result['verified_shots'] == 200_540_928\\ndel inv_candidate; gc.collect()\\n\\ndecoder = km.Circuit.from_file(str(FINAL / 'dqi.kmb'), format='kmb')\\ndqi_result = measured('dqi_full', lambda: DV.verify(decoder,\\n    DV.ProblemSpecDQI.benchmark_instance(), salt=SALT, max_workers=WORKERS))\\nassert dqi_result['status'] == 'PASS' and dqi_result['verified_shots'] == 102_400\\ndel decoder; gc.collect()\\n\\nimplementation_path = Path('metric_preflight.py').resolve()\\nmodule_spec = importlib.util.spec_from_file_location('metric_preflight', implementation_path)\\npreflight = importlib.util.module_from_spec(module_spec)\\nsys.modules[module_spec.name] = preflight\\nmodule_spec.loader.exec_module(preflight)\\nfile_contract = measured('archive_preflight', lambda: preflight.preflight_directory(FINAL))\\nassert file_contract['status'] == 'PASS'\\n\\nresults = {'invsqrt': inv_result, 'dqi': dqi_result, 'dfthcsos': chemistry_result}\\ncost_rows = []\\nfor name, result in results.items():\\n    cost_rows.append({'Task': name, 'Status': result['status'], 'Qubits': result['num_qubits'],\\n                      'Measured cost': result['score'], 'Reference cost': REFERENCE_COSTS[name],\\n                      'Gain vs reference': REFERENCE_COSTS[name] / result['score'],\\n                      'Verifier seconds': result['wall_seconds'], 'Shots': result['verified_shots']})\\ncost_table = pd.DataFrame(cost_rows)\\ndisplay(cost_table.style.format({'Measured cost': '{:,.3f}', 'Reference cost': '{:,.3f}',\\n                                'Gain vs reference': '{:.4f}x', 'Verifier seconds': '{:.1f}'}))\\nprojected_score = math.prod(row['Gain vs reference'] for row in cost_rows) ** (1/3)\\nprint(f'Projected combined score from this run: {projected_score:.6f}')\\nprint('This is not an independently observed Kaggle leaderboard score.')\\nsave_json(REPORTS / 'portfolio.json', {'projected_score': projected_score, 'task_costs': cost_rows,\\n                                    'observed_kaggle_score': None,\\n                                    'projection_salt': SALT, 'environment': environment})\\n\"},{\"cell_type\":\"code\",\"execution_count\":null,\"id\":\"377e3594\",\"metadata\":{},\"outputs\":[],\"source\":\"previous_costs = {'invsqrt': 173371.4789622425, 'dqi': 2298006237919.148,\\n                  'dfthcsos': 2345104493.6482706}\\ncurrent_costs = {name: results[name]['score'] for name in ['invsqrt', 'dqi', 'dfthcsos']}\\nlabels = ['Inverse square root', 'DQI decoder', 'Chemistry']\\nratios = [current_costs[key] / previous_costs[key] for key in ['invsqrt', 'dqi', 'dfthcsos']]\\nfig, ax = plt.subplots(figsize=(9, 3.6))\\nbars = ax.barh(labels, ratios, color=[COLORS['blue'], COLORS['green'], COLORS['orange']], height=0.56)\\nax.axvline(1, color=COLORS['ink'], linestyle='--', linewidth=1)\\nfor bar, value in zip(bars, ratios):\\n    ax.text(value + 0.0015, bar.get_y() + bar.get_height()/2, f'{value:.4f}', va='center')\\nax.set(xlim=(0, 1.04), xlabel='Full verifier task cost / previous release task cost',\\n       title='All three components improve on the 5.67004 baseline archive')\\nax.grid(axis='x', alpha=0.15); ax.set_axisbelow(True)\\nfig.tight_layout()\\nfig.savefig(FIGURES / 'portfolio_vs_previous_release.png', dpi=180, bbox_inches='tight')\\nplt.show(); plt.close(fig)\\nprint('Previous observed competition score: 5.67004; this run full-check projection:', projected_score)\\nprint('DQI files differ here, so both actual resource changes and verifier sampling affect that cost ratio.')\\n\"},{\"cell_type\":\"code\",\"execution_count\":null,\"id\":\"17ac4e2f\",\"metadata\":{},\"outputs\":[],\"source\":\"expected_angle_members = {f'dfthcsos/angle_k_{index}.kmb' for index in range(EXPECTED_ANGLE_COUNT)}\\nexpected_archive_members = {'invsqrt.kmb', 'dqi.kmb', 'dfthcsos/submission.npz'} | expected_angle_members\\nassert set(file_contract['archive_members']) == expected_archive_members\\nassert len(file_contract['archive_members']) == 3 + EXPECTED_ANGLE_COUNT\\n\\nmanifest = []\\nfor name in file_contract['archive_members']:\\n    path = FINAL / name\\n    manifest.append({'file': name, 'bytes': path.stat().st_size, 'sha256': digest(path)})\\nsave_json(REPORTS / 'submission_manifest.json', manifest)\\narchive_path = WORK / 'submission.zip'\\nwith zipfile.ZipFile(archive_path, 'w', zipfile.ZIP_DEFLATED, compresslevel=6) as archive:\\n    for row in manifest:\\n        archive.write(FINAL / row['file'], row['file'])\\nwith zipfile.ZipFile(archive_path) as archive:\\n    assert sorted(archive.namelist()) == sorted(row['file'] for row in manifest)\\n    for row in manifest:\\n        with archive.open(row['file']) as stream:\\n            assert hashlib.file_digest(stream, 'sha256').hexdigest() == row['sha256'], row['file']\\nprint(f'Verified submission.zip: {archive_path.stat().st_size / 2**20:.2f} MiB; {len(manifest)} entries.')\\nprint('Creating this archive does not submit it to the competition.')\\n\\n# Keep the final archive, open generators, reports and figures; remove large duplicates.\\nfor directory in [PUBLIC, FINAL]:\\n    if directory.resolve().is