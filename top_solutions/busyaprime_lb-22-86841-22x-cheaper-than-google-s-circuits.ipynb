cc-v8-members', 'file': 'dfthcsos__submission.npz', 'codec': None, 'member': None, 'owner': 'busyaprime'}}  # archive name: where the bytes live and their SHA-256\\nOWN_PINS = {}  # our own best message-repair and chemistry members\\nZIPMETA = {'dqi.kmb': {'date_time': [1980, 1, 1, 0, 0, 0], 'mode': 384}, 'invsqrt.kmb': {'date_time': [1980, 1, 1, 0, 0, 0], 'mode': 384}, 'dfthcsos/angle_k_0.kmb': {'date_time': [1980, 1, 1, 0, 0, 0], 'mode': 384}, 'dfthcsos/angle_k_1.kmb': {'date_time': [1980, 1, 1, 0, 0, 0], 'mode': 384}, 'dfthcsos/angle_k_10.kmb': {'date_time': [1980, 1, 1, 0, 0, 0], 'mode': 384}, 'dfthcsos/angle_k_11.kmb': {'date_time': [1980, 1, 1, 0, 0, 0], 'mode': 384}, 'dfthcsos/angle_k_12.kmb': {'date_time': [1980, 1, 1, 0, 0, 0], 'mode': 384}, 'dfthcsos/angle_k_13.kmb': {'date_time': [1980, 1, 1, 0, 0, 0], 'mode': 384}, 'dfthcsos/angle_k_14.kmb': {'date_time': [1980, 1, 1, 0, 0, 0], 'mode': 384}, 'dfthcsos/angle_k_2.kmb': {'date_time': [1980, 1, 1, 0, 0, 0], 'mode': 384}, 'dfthcsos/angle_k_3.kmb': {'date_time': [1980, 1, 1, 0, 0, 0], 'mode': 384}, 'dfthcsos/angle_k_4.kmb': {'date_time': [1980, 1, 1, 0, 0, 0], 'mode': 384}, 'dfthcsos/angle_k_5.kmb': {'date_time': [1980, 1, 1, 0, 0, 0], 'mode': 384}, 'dfthcsos/angle_k_6.kmb': {'date_time': [1980, 1, 1, 0, 0, 0], 'mode': 384}, 'dfthcsos/angle_k_7.kmb': {'date_time': [1980, 1, 1, 0, 0, 0], 'mode': 384}, 'dfthcsos/angle_k_8.kmb': {'date_time': [1980, 1, 1, 0, 0, 0], 'mode': 384}, 'dfthcsos/angle_k_9.kmb': {'date_time': [1980, 1, 1, 0, 0, 0], 'mode': 384}, 'dfthcsos/submission.npz': {'date_time': [1980, 1, 1, 0, 0, 0], 'mode': 384}}  # each member's stamp and mode in the bundle's zip\\nASSEMBLED = {'sha256': '0070e2175fc52b3eedce283735d6471eb90f08be7b6b7c77573ac3a2d7b8e93d', 'bytes': 28499603}  # the bundle zip: the exact bytes this notebook must write\\nOWN_LANE = REC['own_lane_on']  # verify our own members separately when the zip holds none of ours for a job\\nFIELD_LIVE = False  # chapter 8 reads the recorded field runs; True would re-run public files (more minutes)\\nTASKS = ('invsqrt', 'dqi', 'dfthcsos')\\nJOB = {'invsqrt': 'fusion', 'dqi': 'message repair', 'dfthcsos': 'chemistry'}\\nINPUT = pathlib.Path(os.environ.get('QCC33_INPUT', '/kaggle/input'))\\nWORKING = pathlib.Path(os.environ.get('QCC33_WORKING', '/kaggle/working'))\\nSCRATCH = pathlib.Path(os.environ.get('QCC33_SCRATCH', '/tmp/qcc33'))\\nFIGDIR = WORKING / 'figures'\\nFIGDIR.mkdir(parents=True, exist_ok=True)\\napply()\\nplt.rcParams.update({'figure.dpi': 110, 'axes.titlesize': 12.5})\\n\\n\\ndef sha256(path):\\n    h = hashlib.sha256()\\n    with open(path, 'rb') as fh:\\n        for block in iter(lambda: fh.read(1 << 22), b''):\\n            h.update(block)\\n    return h.hexdigest()\\n\\n\\ndef show(fig, name, source):\\n    fig.text(0.0, -0.32 / fig.get_figheight(), 'source: ' + source, fontsize=8, color=MUTED, ha='left', va='top')\\n    fig.savefig(FIGDIR / name, bbox_inches='tight', facecolor='white')\\n    plt.show()\\n\\n\\nprint(f'{platform.python_version()} on {platform.machine()}, {os.cpu_count()} CPUs, start {START_UTC}')\"},{\"cell_type\":\"code\",\"id\":\"c02\",\"metadata\":{\"_kg_hide-input\":true,\"jupyter\":{\"source_hidden\":true,\"outputs_hidden\":true},\"_kg_hide-output\":true},\"execution_count\":null,\"outputs\":[],\"source\":\"# R1 locate and pin: each member is found under the inputs by name and accepted only by its SHA-256.\\ndef materialise(arc, pin, root):\\n    dst = root / arc\\n    dst.parent.mkdir(parents=True, exist_ok=True)\\n    tried = []\\n    for p in sorted(INPUT.rglob(pin['file'])):\\n        if not p.is_file():\\n            continue\\n        if pin.get('member'):  # a member of a public kernel's submission.zip\\n            with zipfile.ZipFile(p) as z:\\n                if pin['member'] not in z.namelist():\\n                    tried.append((str(p), 'no such member'))\\n                    continue\\n                with z.open(pin['member']) as s, open(dst, 'wb') as d:\\n                    shutil.copyfileobj(s, d, 1 << 22)\\n        elif pin.get('codec') == 'xz':\\n            with lzma.open(p) as s, open(dst, 'wb') as d:\\n                shutil.copyfileobj(s, d, 1 << 22)\\n        else:\\n            shutil.copyfile(p, dst)\\n        got = sha256(dst)\\n        if got == pin['sha256']:\\n            return p, dst\\n        tried.append((str(p), got))\\n    dst.unlink(missing_ok=True)\\n    raise RuntimeError(f\\\"STOP: {arc}: no input file {pin['file']} with SHA-256 {pin['sha256']} \\\"\\n                       f\\\"(source {pin['source']}); tried {tried}\\\")\\n\\n\\nSUB = SCRATCH / 'submission'\\nshutil.rmtree(SUB, ignore_errors=True)\\nSUB.mkdir(parents=True)\\nt = time.monotonic()\\nFOUND = {}\\nfor arc, pin in sorted(PINS.items()):\\n    src, dst = materialise(arc, pin, SUB)\\n    FOUND[arc] = str(src)\\n    print(f\\\"{arc:<26} {dst.stat().st_size:>12,} B  sha256 {pin['sha256'][:12]}...  ok  <- {src}\\\")\\nextra = sorted(str(p.relative_to(SUB)) for p in SUB.rglob('*') if p.is_file() and str(p.relative_to(SUB)) not in PINS)\\nassert not extra, extra\\nPIN_SECONDS = time.monotonic() - t\\nprint(f'{len(PINS)} of {len(PINS)} members found and matched their pins in {PIN_SECONDS:.1f} s')\"},{\"cell_type\":\"code\",\"id\":\"c03\",\"metadata\":{\"_kg_hide-input\":true,\"jupyter\":{\"source_hidden\":true,\"outputs_hidden\":true},\"_kg_hide-output\":true},\"execution_count\":null,\"outputs\":[],\"source\":\"# R2 write: the competition layout, the bundle's own entry order, stamps and modes, deflate level 6.\\nOUT_ZIP = WORKING / 'submission.zip'\\nt = time.monotonic()\\nassert sorted(ZIPMETA) == sorted(PINS)\\nwith zipfile.ZipFile(OUT_ZIP, 'w', compression=zipfile.ZIP_DEFLATED, compresslevel=6) as z:\\n    for name in ZIPMETA:  # the bundle zip's order\\n        info = zipfile.ZipInfo(name, date_time=tuple(ZIPMETA[name]['date_time']))\\n        info.compress_type = zipfile.ZIP_DEFLATED\\n        info.external_attr = ZIPMETA[name]['mode'] << 16\\n        info.file_size = (SUB / name).stat().st_size\\n        with open(SUB / name, 'rb') as s, z.open(info, 'w') as d:\\n            shutil.copyfileobj(s, d, 1 << 22)\\nwith zipfile.ZipFile(OUT_ZIP) as z:\\n    assert z.testzip() is None and sorted(z.namelist()) == sorted(PINS)\\nZIP_SHA = sha256(OUT_ZIP)\\nSAME = ZIP_SHA == ASSEMBLED['sha256']\\nZIP_SECONDS = time.monotonic() - t\\nprint(f\\\"{OUT_ZIP}: {OUT_ZIP.stat().st_size:,} B, sha256 {ZIP_SHA}; same bytes as {REC['bundle']}: {SAME} \\\"\\n      f'({ZIP_SECONDS:.1f} s)')\"},{\"cell_type\":\"code\",\"id\":\"c04\",\"metadata\":{\"_kg_hide-input\":true,\"jupyter\":{\"source_hidden\":true,\"outputs_hidden\":true},\"_kg_hide-output\":true},\"execution_count\":null,\"outputs\":[],\"source\":\"# R3 verify: the hosts' metric code, unchanged, in a child process, on the Public split of our own local run of that\\n# code on these bytes (same salts, same reference costs). R4 compare: each job's cost against that record.\\ncomp = sorted({p.parents[2] for p in INPUT.rglob('verify_submission_invsqrt.py')})\\ncomp = [c for c in comp if (c / 'kickmix').is_dir() and 'competitions' in c.parts] or comp  # the competition data\\nassert len(comp) == 1, comp\\nCOMP = comp[0]\\nKICKMIX_DIR = os.environ.get('QCC33_KICKMIX', str(COMP / 'kickmix'))\\nVERIFIERS_DIR = str(COMP / 'verifiers')\\nEXP = REC['expected']\\nfor t_ in TASKS:  # our local runner made each salt from a public formula; print whether these are those\\n    formula = hashlib.sha256(f'33-metric-local-submission.zip-Public-{t_}'.encode()).hexdigest()[:40]\\n    print(f\\\"salt {t_:<9} {EXP['salts'][t_]}  (from the runner's formula: {formula == EXP['salts'][t_]})\\\")\\nMETRIC_SRC = '\\\"\\\"\\\"Kaggle metric for 161954: verifiable quantum circuit compilation benchmarks.\\\\n\\\\nA submission is an archive holding one entry per benchmark, with every circuit in either the text\\\\n(.kmx) or the binary (.kmb) kickmix format:\\\\n\\\\n    invsqrt.kmx or invsqrt.kmb   Benchmark I: phasing by beta / sqrt(x), at n_p = 10.\\\\n    dqi.kmx or dqi.kmb           Benchmark II: the DQI Reed-Solomon decoder, RS(4095, 4025) over GF(2^12).\\\\n    dfthcsos/                    Benchmark III: the DFTHC-SOS block encoding of FeMoCo76o113e, as the\\\\n                                 ANGLE_k circuits angle_k_0 ... angle_k_<n-1>, each .kmx or .kmb,\\\\n                                 and submission.npz, holding the factorization and the Givens tree.\\\\n\\\\nEach benchmark is checked by its verifier, from the competition data, which simulates the circuits on many test inputs,\\\\nrejects the submission if any test fails, and otherwise returns its cost (lower is better). Each\\\\nleaderboard split seeds the simulations with its own secret salt, so every benchmark is verified once\\\\nper split. A split\\\\'s score is the geometric mean over the benchmarks of `baseline_cost / cost`: the\\\\nhosts\\\\' reference submissions score 1.0, and halving every benchmark\\\\'s cost scores 2.0.\\\\n\\\\nThe verifiers and kickmix come from the competition data itself, attached to the metric, so it scores\\\\nwith exactly the files participants download: verifiers/ and kickmix/, built by the 161954 prep\\\\npipeline from pinned commits of the hosts\\\\' code and Qualtran. kickmix.so is compiled for that\\\\nbuild\\\\'s Kaggle image, so the metric must run in that same image. To run the metric locally instead,\\\\ninstall kickmix and the verifiers; local installs take precedence over the competition data.\\\\n\\\"\\\"\\\"\\\\n\\\\nimport json\\\\nimport math\\\\nimport pathlib\\\\nimport random\\\\nimport stat\\\\nimport sys\\\\nimport time\\\\nimport tokenize\\\\nimport zipfile\\\\nimport zlib\\\\nfrom collections.abc import Callable, Mapping\\\\nfrom typing import Any\\\\n\\\\nimport numpy as np\\\\nimport pandas as pd\\\\n\\\\n# kickmix/ and verifiers/ in the competition data, at the 161954 prep pipeline\\\\'s COMPETITION_DATA_MOUNT.\\\\nKICKMIX_DIR = \\\\'/kaggle/input/competitions/google-verifiable-quantum-circuit-compilation/kickmix\\\\'\\\\nVERIFIERS_DIR = \\\\'/kaggle/input/competitions/google-verifiable-quantum-circuit-compilation/verifiers\\\\'\\\\n# Where the orchestrator, and run_metric_locally, put the solution and metadata files.\\\\nEVAL_INPUTS_DIR = pathlib.Path(\\\\'/kaggle/input/competition_evaluation\\\\')\\\\n\\\\n# Every kickmix instruction, as named by Circuit.operation_statistics. Listing them rejects any\\\\n# instruction a future Qualtran adds until it is reviewed. INFO_TAG is a no-op in simulation;\\\\n# kickmix\\\\'s CircuitBuilder emits it around every iadd and isub. DEBUG_PRINT is a no-op too, as every\\\\n# verifier\\\\'s simulator ignores it, but its qubit and bit ids still count toward the circuit\\\\'s.\\\\nALLOWED_INSTRUCTIONS = {\\\\n    \\\\'X\\\\', \\\\'CX\\\\', \\\\'CCX\\\\', \\\\'Z\\\\', \\\\'CZ\\\\', \\\\'CCZ\\\\', \\\\'Z_POW\\\\', \\\\'NEG\\\\', \\\\'SWAP\\\\', \\\\'CSWAP\\\\', \\\\'R\\\\', \\\\'HMR\\\\', \\\\'BIT_INVERT\\\\', \\\\'BIT_STORE0\\\\', \\\\'BIT_STORE1\\\\',\\\\n    \\\\'PUSH_CONDITION\\\\', \\\\'POP_CONDITION\\\\', \\\\'INFO_TAG\\\\', \\\\'DEBUG_PRINT\\\\',\\\\n}  # fmt: skip\\\\n# Qubit and bit ids must be below this. Verifier memory grew by ~1.5 KB per bit (dqi) and ~1.1 KB\\\\n# per qubit (invsqrt) with the verifiers at c636a96, so this capped the growth at ~1 GB; at 03027f8,\\\\n# dqi\\\\'s grows by only ~0.2 KB per qubit or bit, linearly rather than with their product. The\\\\n# baselines use ids below 50,000. Raise it if a harder benchmark needs more.\\\\nMAX_QUBIT_OR_BIT_ID = 2**30 // 1536\\\\n# The arrays read from a dfthcsos submission.npz may total at most this many bytes, ~30 times the\\\\n# ~2 MB the reference factorization and tree take.\\\\nMAX_NPZ_BYTES = 2**26\\\\n\\\\n\\\\nclass ParticipantVisibleError(Exception):\\\\n    pass\\\\n\\\\n\\\\ndef read_circuit(path: pathlib.Path, max_registers: int) -> Any:\\\\n    \\\"\\\"\\\"Return a submitted .kmx or .kmb circuit as a kickmix.Circuit; raise ValueError unless it is fit to verify.\\\\n\\\\n    kickmix validates a file as it parses it, within limits that keep parsing cheap, but simulating\\\\n    takes memory that grows with the largest qubit and bit ids, which kickmix allows up to ~5e8,\\\\n    so those are capped at MAX_QUBIT_OR_BIT_ID. kickmix also allows a million registers, at\\\\n    ~110 bytes each even if empty, so a circuit may have at most `max_registers`, the most its\\\\n    benchmark needs. Every register must be named: the dfthcsos verifier crashes on an unnamed one.\\\\n    \\\"\\\"\\\"\\\\n    import kickmix  # ty: ignore[unresolved-import]  # In kickmix/, which generate_standard_submission put on sys.path.\\\\n\\\\n    circuit = kickmix.Circuit.from_file(path, format=path.suffix.removeprefix(\\\\'.\\\\'))\\\\n    unsupported = set(circuit.operation_statistics()) - ALLOWED_INSTRUCTIONS\\\\n    if unsupported:\\\\n        raise ValueError(f\\\\'unsupported instructions {sorted(unsupported)}\\\\')\\\\n    largest_id = max(circuit.num_qubits, circuit.num_bits) - 1\\\\n    if largest_id >= MAX_QUBIT_OR_BIT_ID:\\\\n        raise ValueError(f\\\\'qubit or bit id {largest_id} is above the limit of {MAX_QUBIT_OR_BIT_ID - 1}\\\\')\\\\n    if circuit.num_registers > max_registers:\\\\n        raise ValueError(f\\\\'{circuit.num_registers} registers, above the limit of {max_registers} for this benchmark\\\\')\\\\n    if not all(isinstance(name, str) for name in circuit.register_data):\\\\n        raise ValueError(\\\\'every register needs a name, given by its REGISTER line\\\\')\\\\n    return circuit\\\\n\\\\n\\\\ndef read_npz(path: pathlib.Path, spec: Mapping[str, tuple[str, tuple[int | str, ...]]]) -> dict[str, np.ndarray]:\\\\n    \\\"\\\"\\\"Return the arrays `spec` names from an .npz; raise ValueError unless each is a plain number array as specified.\\\\n\\\\n    `spec` maps each key to the numpy dtype kinds it may have, such as \\\\'f\\\\' for floats, and its shape,\\\\n    in which a string names a dimension of any positive size that must agree wherever it recurs.\\\\n\\\\n    Each array\\\\'s header is a Python literal of its dtype and shape, which np.load trusts: a few KB\\\\n    of deflated zeros can claim a terabyte-sized array, and the dtype can be anything numpy can\\\\n    describe, from structured and nested types to Python objects that need unpickling. So the\\\\n    headers are read first, and the arrays loaded only if each is a plain number type of its kind,\\\\n    not big-endian, with its shape, and they total at most MAX_NPZ_BYTES. Only format 1.0 headers,\\\\n    which numpy.savez writes, are accepted, and numpy refuses any over 10 KB before parsing it.\\\\n    \\\"\\\"\\\"\\\\n    dimensions: dict[str, int] = {}\\\\n    total = 0\\\\n    with zipfile.ZipFile(path) as archive:\\\\n        members = {name.removesuffix(\\\\'.npy\\\\'): name for name in archive.namelist()}\\\\n        missing = [key for key in spec if key not in members]\\\\n        if missing:\\\\n            raise ValueError(f\\\\'{path.name} has no {missing}\\\\')\\\\n        for key, (kinds, expected_shape) in spec.items():\\\\n            with archive.open(members[key]) as member:\\\\n                if np.lib.format.read_magic(member) != (1, 0):\\\\n                    raise ValueError(f\\\\'{key} in {path.name} is not in .npy format 1.0, which numpy.savez writes\\\\')\\\\n                shape, _, dtype = np.lib.format.read_array_header_1_0(member)\\\\n            if dtype.kind not in kinds or dtype.names is not None or dtype.subdtype is not None or dtype.byteorder == \\\\'>\\\\':\\\\n                raise ValueError(f\\\\'{key} in {path.name} has dtype {dtype}, not a plain number type of numpy kind {kinds!r}\\\\')\\\\n            matches = len(shape) == len(expected_shape) and all(\\\\n                size > 0 and size == (dimensions.setdefault(expected, size) if isinstance(expected, str) else expected)\\\\n                for size, expected in zip(shape, expected_shape, strict=True)\\\\n            )\\\\n            if not matches:\\\\n                raise ValueError(f\\\\'{key} in {path.name} has shape {shape}, not {expected_shape} with its named dimensions as in {dimensions}\\\\')\\\\n            total += math.prod(shape) * dtype.itemsize\\\\n    if total > MAX_NPZ_BYTES:\\\\n        raise ValueError(f\\\\'the arrays in {path.name} take {total:,} bytes, above the limit of {MAX_NPZ_BYTES:,}\\\\')\\\\n    with np.load(path, allow_pickle=False) as npz:\\\\n        return {key: np.array(npz[key]) for key in spec}\\\\n\\\\n\\\\ndef find_one(root: pathlib.Path, name: str, description: str, is_dir: bool = False) -> pathlib.Path:\\\\n    \\\"\\\"\\\"The one path called `name` (a glob) under `root`, where the submission unpacked; raise ParticipantVisibleError otherwise.\\\"\\\"\\\"\\\\n    # macOS Finder\\\\'s Compress adds __MACOSX/, which mirrors every directory, with an AppleDouble ._ file per file.\\\\n    paths = [path for path in root.rglob(name) if path.is_dir() == is_dir and \\\\'__MACOSX\\\\' not in path.relative_to(root).parts]\\\\n    if len(paths) != 1:\\\\n        raise ParticipantVisibleError(f\\\\'The submission must contain exactly one {description}, found {len(paths)}.\\\\')\\\\n    return paths[0]\\\\n\\\\n\\\\ndef generate_standard_submission(submission_dir: str) -> None:\\\\n    \\\"\\\"\\\"Verify the submission under every split\\\\'s salt, and write each verification\\\\'s cost as submission.csv.\\\\n\\\\n    `submission_dir` is where the orchestrator unpacked the submission archive. Every split\\\\'s verifications run here, in random order, before the orchestrator calls score() for\\\\n    either split, so neither a failure\\\\'s timing nor its message shows which split it failed on.\\\\n    Every file is read and checked before any verifier runs, so a malformed file fails in seconds\\\\n    rather than after another benchmark\\\\'s verification. The verifiers run one at a time, as the\\\\n    invsqrt and dqi verifiers spread their own simulation across processes.\\\\n\\\\n    The orchestrator passes neither the solution nor the metadata in, so the solution is read from\\\\n    where it puts it; this metric\\\\'s own solution names its row id column `row_id`. Each row\\\\'s\\\\n    `seed_salt` is merged by its verifier with the submission\\\\'s hash to seed the simulation, so a\\\\n    submission always faces the same tests, but participants can\\\\'t compute them. Unsalted, the seed\\\\n    would let a team whose circuit fails on a few inputs re-roll its tests offline with cost-free\\\\n    edits until they miss those inputs; with the salt, each re-roll costs a submission. A salt that\\\\n    is missing or short is refused, as it would leave the seed unsalted or guessable.\\\\n\\\\n    kickmix and the verifiers are imported here rather than at the top because the orchestrator imports\\\\n    this module during validation, when the competition data isn\\\\'t mounted.\\\\n    \\\"\\\"\\\"\\\\n    solution_paths = list(EVAL_INPUTS_DIR.glob(\\\\'solution.*\\\\'))\\\\n    if len(solution_paths) != 1:\\\\n        raise ValueError(f\\\\'Expected one solution.csv or solution.parquet in {EVAL_INPUTS_DIR}, found {[path.name for path in solution_paths]}\\\\')\\\\n    [solution_path] = solution_paths\\\\n    solution = pd.read_csv(solution_path) if solution_path.suffix == \\\\'.csv\\\\' else pd.read_parquet(solution_path)\\\\n    scored = solution[solution[\\\\'Usage\\\\'] != \\\\'Ignored\\\\']\\\\n    # score()\\\\'s hyperparameters, which the orchestrator passes only to score().\\\\n    hyperparameters = json.loads((EVAL_INPUTS_DIR / \\\\'metadata.json\\\\').read_text()).get(\\\\'Hyperparameters\\\\') or {}\\\\n    shot_divisor = int(hyperparameters.get(\\\\'verification_shot_divisor\\\\', 1))\\\\n    for salt in scored[\\\\'seed_salt\\\\']:\\\\n        if not isinstance(salt, str) or len(salt) < 32:\\\\n            raise ValueError(f\\\\'Every scored solution row needs a seed_salt of at least 32 characters, got {salt!r}\\\\')\\\\n\\\\n    # Appended, not prepended, so local installs of kickmix and the verifiers win when running locally.\\\\n    sys.path += [KICKMIX_DIR, VERIFIERS_DIR]\\\\n    from dfthcsos import verify as dfthcsos_verify  # ty: ignore[unresolved-import]  # These live in verifiers/.\\\\n    from dfthcsos.scoreinfra.reference import FACTORIZATION_KEYS, ORBITALS  # ty: ignore[unresolved-import]\\\\n    from dqi import verify_submission_dqi  # ty: ignore[unresolved-import]\\\\n    from invsqrt import verify_submission_invsqrt  # ty: ignore[unresolved-import]\\\\n\\\\n    root = pathlib.Path(submission_dir)\\\\n\\\\n    def read(path: pathlib.Path, reader: Callable[[pathlib.Path, Any], Any], spec: Any) -> Any:\\\\n        # tar and 7z submissions can unpack links, which would have this read the host\\\\'s files, and\\\\n        # FIFOs and devices, which would block or never end.\\\\n        status = path.lstat()\\\\n        if not stat.S_ISREG(status.st_mode) or status.st_nlink > 1 or not path.resolve().is_relative_to(root.resolve()):\\\\n            raise ParticipantVisibleError(f\\\\'{path.relative_to(root)} must be a regular file, not a link or a special file.\\\\')\\\\n        try:\\\\n            return reader(path, spec)\\\\n        # What kickmix, zipfile, zlib and numpy raise on malformed files, found by fuzzing an .npz.\\\\n        except (ValueError, RuntimeError, OSError, EOFError, zipfile.BadZipFile, zlib.error, tokenize.TokenError) as err:\\\\n            raise ParticipantVisibleError(f\\\\'{path.relative_to(root)} is invalid: {err}\\\\') from err\\\\n\\\\n    batches = max(1, verify_submission_dqi.DEFAULT_NUM_SHOTS // verify_submission_dqi.DEFAULT_BATCH_SIZE // shot_divisor)\\\\n    dqi_spec = verify_submission_dqi.ProblemSpecDQI.benchmark_instance(num_shots=batches * verify_submission_dqi.DEFAULT_BATCH_SIZE)\\\\n    # Each circuit\\\\'s most registers: invsqrt\\\\'s x, and dqi\\\\'s S_i and E_j.\\\\n    invsqrt = read(find_one(root, \\\\'invsqrt.km[xb]\\\\', \\\\'invsqrt.kmx or invsqrt.kmb\\\\'), read_circuit, 1)\\\\n    dqi = read(find_one(root, \\\\'dqi.km[xb]\\\\', \\\\'dqi.kmx or dqi.kmb\\\\'), read_circuit, dqi_spec.n + dqi_spec.m)\\\\n    dfthcsos_dir = find_one(root, \\\\'dfthcsos\\\\', \\\\'dfthcsos directory\\\\', is_dir=True)\\\\n    angle_files = list(dfthcsos_dir.glob(\\\\'angle_k_*.km[xb]\\\\'))\\\\n    angle_paths = {path.stem: path for path in angle_files}\\\\n    # A circuit given in both formats leaves fewer stems than files, so the two can\\\\'t match.\\\\n    stems = [f\\\\'angle_k_{k}\\\\' for k in range(len(angle_files))]\\\\n    if not stems or sorted(angle_paths) != sorted(stems):\\\\n        raise ParticipantVisibleError(\\\\'dfthcsos/ must hold the circuits angle_k_0 ... angle_k_<n-1>, each once, as .kmx or .kmb.\\\\')\\\\n    # An ANGLE_k circuit\\\\'s `selection` and `word_j` registers each hold a qubit, of at most QUBIT_CAP.\\\\n    # The verifier allows other registers too, but none are needed.\\\\n    angle_circuits = [read(angle_paths[stem], read_circuit, dfthcsos_verify.QUBIT_CAP) for stem in stems]\\\\n    # The factorization (see dfthcsos.scoreinfra.reference), with R factors of B vectors over the N\\\\n    # orbitals and C copies, and the Givens tree\\\\'s N - 1 edges.\\\\n    npz_spec = {\\\\n        \\\\'U\\\\': (\\\\'f\\\\', (\\\\'R\\\\', \\\\'B\\\\', ORBITALS)),\\\\n        \\\\'W\\\\': (\\\\'f\\\\', (\\\\'R\\\\', \\\\'B\\\\', \\\\'C\\\\')),\\\\n        \\\\'H2_I\\\\': (\\\\'f\\\\', (\\\\'R\\\\', \\\\'C\\\\')),\\\\n        \\\\'H1_I\\\\': (\\\\'f\\\\', ()),\\\\n        \\\\'Hsym_lower\\\\': (\\\\'f\\\\', (ORBITALS * (ORBITALS + 1) // 2,)),\\\\n        \\\\'tree_edges\\\\': (\\\\'iu\\\\', (ORBITALS - 1, 2)),\\\\n    }\\\\n    if set(npz_spec) != {*FACTORIZATION_KEYS, \\\\'tree_edges\\\\'}:\\\\n        raise ValueError(f\\\\'The dfthcsos verifier reads the factorization arrays {FACTORIZATION_KEYS}, which npz_spec must cover exactly\\\\')\\\\n    npz = read(find_one(dfthcsos_dir, \\\\'submission.npz\\\\', \\\\'dfthcsos/submission.npz\\\\'), read_npz, npz_spec)\\\\n    tree_edges = npz.pop(\\\\'tree_edges\\\\')\\\\n\\\\n    # Benchmark -> its verifier run, given the salt.\\\\n    verifications: dict[str, Callable[[str], dict[str, Any]]] = {\\\\n        \\\\'invsqrt\\\\': lambda salt: verify_submission_invsqrt.verify(invsqrt, verify_submission_invsqrt.ProblemSpecInvSqrt.for_n_p(10), salt=salt),\\\\n        \\\\'dqi\\\\': lambda salt: verify_submission_dqi.verify(dqi, dqi_spec, salt=salt),\\\\n        \\\\'dfthcsos\\\\': lambda salt: dfthcsos_verify.verify(\\\\n            angle_circuits, npz, tree_edges, salt=salt, shots_per_address=max(1, dfthcsos_verify.SHOTS_PER_ADDRESS // shot_divisor)\\\\n        ),\\\\n    }\\\\n    runs = list(zip(scored[\\\\'row_id\\\\'], scored[\\\\'benchmark\\\\'], scored[\\\\'seed_salt\\\\'], strict=True))\\\\n    random.shuffle(runs)\\\\n    # Ignored rows aren\\\\'t scored, but the orchestrator still expects a submission row for each.\\\\n    costs, seconds = dict.fromkeys(solution[\\\\'row_id\\\\'], 0.0), dict.fromkeys(solution[\\\\'row_id\\\\'], 0.0)\\\\n    for row_id, benchmark, salt in runs:\\\\n        start = time.monotonic()\\\\n        try:\\\\n            costs[row_id] = float(verifications[benchmark](salt)[\\\\'score\\\\'])\\\\n        # The exceptions the verifiers\\\\' command lines report as a failed submission; dfthcsos\\\\'s\\\\n        # InvalidCircuits is a ValueError.\\\\n        except (AssertionError, ValueError, RuntimeError, KeyError) as err:\\\\n            raise ParticipantVisibleError(f\\\\'The {benchmark} submission failed verification: {err}\\\\') from err\\\\n        if not costs[row_id] > 0:\\\\n            raise ParticipantVisibleError(f\\\\'The {benchmark} submission has non-positive cost {costs[row_id]}.\\\\')\\\\n        seconds[row_id] = time.monotonic() - start\\\\n    pd.DataFrame({\\\\'row_id\\\\': list(costs), \\\\'cost\\\\': list(costs.values()), \\\\'seconds\\\\': list(seconds.values())}).to_csv(\\\\'submission.csv\\\\', index=False)\\\\n\\\\n\\\\ndef score(\\\\n    solution: pd.DataFrame, submission: pd.DataFrame, row_id_column_name: str, verification_shot_divisor: int = 1\\\\n) -> tuple[float, dict[str, Any]]:\\\\n    \\\"\\\"\\\"Return the geometric mean over the benchmarks of `baseline_cost / cost`, where higher is better.\\\\n\\\\n    `verification_shot_divisor` is for testing only, and must stay 1 on Kaggle. generate_standard_submission\\\\n    reads it, and divides the dqi and dfthcsos verifiers\\\\' default numbers of shots by it, which makes\\\\n    their verification that much faster and weaker, and changes their costs, so that the reference\\\\n    submissions no longer score 1.0. invsqrt\\\\'s verifier is the fastest, and needs a multiple of 64\\\\n    shots per input to fill its batches, its default, so it keeps every shot.\\\\n\\\\n    The solution has a row per benchmark and leaderboard split, holding the split\\\\'s secret\\\\n    `seed_salt` and the `baseline_cost` its benchmark\\\\'s reference submission scored under that salt.\\\\n    `submission` is generate_standard_submission\\\\'s output, which holds each row\\\\'s `cost`, as the\\\\n    verification runs there. Returns each benchmark\\\\'s cost, improvement and verification time as\\\\n    details.\\\\n    \\\"\\\"\\\"\\\\n    merged = solution.merge(submission, on=row_id_column_name, validate=\\\\'one_to_one\\\\')\\\\n    details = {\\\\n        benchmark: {\\\\'cost\\\\': cost, \\\\'improvement_over_baseline\\\\': baseline_cost / cost, \\\\'seconds\\\\': run_seconds}\\\\n        for benchmark, cost, baseline_cost, run_seconds in zip(\\\\n            merged[\\\\'benchmark\\\\'], merged[\\\\'cost\\\\'], merged[\\\\'baseline_cost\\\\'], merged[\\\\'seconds\\\\'], strict=True\\\\n        )\\\\n    }\\\\n    ratios = [benchmark_details[\\\\'improvement_over_baseline\\\\'] for benchmark_details in details.values()]\\\\n    return math.prod(ratios) ** (1 / len(ratios)), details\\\\n'  # the hosts' metric notebook, code cell, unchanged\\nRUNNER_SRC = '\\\\n\\\"\\\"\\\"33 | Runs the hosts\\\\' metric code (google-quantum-ai-metric, unchanged) on the unpacked submission in a child\\\\nprocess, and saves each verifier\\\\'s full report as a receipt. Config: one JSON file, argv[1].\\\"\\\"\\\"\\\\nimport functools, hashlib, json, os, pathlib, resource, sys, time, types\\\\n\\\\n\\\\ndef main(cfg_path):\\\\n    cfg = json.loads(pathlib.Path(cfg_path).read_text())\\\\n    src = pathlib.Path(cfg[\\\\'metric_py\\\\']).read_text()\\\\n    assert hashlib.sha256(src.encode()).hexdigest() == cfg[\\\\'metric_sha256\\\\'], \\\\'the metric source is not the pinned one\\\\'\\\\n    sys.path += [cfg[\\\\'kickmix_dir\\\\'], cfg[\\\\'verifiers_dir\\\\']]  # appended, as the metric does\\\\n    from invsqrt import verify_submission_invsqrt as v_inv\\\\n    from dqi import verify_submission_dqi as v_dqi\\\\n    from dfthcsos import verify as v_chem\\\\n    receipts = pathlib.Path(cfg[\\\\'receipts\\\\'])\\\\n    receipts.mkdir(parents=True, exist_ok=True)\\\\n\\\\n    def keep(task, module):\\\\n        original = module.verify\\\\n\\\\n        @functools.wraps(original)\\\\n        def run(*args, **kwargs):\\\\n            t = time.monotonic()\\\\n            report = original(*args, **kwargs)\\\\n            seconds = time.monotonic() - t\\\\n            out = json.loads(json.dumps(report, default=lambda o: o.item() if hasattr(o, \\\\'item\\\\') else str(o)))\\\\n            out[\\\\'_salt\\\\'], out[\\\\'_seconds\\\\'] = kwargs.get(\\\\'salt\\\\'), seconds\\\\n            (receipts / f\\\\'{task}.json\\\\').write_text(json.dumps(out, indent=1))\\\\n            print(f\\\"{task:<9} {out.get(\\\\'status\\\\')}  cost {out.get(\\\\'score\\\\')}  {seconds:.1f} s\\\", flush=True)\\\\n            return report\\\\n        module.verify = run\\\\n\\\\n    keep(\\\\'invsqrt\\\\', v_inv)\\\\n    keep(\\\\'dqi\\\\', v_dqi)\\\\n    keep(\\\\'dfthcsos\\\\', v_chem)\\\\n    metric = types.ModuleType(\\\\'google_quantum_ai_metric\\\\')\\\\n    exec(compile(src, \\\\'google-quantum-ai-metric\\\\', \\\\'exec\\\\'), metric.__dict__)\\\\n    metric.KICKMIX_DIR, metric.VERIFIERS_DIR = cfg[\\\\'kickmix_dir\\\\'], cfg[\\\\'verifiers_dir\\\\']\\\\n    metric.EVAL_INPUTS_DIR = pathlib.Path(cfg[\\\\'eval_dir\\\\'])\\\\n    os.chdir(cfg[\\\\'eval_dir\\\\'])  # generate_standard_submission writes submission.csv here\\\\n    t0 = time.monotonic()\\\\n    metric.generate_standard_submission(cfg[\\\\'unpacked\\\\'])\\\\n    import pandas as pd\\\\n    submission = pd.read_csv(\\\\'submission.csv\\\\')\\\\n    solution = pd.read_csv(pathlib.Path(cfg[\\\\'eval_dir\\\\']) / \\\\'solution.csv\\\\')\\\\n    score, details = metric.score(solution, submission, \\\\'row_id\\\\')\\\\n    out = {\\\\'score\\\\': score, \\\\'details\\\\': details, \\\\'wall_seconds\\\\': time.monotonic() - t0,\\\\n           \\\\'maxrss_self_kib\\\\': resource.getrusage(resource.RUSAGE_SELF).ru_maxrss,\\\\n           \\\\'maxrss_children_kib\\\\': resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss}\\\\n    pathlib.Path(cfg[\\\\'out\\\\']).write_text(json.dumps(out, indent=1, default=float))\\\\n    print(json.dumps({\\\\'score\\\\': score, \\\\'wall_seconds\\\\': out[\\\\'wall_seconds\\\\']}), flush=True)\\\\n\\\\n\\\\nif __name__ == \\\\'__main__\\\\':\\\\n    main(sys.argv[1])\\\\n'\\nMETRIC_SHA = hashlib.sha256(METRIC_SRC.encode()).hexdigest()\\n\\n\\ndef run_metric(unpacked, tasks, tag):\\n    eval_dir, receipts, out = SCRATCH / f'eval_{tag}', WORKING / f'receipts{tag}', SCRATCH / f'metric_{tag}.json'\\n    eval_dir.mkdir(parents=True, exist_ok=True)\\n    pd.DataFrame([{'row_id': f'Public_{t}', 'benchmark': t, 'seed_salt': EXP['salts'][t],\\n                   'baseline_cost': EXP['baseline'][t], 'Usage': 'Public'} for t in tasks]\\n                 ).to_csv(eval_dir / 'solution.csv', index=False)\\n    (eval_dir / 'metadata.json').write_text(json.dumps({'Hyperparameters': {}}))\\n    (SCRATCH / 'google_quantum_ai_metric.py').write_text(METRIC_SRC)\\n    (SCRATCH / 'runner.py').write_text(RUNNER_SRC)\\n    cfg = {'metric_py': str(SCRATCH / 'google_quantum_ai_metric.py'), 'metric_sha256': METRIC_SHA,\\n           'kickmix_dir': KICKMIX_DIR, 'verifiers_dir': VERIFIERS_DIR, 'eval_dir': str(eval_dir),\\n           'unpacked': str(unpacked), 'receipts': str(receipts), 'out': str(out)}\\n    (SCRATCH / f'cfg_{tag}.json').write_text(json.dumps(cfg))\\n    t = time.monotonic()\\n    proc = subprocess.Popen([sys.executable, '-u', str(SCRATCH / 'runner.py'), str(SCRATCH / f'cfg_{tag}.json')],\\n                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)\\n    for line in proc.stdout:\\n        print(line, end='')\\n    rc = proc.wait()\\n    assert rc == 0, f'the metric run exited with {rc}'\\n    res = json.loads(out.read_text())\\n    res['seconds_outside'] = time.monotonic() - t\\n    reports = {t: json.loads((receipts / f'{t}.json').read_text()) for t in tasks}\\n    return res, reports\\n\\n\\nRESULT, REPORTS = run_metric(SUB, TASKS, '')\\nRSS_GIB = resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss / (2**30 if sys.platform == 'darwin' else 2**20)  # KiB on Linux, bytes on macOS\\nSCORE = RESULT['score']\\nREL = {t: abs(REPORTS[t]['score'] - EXP['costs'][t]) / EXP['costs'][t] for t in TASKS}\\nREL_SCORE = abs(SCORE - EXP['score']) / EXP['score']\\nfor t in TASKS:\\n    assert REPORTS[t]['status'] == 'PASS' and REPORTS[t]['_salt'] == EXP['salts'][t], t\\n    print(f\\\"{t:<9} PASS  cost {REPORTS[t]['score']:,.6f}  record {EXP['costs'][t]:,.6f}  rel diff {REL[t]:.1e}\\\")\\nprint(f\\\"score by the hosts' metric code: {SCORE:.5f} (record {EXP['score']:.5f}, rel diff {REL_SCORE:.1e}); \\\"\\n      f\\\"metric {RESULT['wall_seconds']:.0f} s; peak RSS of the largest child {RSS_GIB:.2f} GiB\\\")\"},{\"cell_type\":\"code\",\"id\":\"c05\",\"metadata\":{\"_kg_hide-input\":true,\"jupyter\":{\"source_hidden\":true,\"outputs_hidden\":true},\"_kg_hide-output\":true},\"execution_count\":null,\"outputs\":[],\"source\":\"# R6 own lane: when the zip holds no member of ours for a job, our best own member for it is verified the same way.\\nOWN_REPORTS = {}\\nmissing = REC['own_missing']\\nif OWN_LANE and missing:\\n    OWN = SCRATCH / 'own'\\n    shutil.rmtree(OWN, ignore_errors=True)\\n    shutil.copytree(SUB, OWN)\\n    for arc, pin in OWN_PINS.items():\\n        if arc.split('/')[0].split('.')[0] in missing:\\n            (OWN / arc).unlink(missing_ok=True)\\n            materialise(arc, pin, OWN)\\n    _, OWN_REPORTS = run_metric(OWN, tuple(missing), '_ours')\\n    print('own lane:', {t: (r['status'], r['score']) for t, r in OWN_REPORTS.items()})\\nelse:\\n    print('own lane: off; our earlier members are quoted from their records (chapters 5 to 7), not re-run here')\"},{\"cell_type\":\"code\",\"id\":\"c06\",\"metadata\":{\"_kg_hide-input\":true,\"jupyter\":{\"source_hidden\":true}},\"execution_count\":null,\"outputs\":[],\"source\":\"R = {t: REPORTS[t] for t in TASKS}\\nref = REC['ref']\\nri, rd, rc = R['invsqrt'], R['dqi'], R['dfthcsos']\\nk_run = rd['value_errors'] + rd['phase_errors']\\nratio = {t: EXP['baseline'][t] / R[t]['score'] for t in TASKS}\\n\\n\\ndef money(x):\\n    return f'{x:,.0f}' if x < 1e7 else f'{x:.3e}'\\n\\n\\ndef stamp(s):\\n    return f'<span style=\\\"color:{ACCENT};font-weight:700\\\">{s}</span>'\\n\\n\\nrows = [\\n    ('JOB 1  FUSION, phase by 1/sqrt(x)', ri['verified_shots'], '',\\n     f\\\"{ref['invsqrt']['q']} seats x {ref['invsqrt']['c']:,.2f} stamps\\\", ref['invsqrt']['cost'],\\n     f\\\"{ri['num_qubits']} seats x {ri['toffoli_equivalent']:,.2f} stamps\\\", ri['score'], 'invsqrt'),\\n    ('JOB 2  MESSAGE REPAIR, Reed-Solomon decoder', rd['verified_shots'], f', {k_run} failed',\\n     f\\\"R {ref['dqi']['r']:.5f} x {ref['dqi']['q']:,}^2 seats x {ref['dqi']['t']:,.0f} stamps\\\", ref['dqi']['cost'],\\n     f\\\"R {rd['repetition_factor']:.5f} x {rd['num_qubits']}^2 seats x {rd['toffoli_count']:,.0f} stamps\\\", rd['score'], 'dqi'),\\n    ('JOB 3  CHEMISTRY, FeMoCo lookups and rotations', rc['verified_shots'], '',\\n     f\\\"volume {ref['dfthcsos']['lam']:.2f} x {ref['dfthcsos']['t']:,.0f} stamps x {ref['dfthcsos']['q']} seats\\\",\\n     ref['dfthcsos']['cost'], f\\\"volume {rc['lambda_eff']:.2f} x {rc['toffoli_count']:,.0f} stamps x {rc['num_qubits']} seats\\\",\\n     rc['score'], 'dfthcsos'),\\n]\\nW = 92\\nlines = [f\\\"RECEIPT  Google Quantum AI, Verifiable Quantum Circuit Compilation{START_UTC:>{W - 64}}\\\", '=' * W]\\nfor head, shots, fails, g_bill, g_cost, o_bill, o_cost, t in rows:\\n    lines.append(f\\\"{head:<58}\\\" + stamp('PASS') + f\\\"  {shots:,} checks{fails}\\\")\\n    lines.append(f\\\"  Google's bill   {g_bill:<58}= {money(g_cost):>12}\\\")\\n    lines.append(stamp(f\\\"  our bill        {o_bill:<58}= {money(o_cost):>12}\\\"))\\n    lines.append(f\\\"{'':<64}\\\" + stamp(f\\\"{ratio[t]:>8.2f}x cheaper\\\"))\\n    lines.append('')\\nlines += ['-' * W,\\n          f\\\"TOTAL  geometric mean of the three ratios, by the hosts' metric code, this run {stamp(f'{SCORE:>10.5f}')}\\\",\\n          f\\\"same bytes as our submission {REC['bundle']} ({ASSEMBLED['sha256'][:16]}...): {stamp(str(SAME)) if SAME else 'False'}\\\"\\n          + (f\\\", LB {REC['lb']}\\\" if REC['lb'] else ''),\\n          f\\\"cost difference to the record of the same code, bytes and salts: at most {max(REL.values()):.1e}\\\",\\n          f\\\"run so far {time.monotonic() - T0:,.0f} s on {os.cpu_count()} CPUs; peak RSS {RSS_GIB:.2f} GiB\\\"]\\ndisplay(HTML('<pre style=\\\"font-family:Menlo,Consolas,monospace;font-size:12.5px;line-height:1.35;background:#fff;'\\n             'border:2px dashed #8b949e;padding:14px 18px;color:#1f2328;white-space:pre;overflow-x:auto\\\">'\\n             + '\\\\n'.join(lines) + '</pre>'))\\n\\nfig, ax = plt.subplots(figsize=(9.6, 2.6))\\ny = np.arange(3)[::-1]\\nfor yi, t in zip(y, TASKS):\\n    ax.barh(yi + 0.17, 1.0, height=0.32, color='#adb5bd')\\n    ax.barh(yi - 0.17, 1 / ratio[t], height=0.32, color=ACCENT)\\n    ax.text(1 / ratio[t] * 1.08, yi - 0.17, f'ours: {ratio[t]:.2f}x cheaper', va='center', fontsize=10, color=ACCENT)\\n    ax.text(1.0 * 1.08, yi + 0.17, \\\"Google's bill\\\", va='center', fontsize=9.5, color=MUTED)\\nax.set_xscale('log')\\nax.set_xlim(0.02, 4)\\nax.set_yticks(y, [JOB[t] for t in TASKS])\\nax.grid(axis='y', visible=False)\\nax.set_xlabel(\\\"bill, as a share of Google's reference bill (log scale)\\\")\\nshow(fig, 'f0_receipt_bars.png', '/kaggle/working/receipts/*.json (this run); sample_invsqrt.verify.json, sample_dqi.json, '\\n     \\\"sample_dfthcsos.json (reference bills); data/qcc/runs/\\\" + REC[\\\"bundle\\\"] + \\\"/metric_local/metric_local.json\\\")\"},{\"cell_type\":\"markdown\",\"id\":\"c07\",\"metadata\":{},\"source\":\"**Reading map.** 1 Seats and stamps (a four-wire circuit, run live) \u00b7 2 The inspector's dice (a planted mistake\\ncaught) \u00b7 3 The bill (a price list) \u00b7 4 Fusion (the relay) \u00b7 5 Message repair (the price of a mistake, the decoder's\\ndiet) \u00b7 6 Chemistry (the jukebox) \u00b7 7 What we built (our judge and Kaggle's, every attempt counted) \u00b7 8 The race\\n(the tide, the tie wall, the field) \u00b7 9 Run it yourself \u00b7 10 What we concluded \u00b7 11 Changelog \u00b7 12 Credits\"},{\"cell_type\":\"markdown\",\"id\":\"c08\",\"metadata\":{},\"source\":\"## 1. Seats and stamps\\n\\nA quantum circuit is sheet music for qubits: a list of instructions, each touching one to three wires, played left to\\nright. The hosts allow four kinds of instruction: reversible classical gates, phase flips, measurements that reset a\\nwire, and operations on plain classical bits. With those, no instruction ever spreads a wire over several values at once, so an ordinary computer can\\nfollow each wire as a single 0 or 1 plus one sign for the whole circuit (the paper, section II.A, `qcc.txt:121-133`). That is why a Kaggle\\nCPU can check a quantum circuit at all.\\n\\nThe bill counts two things. **Seats** are qubits: the wires the circuit holds at its busiest moment. **Stamps** are\\nToffoli-like gates (CCX, CCZ, CSWAP), \\\"flip the target only if both controls are 1\\\", which the hosts' cost model\\ncharges for. Gates on one or two wires cost nothing, except the fine rotations the fusion job bills (chapter 3), and\\nneither does measuring a scratch wire away (HMR) when a cheap phase fix follows; the paper's own example saves a\\nToffoli this way (`qcc.txt:142-144`).\\n\\nFigure 1 is a complete circuit with four seats and one stamp, run live by the 30-line simulator below.\"},{\"cell_type\":\"code\",\"id\":\"c09\",\"metadata\":{\"_kg_hide-input\":true,\"jupyter\":{\"source_hidden\":true}},\"execution_count\":null,\"outputs\":[],\"source\":\"def run_toy(circuit, a, b, coin):\\n    \\\"\\\"\\\"Run a 4-wire circuit on inputs a, b. coin() gives the random bit an HMR measurement returns.\\\"\\\"\\\"\\n    w, sign, m = [a, b, 0, 0], 1, 0\\n    for gate, *q in circuit:\\n        if gate == 'X':\\n            w[q[0]] ^= 1\\n        elif gate == 'CX':\\n            w[q[1]] ^= w[q[0]]\\n        elif gate == 'CCX':  # the one gate on the bill: a Toffoli\\n            w[q[2]] ^= w[q[0]] & w[q[1]]\\n        elif gate == 'HMR':  # measure in the X basis and reset: random m, phase (-1)^(m * wire)\\n            m = coin()\\n            if m and w[q[0]]:\\n                sign = -sign\\n            w[q[0]] = 0\\n        elif gate == 'CZ_IF_M':  # classically controlled CZ: the cheap phase fix after HMR\\n            if m and w[q[0]] and w[q[1]]:\\n                sign = -sign\\n    return w, sign\\n\\n\\ndef inspect_toy(circuit, a, b, coin):\\n    \\\"\\\"\\\"The inspector's three checks: right answer, scratch wire back to 0, no stray sign.\\\"\\\"\\\"\\n    w, sign = run_toy(circuit, a, b, coin)\\n    return w[3] == 1 - (a & b) and w[2] == 0 and sign == 1\\n\\n\\nWIRES = ['a', 'b', 'scratch', 'out']\\nTOY = [('CCX', 0, 1, 2), ('CX', 2, 3), ('HMR', 2), ('CZ_IF_M', 0, 1), ('X', 3)]  # out = NOT (a AND b)\\nTOY_BAD = [g for g in TOY if g[0] != 'CZ_IF_M']  # the planted mistake: the phase fix is gone\\n\\nfig = plt.figure(figsize=(11.2, 3.3))\\nax = fig.add_axes([0.0, 0.0, 0.62, 1.0])\\nxs = {0: 1.0, 1: 2.0, 2: 3.0, 3: 4.0, 4: 5.0}\\nfor i, name in enumerate(WIRES):\\n    ax.plot([0.4, 5.6], [3 - i, 3 - i], color=INK, lw=1.2, zorder=1)\\n    ax.text(0.3, 3 - i, name, ha='right', va='center', fontsize=11)\\nfor x_, (gate, *q) in zip(xs.values(), TOY):\\n    ys = [3 - j for j in q]\\n    if gate in ('CCX', 'CX'):\\n        ax.plot([x_, x_], [min(ys), max(ys)], color=INK, lw=1.2, zorder=2)\\n        for yy in ys[:-1]:\\n            ax.scatter(x_, yy, s=40, color=INK, zorder=3)\\n        ax.scatter(x_, ys[-1], s=260, facecolors='white', edgecolors=ACCENT if gate == 'CCX' else INK, lw=1.6, zorder=3)\\n        ax.text(x_, ys[-1], '+', ha='center', va='center', fontsize=13, color=ACCENT if gate == 'CCX' else INK, zorder=4)\\n    elif gate == 'CZ_IF_M':\\n        ax.plot([x_, x_], [min(ys), max(ys)], color=INK, lw=1.2, zorder=2)\\n        for yy in ys:\\n            ax.scatter(x_, yy, s=40, color=INK, zorder=3)\\n        ax.plot([x_ - 1.0, x_ - 1.0, x_, x_], [1.24, 1.5, 1.5, min(ys)], color=MUTED, lw=1, ls='--')\\n        ax.text(x_ - 0.5, 1.56, 'm', fontsize=9, color=MUTED, ha='center')\\n        ax.text(x_ + 0.08, 2.5, 'CZ if m', fontsize=9, color=MUTED)\\n    else:\\n        ax.add_patch(plt.Rectangle((x_ - 0.28, ys[0] - 0.24), 0.56, 0.48, facecolor='white', edgecolor=INK, zorder=3))\\n        ax.text(x_, ys[0], gate, ha='center', va='center', fontsize=9.5, zorder=4)\\nax.text(1.2, 1.3, 'one stamp (Toffoli)', ha='left', fontsize=9.5, color=ACCENT)\\nax.text(3.0, 0.62, 'erase scratch: free', ha='center', fontsize=9.5, color=MUTED)\\nax.set_xlim(-0.3, 5.9)\\nax.set_ylim(-0.6, 3.5)\\nax.axis('off')\\nax2 = fig.add_axes([0.66, 0.08, 0.33, 0.84])\\nax2.axis('off')\\ntable = [['a', 'b', 'out', 'scratch', 'sign']]\\nfor a in (0, 1):\\n    for b in (0, 1):\\n        outs = {tuple(run_toy(TOY, a, b, lambda m=m: m)[0][2:]) + (run_toy(TOY, a, b, lambda m=m: m)[1],) for m in (0, 1)}\\n        assert len(outs) == 1  # the same result whatever the measurement says\\n        (o,) = outs\\n        table.append([a, b, o[1], o[0], '+' if o[2] == 1 else '-'])\\ntab = ax2.table(cellText=table, loc='center', cellLoc='center')\\ntab.scale(1, 1.5)\\nfor (r_, c_), cell in tab.get_celld().items():\\n    cell.set_edgecolor(GRID)\\n    if r_ == 0:\\n        cell.set_text_props(fontweight='bold')\\nax2.set_title('truth table, run live: out = NOT (a AND b)', fontsize=11)\\nfig.suptitle('Figure 1. A circuit is sheet music: 4 seats, 1 stamp', x=0.0, ha='left', fontsize=12.5, fontweight='semibold')\\nshow(fig, 'f1_toy_circuit.png', 'this notebook (run_toy); gate classes from the hosts\\\\' paper, section II.A')\"},{\"cell_type\":\"markdown\",\"id\":\"c10\",\"metadata\":{},\"source\":\"*Figure 1. The Toffoli computes a AND b into a scratch wire, a CX copies it to the output, HMR measures the scratch\\nwire away, and a CZ, applied only when the measurement says 1, undoes the sign the measurement may leave. Every row\\nof the table comes out the same whichever way the measurement falls, which is what the inspector checks.*\\n\\n| instruction | what it does | everyday picture | on the bill |\\n|---|---|---|---|\\n| X, CX, SWAP | flip a wire, add one wire into another, swap two | a light switch, copying a note | free |\\n| CCX, CCZ, CSWAP | act only when both control wires are 1 | a door with two keys | **one stamp each** |\\n| Z, CZ, Z_POW, NEG | change the sign (phase), leave the bits alone | a mark in the margin | free; fine Z_POW rotations are billed in the fusion job |\\n| HMR, R | measure a wire away and reset it to 0 | wiping a scratch pad | free; HMR needs a phase fix |\\n| BIT_STORE0, BIT_STORE1, BIT_INVERT, PUSH_CONDITION, POP_CONDITION | classical bits and \\\"only if\\\" blocks | a sticky note, an if | free |\\n| INFO_TAG, DEBUG_PRINT | labels | comments | free |\\n\\nWhere the picture breaks: real qubits can be in superpositions. These circuits are built so that, on the basis\\ninputs the inspector feeds them, no instruction needs one; the real machine would run them on superpositions.\\n\\n<sub>sources: `ALLOWED_INSTRUCTIONS` in the hosts' metric code; the paper (`data/qcc/doc/qcc.txt`, section II.A); `verifiers/invsqrt/verify_submission_invsqrt.py` (Toffoli-like = CCX, CCZ, CSWAP)</sub>\"},{\"cell_type\":\"markdown\",\"id\":\"c11\",\"metadata\":{},\"source\":\"## 2. The inspector's dice\\n\\nA checker that always used the same test inputs could be gamed: tune a circuit until it passes those tests and fails\\nothers. The paper's answer is to hash the circuit file with SHA-256, mix in a secret salt, and use the result to seed\\nthe random test inputs (`qcc.txt:236-243`). Change one byte of the file and every test changes. Nobody, the\\nauthor included, picks the tests. On Kaggle the salt is secret and fixed, so each file meets one draw of tests, the\\nsame every time those bytes are scored.\\n\\nFigure 2 plants a mistake in the toy: it drops the phase fix after the HMR. The broken toy still gives the right\\nanswer bit; it fails only when both inputs are 1 and the measurement comes up 1, one shot in eight. Each line in the\\nfigure is the inspector with a different salt.\"},{\"cell_type\":\"code\",\"id\":\"c12\",\"metadata\":{\"_kg_hide-input\":true,\"jupyter\":{\"source_hidden\":true}},\"execution_count\":null,\"outputs\":[],\"source\":\"def caught_after(circuit, salt, max_shots=60):\\n    seed = int.from_bytes(hashlib.sha256(repr(circuit).encode() + salt.encode()).digest()[:8], 'big')\\n    rng = random.Random(seed)  # the tests are a function of the file's hash and the salt\\n    for shot in range(1, max_shots + 1):\\n        a, b = rng.getrandbits(1), rng.getrandbits(1)\\n        if not inspect_toy(circuit, a, b, lambda: rng.getrandbits(1)):\\n            return shot\\n    return None\\n\\n\\nsalts = [f'salt-{i}' for i in range(400)]\\ngood = [caught_after(TOY, s) for s in salts]\\nbad = [caught_after(TOY_BAD, s) for s in salts]\\nassert all(g is None for g in good)  # the correct toy passes every test under every salt\\nn = np.arange(1, 41)\\nshare = [np.mean([b_ is not None and b_ <= k for b_ in bad]) for k in n]\\nfig, ax = plt.subplots(figsize=(9.6, 3.8))\\nax.step(n, share, where='post', color=ACCENT, lw=2, label='broken toy: share of 400 salts that caught it')\\nax.plot(n, 1 - (7 / 8) ** n, color=INK, lw=1, ls='--', label='1 - (7/8)^shots')\\nax.axhline(0, color=SECOND, lw=2, label='correct toy: caught under no salt')\\nk50 = int(n[np.argmax(np.array(share) >= 0.5)])\\nlabel_point(ax, k50, share[k50 - 1], f'half caught by shot {k50}')\\nax.set_xlabel('shots (random test inputs)')\\nax.set_ylabel('share of salts that exposed the mistake')\\nax.set_ylim(-0.04, 1.04)\\nax.legend(loc='lower right')\\nax.set_title('Figure 2. Catching a planted mistake')\\nshow(fig, 'f2_planted_mistake.png', 'this notebook (inspect_toy, 400 salts, seeds from SHA-256 of the circuit text plus salt)')\"},{\"cell_type\":\"markdown\",\"id\":\"c13\",\"metadata\":{},\"source\":\"*Figure 2. The correct toy passes under every salt; the broken one is caught by most salts within a couple of dozen\\nshots. Real mistakes can hide in a far smaller corner of the inputs, which is why the real jobs run many more shots:*\\n\\n| job | shots in the hosts' reference run | what the inspector checks on each shot |\\n|---|---:|---|\\n| fusion | 200,540,928 | the phase against exact integer arithmetic for one input x |\\n| message repair | 102,400 | one damaged codeword: errors found, phases right |\\n| chemistry | 254,464 | the lookups and rotations against the factorization |\\n\\nWhere the picture breaks: the dice are deterministic. Given the file and the salt anyone can replay them, which is the\\npoint: once a salt is published, every score can be reproduced.\\n\\nThe same idea on a real file, live: one bit flipped in this run's fusion circuit gives a different SHA-256, so the\\nverifier would draw entirely new tests, and this notebook's pin check refuses the file before any verifier runs.\\n\\n<sub>sources: `data/qcc/doc/qcc.txt:236-243`; `data/qcc/runs/invsqrt/sample_invsqrt.verify.json`, `data/qcc/runs/sample_dqi.json`, `data/qcc/runs/sample_dfthcsos.json` (verified_shots)</sub>\"},{\"cell_type\":\"code\",\"id\":\"c14\",\"metadata\":{},\"execution_count\":null,\"outputs\":[],\"source\":\"data = bytearray((SUB / 'invsqrt.kmb').read_bytes())\\nprint('invsqrt.kmb as pinned  ', hashlib.sha256(data).hexdigest())\\ndata[len(data) // 2] ^= 1\\nprint('one bit flipped        ', hashlib.sha256(data).hexdigest())\\nplanted = SCRATCH / 'planted' / 'invsqrt.kmb'\\nplanted.parent.mkdir(parents=True, exist_ok=True)\\nplanted.write_bytes(data)\\ntry:\\n    assert sha256(planted) == PINS['invsqrt.kmb']['sha256'], 'the pin refuses the flipped file'\\n    print('GREEN: the check did not notice (this must not happen)')\\nexcept AssertionError as err:\\n    print('RED, as it should be:', err)\"},{\"cell_type\":\"markdown\",\"id\":\"c15\",\"metadata\":{},\"source\":\"## 3. The bill\\n\\nEach job's bill is written into its verifier:\\n\\n- **fusion**: seats x stamps, `Q x (Toffolis + T/4)`, where each fine rotation is priced as `0.56 log2(1/eps) + 5.3`\\n  T gates (`qcc.txt:538-543`);\\n- **message repair**: `R x Q^2 x T`. Seats count twice, so \\\"a 1% reduction in qubits improves the score as much as a 2%\\n  reduction in Toffoli gates\\\" (`qcc.txt:789-790`). R is a surcharge for failed checks (chapter 5);\\n- **chemistry**: `lambda_eff x T x Q`, where lambda_eff, the volume knob of chapter 6, measures how large the\\n  chemistry's coefficients are.\\n\\nThe score divides Google's reference bill by ours, job by job, and takes the geometric mean of the three ratios. The\\nmetric code says it in one line: \\\"the hosts' reference submissions score 1.0, and halving every benchmark's cost\\nscores 2.0\\\". So only percentages count: a 1% cut in any one bill lifts the score by 0.34%. What differs is how\\nmuch circuit a percent is. One qubit is 1.59% of the fusion bill at 63 seats, but only\\n0.22% of message repair at 889 seats (counted twice) and 0.23% of chemistry at\\n430 seats.\"},{\"cell_type\":\"code\",\"id\":\"c16\",\"metadata\":{\"_kg_hide-input\":true,\"jupyter\":{\"source_hidden\":true}},\"execution_count\":null,\"outputs\":[],\"source\":\"def gain(f, s):\\n    return s * (f ** (-1 / 3) - 1)  # the score is a geometric mean of three ratios\\n\\n\\nprice = [\\n    ('fusion: one seat less', gain((ri['num_qubits'] - 1) / ri['num_qubits'], SCORE)),\\n    ('fusion: 1% fewer stamps', gain(0.99, SCORE)),\\n    ('message repair: one seat less', gain(((rd['num_qubits'] - 1) / rd['num_qubits']) ** 2, SCORE)),\\n    ('message repair: 1% fewer stamps', gain(0.99, SCORE)),\\n    ('chemistry: one seat less', gain((rc['num_qubits'] - 1) / rc['num_qubits'], SCORE)),\\n    ('chemistry: 1% fewer stamps', gain(0.99, SCORE)),\\n]\\nfig, ax = plt.subplots(figsize=(9.6, 3.6))\\ny = np.arange(len(price))[::-1]\\nfor yi, (name, pts) in zip(y, price):\\n    seat = 'seat' in name\\n    ax.barh(yi, pts, height=0.6, color=ACCENT if seat else '#adb5bd')\\n    ax.text(pts + 0.002, yi, f'+{pts:.4f}', va='center', fontsize=10, color=ACCENT if seat else INK)\\nax.set_yticks(y, [p[0] for p in price])\\nax.grid(axis='y', visible=False)\\nax.set_xlim(0, max(p[1] for p in price) * 1.25)\\nax.set_xlabel(f'LB points gained, at this run\\\\'s score {SCORE:.5f}')\\nax.set_title('Figure 3. The price list: what one seat and 1% of the stamps are worth')\\nshow(fig, 'f3_price_list.png', \\\"this run's receipts (Q per job) and the geometric-mean formula of the hosts' metric code\\\")\"},{\"cell_type\":\"markdown\",\"id\":\"c17\",\"metadata\":{},\"source\":\"*Figure 3. A percent of stamps is worth the same in every job. A seat is not: in fusion one seat is\\n1.59% of the bill, more than a percent of stamps; in message repair and chemistry it is\\n0.22% and 0.23%, about a quarter of one.*\"},{\"cell_type\":\"markdown\",\"id\":\"c18\",\"metadata\":{},\"source\":\"## 4. Job 1, fusion: 1/sqrt(x) on an abacus\\n\\nThe first job gives each input x a phase proportional to 1/sqrt(x). The paper calls this the bottleneck of\\nsimulating how charged particles push on each other, and ties that simulation to the design of inertial confinement fusion devices\\n(`qcc.txt:13-15`, `qcc.txt:279-289`). The circuit works like an abacus: it never writes 1/sqrt(x) down as a\\nnumber; it walks x through additions and table lookups, turns the answer into a phase, and then undoes its scratch\\nwork so the seats come back empty.\\n\\nFigure 4 is a relay. Google's reference used 260 seats and 7,987.6 stamps per shot. Dmitrii\\nGluzdov's public circuit reached 84 seats, Phuc Thai's EXP222 took the line to 82, we took EXP222\\nto 78 in gate-level steps, each verified in full before the next, and mrmeows took our 78-seat file down to\\n63 seats, then cut its stamps from 1,723.2 to 1,643.6 per shot at the same seats. Of\\nthe 14 top public notebook texts we harvested on 2026-10-27, 8 name busyaprime:\\n7 in their credits for this line and 1 in a line for shared foundations\\n(every context read and logged in our work log).\\n\\n**Our two steps on his newer file.** Most of its stamps go into lookups. The main one is a table that turns an\\n8-bit address into 35 output bits, built from 186 AND gates in\\na pool of 40 wires. Step 1 (our V7 and V8) rebuilt that table with 172 AND gates in the\\nsame pool, with the same output wires and the same tables: stamps per shot fell from 1,643.6 to\\n1,629.6 at the same 63 seats, the fusion bill by -0.852%. Step 2, since our V9,\\nrebuilds window S1, six product blocks that each feed one wire: 25 AND gates in\\nplace of 30, the same tables on the same wires, everything outside the window byte for byte the\\nsame. Stamps per shot fall to 1,624.6, and the fusion bill from 102,664.21 to\\n102,349.22 (-0.307%; -1.156% for both steps). Every run of the new file passed:\\nour verifier unsalted and on five fresh salts, the official x86-64 runs on two salts, and the hosts' metric code\\n(10 runs, cost 102,349.21 to 102,349.25). Before the full runs, an exact check of the window\\nover all its addresses had to pass, and four planted defects had to fail it. The step is small: on\\nthese bytes it is x1.0010248 on the score, +0.023411.\\n\\nBoth files went public in our dataset, step 1 in version 4 and step 2 in version 5 (at 00:01 UTC on\\n2026-10-29), and the public outputs took them. Of the public outputs our field watcher harvested from runs of\\n2026-10-28 up to 20:52 UTC, 23 of 24 carry step 1's file byte for byte, heliosli's, the\\nSomeJoint team's and avazaku's among them (the SomeJoint team's output names it \\\"busyaprime's lookup in mrmeows' 63-qubit circuit\\\"). Of those from\\nruns of 2026-10-29 up to 16:23 UTC, 23 of 26 carry step 2's file and the\\nother 3 step 1's: every one carries one of the two. The first with step 2 was\\nkirilltym's, run at 01:05 UTC, 64 minutes after our dataset version;\\nthis zip takes the file from that output, byte-equal to ours.\\n\\nWhere the picture breaks: an abacus handles one number at a time; the quantum machine would run every x at once. The\\ninspector checks one x per shot.\"},{\"cell_type\":\"code\",\"id\":\"c19\",\"metadata\":{\"_kg_hide-input\":true,\"jupyter\":{\"source_hidden\":true}},\"execution_count\":null,\"outputs\":[],\"source\":\"relay = REC['relay']\\nfig, ax = plt.subplots(figsize=(10.2, 4.8))\\nqs = np.linspace(60, 87, 200)\\nfor p in (relay[0], relay[5], relay[-1]):\\n    ax.plot(qs, p['cost'] / qs, color=GRID, lw=1.2, zorder=0)\\ncolors = {'busyaprime': ACCENT, 'mrmeows': '#495057', 'Phuc Thai': '#495057', 'Dmitrii Gluzdov': '#495057'}\\nax.plot([p['q'] for p in relay], [p['c'] for p in relay], color='#ced4da', lw=1, zorder=1)\\nfor p in relay:\\n    ax.scatter(p['q'], p['c'], s=70 if p['who'] == 'busyaprime' else 45, color=colors[p['who']], zorder=3)\\ndone = set()\\nfor p in relay:\\n    if p['who'] not in done:\\n        ax.annotate(p['who'], (p['q'], p['c']), xytext=(4, 9), textcoords='offset points', fontsize=10,\\n                    color=colors[p['who']], fontweight='semibold' if p['who'] == 'busyaprime' else 'normal')\\n        done.add(p['who'])\\nend = relay[-1]\\nax.annotate(f\\\"{end['q']} seats, in this zip ({ratio['invsqrt']:.2f}x)\\\", (end['q'], end['c']), xytext=(10, -10),\\n            textcoords='offset points', fontsize=10, fontweight='semibold', color=INK, va='center')\\nsame_q = [p for p in relay[:-1] if p['q'] == end['q'] and p['label'] != f\\\"{end['q']} Q\\\"]  # earlier files at these seats\\nfor p in same_q:  # mrmeows' newer file, and our first lookup on it\\n    txt = 'our first lookup' if p['who'] == end['who'] else p['who'] + (\\\"'\\\" if p['who'].endswith('s') else \\\"'s\\\") + ' newer file'\\n    ax.annotate(txt, (p['q'], p['c']), xytext=(10, 4), textcoords='offset points', fontsize=9, color=colors[p['who']],\\n                va='center')\\nax.set_xlim(87, 60)\\nax.set_ylim(min(p['c'] for p in relay) - 45, max(p['c'] for p in relay) + 70)\\nax.set_xlabel('seats (qubits), fewer to the right')\\nax.set_ylabel('stamps per shot (Toffoli-equivalents)')\\nax.set_title(f\\\"Figure 4. The relay: {relay[0]['q']} to {end['q']} seats, {len({p['who'] for p in relay})} authors, \\\"\\n             \\\"one public line\\\")\\nshow(fig, 'f4_relay.png', 'data/qcc/circuits/invsqrt_*.verify.json and data/qcc/scout/regen/exp222/verify.json '\\n     \\\"(our full verifier runs of each file); the file in this zip: our hosts'-metric runs of its bytes; \\\"\\n     'grey curves: equal cost Q x C')\"},{\"cell_type\":\"markdown\",\"id\":\"c20\",\"metadata\":{},\"source\":\"*Figure 4. Moving right removes seats, moving down removes stamps, and the grey curves are equal cost. Every point is\\na file we ran through the full verifier or the hosts' metric code ourselves. The last two steps, at the same seats,\\nare our two rebuilds of mrmeows' newer file.*\"},{\"cell_type\":\"markdown\",\"id\":\"c21\",\"metadata\":{},\"source\":\"## 5. Job 2, repairing typos without reading the message\\n\\nThe second job sits inside DQI (decoded quantum interferometry): a decoder for the Reed-Solomon code RS(4095, 4025)\\nover GF(2^12). In everyday terms: a message of letters with check letters appended; some letters arrive damaged; the\\ndecoder finds and fixes them. The quantum version must do it without \\\"reading\\\" the message, so every step has to be\\nreversible and every scratch seat returned empty.\\n\\nThis job has a surcharge. The inspector runs the decoder on 102,400 random damaged codewords. A failed shot\\nis allowed, but it is priced: R is the cost of repeating the whole computation often enough to be safe, from a\\none-sided Clopper-Pearson bound at confidence `1 - 2^-128`. Even with no failure R is 1.19126, because a sample can\\nnever prove the failure rate is zero; one failure makes it 1.19673, two make it 1.20139 (Figure 5). The\\ndecoder in this zip had k = 1 failed shots under the Public salt of our hosts'-metric run;\\nour verifier's unsalted run of the same file (the watcher's price) and hengck23's own receipt met k = 1; the hosts' metric code met k = 1 on our Public salt and k = 1 on our Private salt; kirilltym's run on his salt \\\"oct29-round9-independent\\\" met k = 0. The two unsalted runs draw the same shots, so these are four draws, and three of them meet\\none failure. On the hosts' secret Public salt this file met k = 1 too: kirilltym's LB, 22.85529, holds this\\ndecoder with our fusion file and the chemistry before our refit, and fits k = 1 and no other k (chapter 7).\"},{\"cell_type\":\"code\",\"id\":\"c22\",\"metadata\":{\"_kg_hide-input\":true,\"jupyter\":{\"source_hidden\":true}},\"execution_count\":null,\"outputs\":[],\"source\":\"sys.path += [KICKMIX_DIR, VERIFIERS_DIR]\\nfrom dqi import verify_submission_dqi as vdqi\\n\\nn_shots = REC['ref']['dqi']['shots']\\nks = np.arange(0, 7)\\nrk = [vdqi.repetition_overhead(vdqi.clopper_pearson_upper_bound(int(k), n_shots)) for k in ks]\\nassert all(abs(a - REC['rk'][str(k)]) < 1e-12 for k, a in zip(ks, rk))  # the same R(k) as at build time\\ncounts = [REC['member_ks'].count(int(k)) for k in ks]\\nfig, ax = plt.subplots(figsize=(9.6, 3.8))\\nax.bar(ks, rk, width=0.6, color=['#adb5bd'] * len(ks))\\nax.bar([k_run], [rk[k_run]], width=0.6, color=ACCENT)\\nfor k, r_, c_ in zip(ks, rk, counts):\\n    ax.text(k, r_ + 0.0012, f'{r_:.5f}' + (f'\\\\n{c_} of {len(REC[\\\"member_ks\\\"])} runs' if c_ else ''), ha='center',\\n            va='bottom', fontsize=8.5, color=INK)\\nax.set_ylim(min(rk) - 0.01, max(rk) + 0.012)\\nax.set_xticks(ks)\\nax.set_xlabel(f'failed shots k, out of {n_shots:,}')\\nax.set_ylabel('surcharge R(k)')\\nax.set_title(f'Figure 5. The price of a mistake: this run failed {k_run} (orange)')\\nshow(fig, 'f5_price_of_a_mistake.png', 'repetition_overhead and clopper_pearson_upper_bound imported live from '\\n     \\\"verifiers/dqi/verify_submission_dqi.py; run counts: the recorded runs of this file, \\\" + REC['dqi_src'])\"},{\"cell_type\":\"markdown\",\"id\":\"c23\",\"metadata\":{},\"source\":\"*Figure 5. R(0) is the reference decoder's own surcharge. Each failure adds about half a percent to the bill. The\\nleaderboard's secret salt draws its own number of failures for each file; for this one it drew k = 1\\n(chapter 7).*\\n\\nThe decoder's diet (Figure 6): seats against stamps for every decoder we verified. Our own line runs from q919 to R18,\\nat 31.69x on average, the message repair of our 17.53289 entry. The file in this zip is not ours: it is\\nhengck23's 889-seat decoder (his `dqi_iter014` build: projective extraction, rolling continuants, a\\none-product tail and the SomeJoint team's stream converter, as his notebook lists them), as kirilltym's output carries\\nit. It runs 433,784.89 stamps per shot at 889 seats (our verifier, unsalted, equal to his own\\nreceipt; 433,785 as the mean of our three runs), against 437,947.61 for the SomeJoint team's\\n889-seat file of the same day, 440,563.96 for heliosli's 889-seat narrowing in our V9\\nand V10, 440,633.00 for the SomeJoint team's earlier 897-seat file of our V8, 467,789.65 for\\ntheir 883-seat decoder in our V7 and 482,543 for Ahmed Berat Ozer's 877-seat\\nnarrowing in our V6. The same seats as the SomeJoint team's file with 4,163 fewer stamps: a bill\\n-0.951% against theirs at equal k, more than the 0.46% one failed shot adds. So it stays\\ncheaper where it meets one failure more than theirs, as on the hosts' Public salt (k = 1 against 0, chapter 7):\\n-0.496%, x1.0016575 on the score. hengck23 states that the file drops some guards in rare low-weight\\nbranches and fails on parts of a uniform weight sweep; the verifier prices every failure it meets. We use it\\nunchanged; kirilltym's public output is where our field watcher found it.\"},{\"cell_type\":\"code\",\"id\":\"c24\",\"metadata\":{\"_kg_hide-input\":true,\"jupyter\":{\"source_hidden\":true}},\"execution_count\":null,\"outputs\":[],\"source\":\"pts = REC['dqi_points']\\nfig, ax = plt.subplots(figsize=(10.2, 4.8))\\nqq = np.linspace(855, 940, 200)\\nfor cost in (4.4e11, 6.0e11, 8.0e11, 1.1e12):\\n    ax.plot(qq, cost / (REC['rk']['0'] * qq ** 2) / 1e3, color=GRID, lw=1.1, zorder=0)\\n    ax.text(858, cost / (REC['rk']['0'] * 858 ** 2) / 1e3, f'{cost:.1e}', fontsize=8, color=MUTED, ha='right', va='bottom')\\npub = [p for p in pts if not p['ours']]\\nours = [p for p in pts if p['ours']]\\nOFFSET = {'q919': (6, 4), 'sigma pair': (6, 5), 'v7': (6, 6), 'R5-A': (-44, 8), 'R12': (8, 0),\\n          'R18': (8, -12), 'SomeJoint gap': (6, -12), 'ViberTeam 881': (6, 5), 'DePie EXP-250a': (6, -13),\\n          'Ahmed V6': (-62, -12), 'mrmeows Q870': (8, 2), 'Ahmed V9 877 Q': (8, -4), 'SomeJoint 883 Q': (-10, 10),\\n          'SomeJoint 897 Q': (-60, 22), 'heliosli 889 Q': (6, -13), 'SomeJoint 897 Q, 10-29': (-118, 8),\\n          'Mudit 895 Q': (-10, 12), 'SomeJoint 889 Q, 10-29': (10, 6), 'hengck23 889 Q': (-205, -14)}\\nax.scatter([p['q'] for p in pub], [p['t'] / 1e3 for p in pub], s=40, color='#868e96', zorder=2)\\nzp = next(p for p in pts if p.get('in_zip'))\\nax.scatter([zp['q']], [zp['t'] / 1e3], s=150, facecolors='none', edgecolors=INK, lw=1.8, zorder=4)\\nax.plot([p['q'] for p in ours], [p['t'] / 1e3 for p in ours], '-o', color=ACCENT, ms=5, lw=1.4, zorder=3)\\nfor p in pts:\\n    if p['label'] in OFFSET:\\n        text = p['label'] + (f\\\", in this zip ({ratio['dqi']:.2f}x)\\\" if p.get('in_zip') else '')\\n        text += f\\\", ours, best ({REC['own_hist']['dqi']:.2f}x)\\\" if p['label'] == 'R18' else ''\\n        ax.annotate(text, (p['q'], p['t'] / 1e3), xytext=OFFSET[p['label']], textcoords='offset points', fontsize=8.5,\\n                    color=ACCENT if p['ours'] else (INK if p.get('in_zip') else '#868e96'),\\n                    fontweight='semibold' if p['label'] == 'R18' or p.get('in_zip') else 'normal')\\nref_ = REC['ref']['dqi']\\nax.text(0.99, 0.97, f\\\"Google's reference, far off this chart: {ref_['q']:,} seats, {ref_['t'] / 1e3:,.0f}k stamps\\\",\\n        transform=ax.transAxes, ha='right', va='top', fontsize=9, color=INK)\\nax.set_xlim(940, 855)\\nax.set_ylim(min(p['t'] for p in pts) / 1e3 - 60, max(p['t'] for p in pts) / 1e3 + 80)\\nax.set_xlabel('seats (qubits), fewer to the right')\\nax.set_ylabel('stamps per shot, thousands (mean)')\\nax.set_title(\\\"Figure 6. The decoder's diet: our line (orange), public files we verified (grey), this zip (circled)\\\")\\nshow(fig, 'f6_decoder_diet.png', 'data/qcc/circuits/dqi_*.json, data/qcc/work/dqi/r24/kernel/prof1/output/r24/verify_salt*.json '\\n     '(every run of each file) and, for this zip, ' + REC['dqi_src'] + '; grey curves: equal cost R(0) x Q^2 x T')\"},{\"cell_type\":\"markdown\",\"id\":\"c25\",\"metadata\":{},\"source\":\"## 6. Job 3, the chemistry jukebox\\n\\nThe third job is a step in simulating `FeMoCo76o113e`, the FeMoCo molecule, the paper's chemistry benchmark. The\\ncircuit is a jukebox: a lookup table (QROM) picks a set of rotation angles by address, and the circuit turns its dials\\nby those angles. Stamps go into the lookups; seats into the address and angle registers. lambda_eff is the volume\\nknob: the size of the factorized Hamiltonian's coefficients, and the bill multiplies by it. The\\ntaste test is accuracy: two error measures must each stay under 20 mHa, or the file fails.\\n\\nThe chemistry in this zip plays at volume 48.48 against Google's 49.30, with\\n16,270 stamps against 93,237 and 430 seats against 730 (Figure 7,\\nfrom this run's receipt). Its 15 lookup circuits are Atakan Aldemir's, as Ahmed Berat Ozer's public\\noutput of 16:06 UTC carries them (byte-equal to kirilltym's of 14:08 UTC): Atakan Aldemir's notebook \\\"rebuilds both DQI and all fifteen chemistry loaders from\\nsources\\\", with two AND reductions he credits to heliosli and one to Dmitrii Gluzdov; 16,270 stamps against\\n16,274 in Dmitrii Gluzdov's circuits of 12:58 UTC and 16,276 in those of our sub_023 (none of the\\nfifteen files byte-equal to either). Its weights file is ours: Ahmed Berat Ozer's V14 weights, with two arrays refit\\nby us. His chemistry was the cheapest public one our field watcher had priced at 16:23 UTC; ours moves\\nits bill by -0.00076%. The first two pieces below are ours from 2026-10-27, not in this zip; the next four are the public\\nchemistry of our V9 and V10, of our sub_022, Ahmed Berat Ozer's and our refit of it in sub_023; then Dmitrii\\nGluzdov's and Atakan Aldemir's; the last is ours, in this zip.\\n\\nWhere the picture breaks: a jukebox plays one song; the quantum lookup plays every address at once. The inspector\\nchecks addresses one at a time.\"},{\"cell_type\":\"code\",\"id\":\"c26\",\"metadata\":{\"_kg_hide-input\":true,\"jupyter\":{\"source_hidden\":true}},\"execution_count\":null,\"outputs\":[],\"source\":\"parts = [('volume, lambda_eff', ref['dfthcsos']['lam'], rc['lambda_eff']),\\n         ('stamps, T', ref['dfthcsos']['t'], rc['toffoli_count']),\\n         ('seats, Q', ref['dfthcsos']['q'], rc['num_qubits'])]\\nfig, axes = plt.subplots(1, 3, figsize=(10.4, 3.0))\\nfor ax, (name, g, o) in zip(axes, parts):\\n    ax.bar([0, 1], [g, o], color=['#adb5bd', ACCENT], width=0.6)\\n    ax.set_xticks([0, 1], ['Google', 'ours'])\\n    ax.set_title(f'{name}: {g / o:.2f}x', fontsize=11)\\n    for x_, v in ((0, g), (1, o)):\\n        ax.text(x_, v, f'{v:,.2f}' if v < 100 else f'{v:,.0f}', ha='center', va='bottom', fontsize=9.5)\\n    ax.grid(axis='x', visible=False)\\n    ax.set_ylim(0, g * 1.18)\\nfig.suptitle(f\\\"Figure 7. The chemistry bill, factor by factor: {ratio['dfthcsos']:.2f}x in all\\\", x=0.0, ha='left',\\n             fontsize=12.5, fontweight='semibold')\\nfig.tight_layout()\\nshow(fig, 'f7_chemistry_bill.png', \\\"/kaggle/working/receipts/dfthcsos.json (this run); data/qcc/runs/sample_dfthcsos.json\\\")\"},{\"cell_type\":\"markdown\",\"id\":\"c27\",\"metadata\":{},\"source\":\"**Ours, 1: the weights (2026-10-27, not in this zip).** The circuits store the angle words of the factorization: the\\njukebox's records. The weights that mix those records into the chemistry's coefficients sit in a separate file,\\n`submission.npz`, which the verifier reads directly. With the words fixed, the circuits and their stamps stay byte for\\nbyte the same, and only the weights move. Ahmed Berat Ozer's V9 lambda loop already ran \\\"three rounds of joint refit,\\ncolumn gauge and offset optimization\\\" (his page), and his file left its first error at 14.658 mHa, well\\nunder the 20 mHa limit. Ours spent that slack on a lower volume knob: three rounds of our refit took lambda_eff from\\n47.553336 to 47.537177, and a rotation of the weight columns that keeps both errors fixed (a\\nGram-preserving gauge, alex chilton's idea) took it to 47.537037. We published this file with our notebook on\\n2026-10-27; the 22.00949 zip of SomeJoint's and manwithacat's notebooks carries it byte for byte (chapter 8).\\nThe words have changed since: the SomeJoint team's newer factorization plays at a higher volume, 48.764252, with\\nfar fewer stamps, and its bill is lower.\\n\\n**Ours, 2: the loader (not in this zip).** Each circuit loads its angle words through products of address bits, and\\neach product costs an AND gate. A GF(2) relation among the products lets the circuit get one product from others for\\nfree, so more relations mean fewer AND gates. heliosli published the method, a searched relation layout with an exact GF(2) check (his notebook text; his code is not public); our own implementation of it found plans with more relations for Ahmed Berat Ozer's unchanged words. On Ahmed Berat Ozer's words our plans took the\\nloader from 4,812 to 4,758 Toffolis per pass, the stamps from 17,330 to 17,222\\n(-0.6232% on the chemistry bill), and our V7 carried it. On 2026-10-28 we ran the same method on four public\\nchemistries of the day, words and weights fixed, each result confirmed by an independent critic run. Our bills:\\n343,495,564.58 on the SomeJoint team's earlier full-XOR chemistry (-0.4719% on it), 343,004,823.75 on their\\nnewer one (-0.0489%), 343,185,269.44 on atakanaldemir's (-0.0850%), and 347,396,756.91 on\\nnilanjansaha123's with our weights (-0.0888%). Each was beaten in public the same day. Two longer routes closed on their own kill\\ngates the same day: the chemistry at seven rotation bits instead of eight (its grouped shapes missed the accuracy\\ngate) and a narrower message-repair decoder (its census gate failed).\\n\\n**heliosli's circuits of 2026-10-28, our V9 and V10.** His circuits loaded the SomeJoint team's newer words at\\n4,188 loader Toffolis per pass, against 4,218 in their own circuits and 4,214 in ours:\\n16,306 stamps, 60 fewer than theirs, at the same volume 48.764252 and the same two errors, a\\nchemistry bill -0.3666% against theirs and -0.3179% against our plans on their circuits. avazaku's\\nweights file for those words (run 19:24 UTC; column gauges and proximal steps on the offsets, his arm\\n\\\"Alternating continuation\\\") spent the first error's slack, as our weights did on 2026-10-27: volume 48.759460 against\\n48.764252, a chemistry bill -0.0098% against heliosli's zip. Our V9 and V10 carried both.\\n\\n**heliosli's circuits of 2026-10-29 01:08 UTC, our sub_022.** His circuits of that night load the same words with\\nthe weights his notebook credits to Dmitrii Gluzdov (\\\"The table weights (W, H2_I) are Dmitrii Gluzdov's, byte for\\nbyte\\\"): a chemistry bill of 340,571,920.80. Our sub_022 carried them whole and scored 22.79257.\\n\\n**Ahmed Berat Ozer's weights of 2026-10-29, our sub_023.** At 09:43 UTC his notebook wrote heliosli's newer circuits,\\n16,276 stamps, with his own update of Dmitrii Gluzdov's weights: volume 48.589757, a chemistry bill of\\n340,064,159.36. Our refit of his weights, the same lever as below, took the volume to 48.588373 and the\\nbill to 340,054,472.90; our sub_023 carried it and scored 22.80413.\\n\\n**Dmitrii Gluzdov's chemistry of 2026-10-29 12:58 UTC.** His notebook regenerated the fifteen circuits with the\\nproducts paired again, 16,274 stamps, with a last weights stage started from Ahmed Berat Ozer's public weights:\\nvolume 48.572747, a chemistry bill of 339,903,340.03. Our refit of his weights, the same lever as below, held\\nin its own critic check at 339,892,698.58; the chemistry below is cheaper than both, so neither is in this zip.\\n\\n**Atakan Aldemir's chemistry, kirilltym's output of 2026-10-29 14:08 UTC.** Atakan Aldemir's notebook\\nco-designs the angle words and the factor with his compiler and emits the fifteen loaders natively, 16,270\\nstamps at 4,170 loader Toffolis per pass (against 4,172 in Dmitrii Gluzdov's). kirilltym's\\nnotebook took his archive (`df8490c7...`) with hengck23's decoder and checked the chemistry afresh. Its\\nfile leaves error_1 at 19.9997 mHa and error_2 at 19.9997, volume 48.559638, a chemistry bill of\\n339,728,082.34, -0.0516% against Dmitrii Gluzdov's and -0.0960% against our sub_023's.\\nkirilltym's team reads 22.85529 from a submission at 14:13 UTC, after this run; his log prints\\n22.89023131 on his own salt.\\n\\n**Ahmed Berat Ozer's V14 weights, his output of 2026-10-29 16:06 UTC.** His text: \\\"The pinned public Atakan\\nfactor plus our selected delta reproduces W/H2_I and derived offset_W on CPU. Six other arrays are byte-identical to\\nthat public factor.\\\" The circuits stay Atakan Aldemir's, byte for byte; his weights leave error_1 at 19.9994\\nmHa and error_2 at 19.9992, volume 48.476421, a chemistry bill of 339,145,888.78, -0.1714%\\nagainst Atakan Aldemir's own weights. These files before our refit read 22.86836 by arithmetic at the\\ndecoder's k = 1 (22.90332 at k = 0); his text says \\\"Local score is not LB.\\\"\\n\\n**Ours, 3: the refit of Ahmed Berat Ozer's V14 weights (in this zip).** The lever of our weights of 2026-10-27 and of\\nour sub_023, on this file. With the words fixed, the circuits and their stamps stay byte for byte; W and H2_I are\\nrefit under both error limits, then a column gauge lowers the volume at fixed errors, and the other arrays stay byte\\nfor byte. His errors left 5.90e-07 and 7.54e-07 Ha of slack; ours sit at 19.9997\\nand 19.9998 mHa, the volume at 48.476051 against his 48.476421, the chemistry bill at\\n339,143,297.03664792 against 339,145,888.78 (-0.00076%, -2,591.74, x1.0000025 on the\\nscore). A file this close to the limits must not pass by a rounding accident, so each of the three accuracy checks\\npasses with at least 2.1e-07 Ha to spare (error_1 3.11e-07, error_2 2.10e-07, the\\nenergy gap 7.44e-06 Ha). The official verifier on x86-64, the hosts' platform, gives\\n339,143,297.0366480, one unit in the last place above our Mac runs (relative 1.76e-16), unsalted and on\\nfresh salts of ours and of an independent critic, who also planted a copy just past the energy-gap limit and two\\nbroken circuits and saw each fail. A small step, and the only chemistry in this zip that is ours.\\n\\n| chemistry member | circuits | lambda_eff | error_1, mHa | error_2, mHa | stamps | chemistry cost | this zip against it |\\n|---|---|---:|---:|---:|---:|---:|---:|\\n| Ahmed Berat Ozer, V9 | his | 47.553336 | 14.65804 | 19.99779 | 17,330 | 355,186,805.37 | -4.5169% |\\n| evgendvorkin, refined weights | Ahmed Berat Ozer's | 47.552363 | 14.65630 | 19.99779 | 17,330 | 355,179,539.02 | -4.5150% |\\n| busyaprime weights (in the 22.00949 zip) | Ahmed Berat Ozer's | 47.537037 | 19.99925 | 19.99950 | 17,330 | 355,065,066.08 | -4.4842% |\\n| busyaprime weights and loader (our V7, LB 22.11838) | ours, by Ahmed Berat Ozer's compiler | 47.537037 | 19.99925 | 19.99950 | 17,222 | 352,852,312.06 | -3.8852% |\\n| heliosli, in our V8 zip | his J5 build of Ahmed Berat Ozer's V9 words | 47.494022 | 19.99900 | 19.99893 | 17,066 | 349,339,717.33 | -2.9188% |\\n| the SomeJoint team, R8 B143 C60 full-XOR | theirs | 48.764252 | 15.82999 | 19.99881 | 16,366 | 343,172,572.78 | -1.1741% |\\n| busyaprime loader relations on their circuits (2026-10-28) | the SomeJoint team's words, our plans | 48.764252 | 15.82999 | 19.99881 | 16,358 | 343,004,823.75 | -1.1258% |\\n| heliosli, his zip (weights: the SomeJoint team's) | his plans for the SomeJoint team's words | 48.764252 | 15.82999 | 19.99881 | 16,306 | 341,914,455.08 | -0.8105% |\\n| avazaku's weights, our V9 and V10 zip | heliosli's plans of 2026-10-28 | 48.759460 | 19.99950 | 19.99881 | 16,306 | 341,880,855.44 | -0.8007% |\\n| heliosli, our sub_022 (weights: Dmitrii Gluzdov's) | his circuits of 2026-10-29 01:08 UTC for the SomeJoint team's words | 48.632428 | 19.99760 | 19.99760 | 16,286 | 340,571,920.80 | -0.4195% |\\n| Ahmed Berat Ozer, 2026-10-29 (his update of Dmitrii Gluzdov's weights) | heliosli's newer circuits (his v31_mc14 release) | 48.589757 | 19.26611 | 19.99943 | 16,276 | 340,064,159.36 | -0.2708% |\\n| busyaprime refit of Ahmed Berat Ozer's weights, our sub_023 | heliosli's newer circuits, as his output carries them | 48.588373 | 19.99979 | 19.99980 | 16,276 | 340,054,472.90 | -0.2679% |\\n| Dmitrii Gluzdov, 2026-10-29 12:58 UTC | his re-paired circuits for the SomeJoint team's words | 48.572747 | 19.99917 | 19.99901 | 16,274 | 339,903,340.03 | -0.2236% |\\n| Atakan Aldemir, 2026-10-29 (kirilltym's output of 14:08 UTC) | his natively emitted circuits | 48.559638 | 19.99966 | 19.99968 | 16,270 | 339,728,082.34 | -0.1721% |\\n| Ahmed Berat Ozer, V14, 2026-10-29 16:06 UTC (his update of Atakan Aldemir's weights) | Atakan Aldemir's circuits, as his output carries them | 48.476421 | 19.99941 | 19.99925 | 16,270 | 339,145,888.78 | -0.0008% |\\n| **busyaprime refit of Ahmed Berat Ozer's V14 weights, this zip** | Atakan Aldemir's circuits, as Ahmed Berat Ozer's output carries them | **48.476051** | 19.99969 | 19.99979 | **16,270** | **339,143,297.04** |  |\\n\\nEach row is our run of the official verifier on that member (all but the first two on x86-64, the hosts' platform).\\nThe first five rows run at 431 seats, the last ten at 430. This zip's chemistry cost is the same in\\nall 7 runs we made of it, the hosts' metric splits included, to one unit in the last place (the\\nx86-64 runs read one ulp above the Mac runs): the chemistry bill does not depend on the salt.\\n\\n<sub>sources: `data/qcc/work/dfthcsos/r39a/official/cand_unsalted.json`, `cand_s1.json` (this zip's chemistry, x86-64, unsalted and salt s1) and `his_unsalted.json` (Ahmed Berat Ozer's V14, x86-64), the critic's `data/qcc/work/critic/R39/official/` (M_*.json, B_*.json), critic report `competitions/33_qcc/critic/33_CRITIC_R39.md`, the member's provenance `data/qcc/circuits/dfthcsos_r39_A.provenance.json` (margins, refit chain, field equality); Atakan Aldemir's weights on our verifier `data/qcc/work/dfthcsos/r37a/official/his_unsalted.json`; Ahmed Berat Ozer's on ours `data/qcc/work/dfthcsos/r39a/his_unsalted/unsalted.json`; the other rows: build.py `SYNTH` chem_more</sub>\"},{\"cell_type\":\"code\",\"id\":\"c28\",\"metadata\":{\"_kg_hide-input\":true,\"jupyter\":{\"source_hidden\":true}},\"execution_count\":null,\"outputs\":[],\"source\":\"c3 = REC['chem3']\\nn3 = len(c3)\\nfig, (ax, ax2) = plt.subplots(1, 2, figsize=(10.4, 0.8 + 0.6 * n3))\\nnames = [c['who'] for c in c3]\\ncols = [INK if c.get('in_zip') else (ACCENT if c.get('ours') else '#adb5bd') for c in c3]\\nlam_live = R['dfthcsos']['lambda_eff']\\nassert abs(lam_live - c3[-1]['lam']) < 1e-12  # this run's verifier reads the same volume as our record\\nassert R['dfthcsos']['toffoli_count'] == c3[-1]['t']  # and the same stamps\\nax.barh(range(n3), [c['lam'] for c in c3], color=cols, height=0.6)\\nfor i, c in enumerate(c3):\\n    ax.text(c['lam'] + 0.0008, i, f\\\"{c['lam']:.6f}\\\", va='center', fontsize=9.5)\\nlam_lo, lam_hi = min(c['lam'] for c in c3), max(c['lam'] for c in c3)\\nax.set_xlim(lam_lo - 0.08 * (lam_hi - lam_lo) - 0.01, lam_hi + 0.35 * (lam_hi - lam_lo) + 0.012)  # room for the labels\\nax.set_yticks(range(n3), names)\\nax.invert_yaxis()\\nax.grid(axis='y', visible=False)\\nax.set_title('volume knob, lambda_eff', fontsize=11)\\nbase = c3[0]['cost']\\nds = [100 * (c['cost'] / base - 1) for c in c3]\\nax2.barh(range(n3), ds, color=cols, height=0.6)\\nspan = max(abs(min(ds)), 0.01)\\nfor i, (c, d) in enumerate(zip(c3, ds)):\\n    ax2.text(d - 0.012 * span if d < 0 else d + 0.012 * span, i, f'{d:+.4f}%  ({c[\\\"t\\\"]:,.0f} stamps)', va='center',\\n             ha='right' if d < 0 else 'left', fontsize=9.5)\\nax2.set_yticks(range(n3), [''] * n3)\\nax2.invert_yaxis()\\nax2.axvline(0, color=MUTED, lw=0.8)\\nax2.set_xlim(-3.4 * span, 0.5 * span)\\nax2.grid(axis='y', visible=False)\\nax2.set_title(\\\"chemistry cost against Ahmed Berat Ozer's V9\\\", fontsize=11)\\nfig.suptitle(f'Figure 7b. {n3} chemistry members: ours (orange), others (grey), this zip (dark)', x=0.0, ha='left',\\n             fontsize=12.5, fontweight='semibold')\\nfig.tight_layout()\\nshow(fig, 'f7b_three_weights.png', 'our verifier runs of each weights file (sources above); this run: /kaggle/working/receipts/dfthcsos.json')\"},{\"cell_type\":\"markdown\",\"id\":\"c29\",\"metadata\":{},\"source\":\"## 7. What we built\\n\\n| job | our circuit or file | what we changed | ratio | in this zip |\\n|---|---|---|---:|---|\\n| fusion | window S1 of mrmeows' 63-seat file (step 2) | 25 AND gates in place of 30 on top of step 1, the rest of the file unchanged (chapter 4) | 20.29 | **yes**; also in 23 of 26 public outputs of 2026-10-29 up to 16:23 UTC |\\n| chemistry | weights at fixed words on Ahmed Berat Ozer's V14 file, as his output of 2026-10-29 16:06 UTC carries it | a refit of W and H2_I plus a column gauge; Atakan Aldemir's circuits and the other arrays unchanged (chapter 6) | 9.89 | **yes**: -0.00076% on his chemistry bill |\\n| chemistry | weights at fixed words on Ahmed Berat Ozer's file of 2026-10-29 09:43 UTC | the same lever on his file (chapter 6) | 9.87 | no: in our sub_023 (LB 22.80413) |\\n| fusion | the main lookup of the same file (step 1) | 172 AND gates in place of 186 (chapter 4) | 20.23 | under step 2; alone in our V7 and V8 and in 23 of 24 public outputs of 2026-10-28 up to 20:52 UTC |\\n| chemistry | loader plans on the SomeJoint team's circuits | more product relations at their words and weights (chapter 6) | 9.78 | no: Atakan Aldemir's circuits are here, 9.89x |\\n| chemistry | loader plans on Ahmed Berat Ozer's circuits | more product relations in his J5 loader (heliosli's method, our implementation), circuits emitted by his compiler (chapter 6) | 9.51 with our weights | no: in our V7 (LB 22.11838) |\\n| chemistry | weights at fixed words on his V9 file | a refit of his V9 weights plus a column gauge (chapter 6) | 9.45 on his circuits | no: in the 22.00949 zip and our V7 |\\n| message repair | R18 | mrmeows' round17 Q870 chain, run unchanged, plus three patch modules of ours, among them one merged gap rotation per two-slot pair and controlled adds merged by linearity | 31.69 | no: hengck23's 889-seat file is 59.57x on our Public salt |\\n| chemistry | R16-C48 circuits | our capped, lambda-aware PQ compensator on Michael Rustad's public chain, and our own lookup loader | 8.87 | no: this zip's chemistry is 9.89x |\\n| fusion | the 78-seat circuit | gate-level steps on Phuc Thai's EXP222, each verified in full (chapter 4) | 15.69 | no: mrmeows' 63-seat file, built on it, carries our two regions here |\\n\\nRatios: means of our verifier runs, except this zip's, which are this notebook's hosts'-metric numbers. Our own\\ncircuits took us from our first LB, 9.73274, to 17.53289 (`sub_010f`). The public field had\\ngone further, so this zip takes the cheapest public files we measured and adds the two pieces where we measured a gain\\nover all of them: the fusion file and the refit of the chemistry weights.\\n\\n**Our judge and Kaggle's judge.** Our judge is the hosts' metric code run on our own salts; Kaggle's is the same code\\non a secret salt. Fusion and chemistry bills barely move with the salt. Message repair moves with the number k of\\nfailed shots. So the leaderboard should land on one of our k-indexed predictions. Of 24 scored\\nsubmissions, 19 have a recorded prediction (our notebook's V1 and V6 and V7 and V8 and V9 outputs repeat the bytes of sub_005 and sub_012a and sub_013 and sub_015 and up_020c);\\n15 of them landed inside the range our own verifier runs or our metric\\narithmetic spanned; the exceptions: sub_005 (LB 11.94676, runs on record 11.98052 to 11.98053), sub_013 (LB 22.11838, runs on record 22.08462 to 22.08463), sub_014 (LB 22.19227, runs on record 22.15840 to 22.15841), sub_015 (LB 22.33981, runs on record 22.40294 to 22.40295). The sub_005 record held one message-repair run; the hosts'\\nsalt made that file fail k = 2 shots, and our reading of the LB back to the dqi cost lands within 2.2e-6 of\\nour k = 2 runs (`competitions/33_qcc/audit/33_AUDIT_A3-lb-gap.md`). Our byte copies of Ahmed Berat Ozer's V9 output and of\\nevgendvorkin's output scored 21.87960 and 21.87975, against our arithmetic on our salts\\n21.879604 and 21.879753: there the salts agreed.\\n\\nThe exceptions of 2026-10-28, sub_013 to sub_015, are the same effect: their decoders met another k on the hosts' salt\\nthan on ours, and each LB fits the k that the public zip with the same decoder shows.\\n\\nFor this zip's decoder our own two salts agree: the hosts' metric code meets k = 1 on our Public salt\\nand k = 1 on our Private salt, so this run prints 22.86842 (22.86843 on the Private\\nsplit); unsalted, our verifier and hengck23's own receipt meet k = 1, and kirilltym's run on his salt\\n\\\"oct29-round9-independent\\\" met k = 0. The hosts' Public salt reads these decoder bytes in kirilltym's row: his\\nteam reads 22.85529 (last submission 14:13 UTC, after his run at 14:08 UTC;\\nfive teams stand at that score). Among every fusion file, decoder and chemistry our field watcher had priced by 15:19 UTC (their unsalted verifier\\nruns; the chemistry bill does not depend on the salt), exactly one combination fits that LB to within 2e-5: our second\\nfusion file, this decoder at k = 1 and the chemistry of his output, before our refit; k = 0 would read\\n22.89023 and k = 2 22.82573. The verifier seeds its shots from the SHA-256 of the circuit file merged with\\nthe salt, so the decoder here meets k = 1 there too, and between his zip and this one only the chemistry bill moves:\\nat k = 0, 1 and 2 these bytes read 22.90338, 22.86842 and 22.83884 by arithmetic.\\nThe same reading, the other way: the SomeJoint team's 889-seat file meets k = 1 unsalted, like this one,\\nbut k = 0 on the hosts' salt. The SomeJoint team reads 22.80621 (last submission 10:42 UTC), and\\nexactly one combination fits: our second fusion file, their file at k = 0 and their own output's chemistry (member\\n`edac06d6`; k = 1 would read 22.77139); Ahmed Berat Ozer's team reads 22.80996 (last submission\\n13:19 UTC), again one fit: our second fusion file, their file at k = 0 and his chemistry of 09:43 UTC\\n(member `bbd35f6c`; k = 1 would read 22.77514). Our own LBs of 2026-10-29 fit the same way: our\\nsub_022 (submission 57761004) scored 22.79257, and our sub_023 (submission 57771058) scored\\n22.80413, the k = 0 split of its hosts' metric run (22.80413; its Public split met k = 1,\\n22.73987).\\n\\n| submission | when (UTC) | LB | runs on record predicted | hosts' metric, our salts |\\n|---|---|---:|---|---:|\\n| sub_001 | 2026-10-25 14:57 | 9.73274 | 9.71789 to 9.73275 | 9.73275 |\\n| sub_002 | 2026-10-25 16:45 | 11.26131 | 11.24413 to 11.26132 | 11.26132 |\\n| sub_003 | 2026-10-25 19:51 | 11.53073 | 11.53073 to 11.53073 | 11.51313 |\\n| sub_004 | 2026-10-25 22:23 | 11.80113 | 11.80114 to 11.81918 | 11.80114 |\\n| sub_005 | 2026-10-25 23:19 | 11.94676 | 11.98052 to 11.98053 | 11.96224 |\\n| sub_006 | 2026-10-26 01:06 | 12.30713 | 12.25821 to 12.30714 | 12.30713 |\\n| sub_007 | 2026-10-26 02:29 | 13.91214 | 13.85684 to 13.91215 | 13.91214 |\\n| sub_008 | 2026-10-26 05:34 | 14.12017 | 14.12017 to 14.16010 | 14.16009 |\\n| sub_009 | 2026-10-26 06:51 | 15.37506 | 15.37506 to 15.41853 | 15.41853 |\\n| sub_010f | 2026-10-27 16:05 | 17.53289 | 17.48351 to 17.53293 | 17.50616 |\\n| sub_011a | 2026-10-27 16:54 | 21.87960 | 21.87960 to 21.87960 | 21.87960 |\\n| sub_011b | 2026-10-27 17:12 | 21.87975 | 21.87975 to 21.87975 | not run |\\n| sub_012a | 2026-10-27 17:59 | 21.88210 | 21.84871 to 21.88210 | 21.88210 |\\n| sub_013 | 2026-10-28 00:13 | 22.11838 | 22.08462 to 22.08463 | 22.05606 |\\n| sub_014 | 2026-10-28 01:41 | 22.19227 | 22.15840 to 22.15841 | 22.12974 |\\n| sub_015 | 2026-10-28 01:53 | 22.33981 | 22.40294 to 22.40295 | 22.40295 |\\n| sub_020e | 2026-10-29 00:00 | 22.74090 | 22.70619 to 22.74090 | 22.74090 |\\n| sub_022 | 2026-10-29 06:11 | 22.79257 | 22.72835 to 22.79258 | 22.72835 |\\n| sub_023 | 2026-10-29 12:37 | 22.80413 | 22.73987 to 22.80413 | 22.73987 |\\n\\n<sub>sources: `data/qcc/lb/2026-10-29T1519/33_our_submissions_2026-10-29T1519.csv` (LB); `data/qcc/submissions/sub_*.json` (our runs: worst and best per job; sub_028: the run records named in build.py `SYNTH`); `data/qcc/runs/sub_*/metric_local/metric_local.json` (hosts' metric, our salts); sub_022's and sub_023's LBs: `data/qcc/lb/2026-10-29T1519/33_our_submissions_2026-10-29T1519.csv`; kirilltym's, the SomeJoint team's and Ahmed Berat Ozer's LBs: board `data/qcc/lb/2026-10-29T1519/x/google-verifiable-quantum-circuit-compilation-publicleaderboard-2026-10-29T15:19:32.csv`; the watcher's prices `data/qcc/watch/prices_snapshot_2026-10-29T1519.json` and its pick `data/qcc/watch/best_snapshot_2026-10-29T1623.json` (the fits; build.py `v14_facts`); kirilltym's output, his log and his decoder receipts: `data/qcc/public/w_kirilltym__quantum-circuits-exact-gauge-5-word-qrom__2026-10-29T140824/out/` and `data/qcc/v8/sub027/kt_pull/`; hengck23's receipt `data/qcc/v8/sub027/hengck_ds/files/verification_score.txt`; the SomeJoint team's output: `data/qcc/public/w_somejoint__quantum-circuits-22-77-local-gm-889-qubit-dqi__2026-10-29T103512/out/`; Ahmed Berat Ozer's chemistry: `data/qcc/public/w_ahmedberatozer__quantum-ai-df-thc-group-compression__2026-10-29T094352/out/submission.zip`; sub_023's metric run: `data/qcc/runs/sub_023/metric_local/metric_local.json`; sub_011b on our salts: fusion and message repair from `data/qcc/runs/h8_metric/ahmedberatozer__quantum-ai-df-thc-group-compression/metric_local.json` (same bytes), chemistry from `data/qcc/work/dfthcsos/r24npz/verify_dvorkin_unsalted.json`; our V9 and V10 zip, our best file of 2026-10-29 before sub_022, and sub_022: `data/qcc/runs/sub_020c/`, `data/qcc/runs/sub_020e/`, `data/qcc/runs/sub_022/`; manwithacat's and Ahmed Berat Ozer's printed numbers: their logs in `data/qcc/public/w_*__2026-10-29T*/out/`; R(k): the dqi verifier's own functions</sub>\"},{\"cell_type\":\"code\",\"id\":\"c30\",\"metadata\":{\"_kg_hide-input\":true,\"jupyter\":{\"source_hidden\":true}},\"execution_count\":null,\"outputs\":[],\"source\":\"cal = REC['calib']\\nfig, ax = plt.subplots(figsize=(10.2, 3.9))\\nfor i, c in enumerate(cal):\\n    lo, hi = 100 * (c['lo'] / c['hi'] - 1), 0.0\\n    ax.plot([i, i], [lo, hi], color='#adb5bd', lw=7, solid_capstyle='butt', zorder=1)\\n    d = 100 * (c['lb'] / c['hi'] - 1)\\n    inside = lo - 2e-3 <= d <= 2e-3\\n    ax.scatter(i, d, s=60, color=ACCENT if c['name'] == REC['bundle'] else (INK if inside else SECOND), zorder=3)\\n    if not inside:\\n        ax.annotate(f\\\"{c['name']}: LB {c['lb']:.5f}\\\", (i, d), xytext=(6, -4), textcoords='offset points', fontsize=9,\\n                    color=SECOND)\\nax.set_xticks(range(len(cal)), [c['name'].replace('sub_', '') for c in cal])\\nax.axhline(0, color=MUTED, lw=0.8)\\nax.set_ylabel('LB vs our best-run prediction, %')\\nax.set_xlabel('scored submission (grey bar: the range our own runs predicted)')\\nax.set_title(\\\"Figure 8. Our judge and Kaggle's judge\\\")\\nshow(fig, 'f8_judges.png', \\\"submissions list and data/qcc/submissions/sub_*.json (predicted_score_worst_runs, _best_runs; \\\"\\n     f\\\"{REC['bundle']}: its run records); byte copies of public outputs: our hosts'-metric costs on our salts\\\")\"},{\"cell_type\":\"markdown\",\"id\":\"c31\",\"metadata\":{},\"source\":\"**Every attempt counted.** Each attempt, kept or not, is a row in a ledger per job. Figure 9 counts them; the table\\nafter it names three dead ends per job, as our closed-ideas file states them.\\n\\n| job | attempts logged | verdict names a failure | other (kept, measured, superseded) | days |\\n|---|---:|---:|---:|---|\\n| fusion | 118 | 50 | 68 | 2026-10-25, 2026-10-26, 2026-10-27, 2026-10-28, 2026-10-29 |\\n| message repair | 89 | 22 | 67 | 2026-10-25, 2026-10-26, 2026-10-27, 2026-10-28 |\\n| chemistry | 245 | 32 | 213 | 2026-10-25, 2026-10-26, 2026-10-27, 2026-10-28, 2026-10-29 |\"},{\"cell_type\":\"code\",\"id\":\"c32\",\"metadata\":{\"_kg_hide-input\":true,\"jupyter\":{\"source_hidden\":true}},\"execution_count\":null,\"outputs\":[],\"source\":\"led = REC['ledger']\\nfig, ax = plt.subplots(figsize=(9.6, 2.6))\\ny = np.arange(3)[::-1]\\nfor yi, t in zip(y, TASKS):\\n    ax.barh(yi, led[t]['failed'], color=MUTED, height=0.55)\\n    ax.barh(yi, led[t]['other'], left=led[t]['failed'], color=ACCENT, height=0.55)\\n    ax.text(led[t]['rows'] + 2, yi, f\\\"{led[t]['rows']} rows\\\", va='center', fontsize=10)\\nax.set_yticks(y, [JOB[t] for t in TASKS])\\nax.grid(axis='y', visible=False)\\nax.set_xlim(0, max(v['rows'] for v in led.values()) * 1.15)\\nax.set_xlabel('ledger rows (grey: the verdict names a failure; orange: kept, measured or superseded)')\\nax.set_title(f\\\"Figure 9. {sum(v['rows'] for v in led.values())} attempts in the ledgers\\\")\\nshow(fig, 'f9_attempts.png', 'competitions/33_qcc/{invsqrt,dqi,dfthcsos}/33_attempt_ledger.jsonl')\"},{\"cell_type\":\"markdown\",\"id\":\"c33\",\"metadata\":{},\"source\":\"| job | dead end, as our closed-ideas file states it |\\n|---|---|\\n| fusion | merging the high and low phase passes; keeping the curvature register alive |\\n| fusion | one phase pass in any register schedule (H kept, H recomputed at the pass, in-place Horner, per-row phasing): best case 121,404 at Q 78 only if H were free; H costs >= 7 Q |\\n| message repair | mask projection beyond 70 positions (exhausted) |\\n| message repair | stored Psi in the Forney scan (needs 34 words); one inverse per block of scan positions |\\n| message repair | port of uncompute's zlin 71-point trick (already in the member: 70-position projection + per-shot skip of zero residuals) |\\n| chemistry | Gram-preserving rotation of the copy index (no gain) |\\n| chemistry | shrinking (1,496,384) to fewer vectors (B 480, 460) or columns (C 360 and below) in the V11 family |\\n| chemistry | a rounding-noise-optimal Givens tree (shared tree: noise x0.978) |\\n\\n<sub>source: `competitions/33_qcc/closed_ideas.md` (\\\"Do not retry\\\" list)</sub>\"},{\"cell_type\":\"markdown\",\"id\":\"c34\",\"metadata\":{},\"source\":\"## 8. The race\\n\\nFigure 10 is the tide: the score at rank 1, at the gold line (rank 12), at rank 100 and at the median, over the\\n44 boards we saved. Rank 100 rose from 9.75359 to 22.92816 (+135%) in\\n100 hours, while rank 1 rose from 20.48324 to 26.14113 (+28%). Rank 100 rises\\nwhen a public notebook does: many teams submit the same public files. Figure 11 shows the result on the\\nlatest board, where whole blocks of teams share one score to five decimals.\"},{\"cell_type\":\"code\",\"id\":\"c35\",\"metadata\":{\"_kg_hide-input\":true,\"jupyter\":{\"source_hidden\":true}},\"execution_count\":null,\"outputs\":[],\"source\":\"import datetime as dt\\ntide = REC['tide']\\nts = [dt.datetime.fromisoformat(x['t']) for x in tide]\\nfig, ax = plt.subplots(figsize=(10.4, 4.4))\\nfor key, name, color in (('top1', 'rank 1', INK), ('gold', 'gold line (rank 12)', '#495057'),\\n                         ('r100', 'rank 100', '#868e96'), ('median', 'median', '#adb5bd')):\\n    xs_ = [t for t, x in zip(ts, tide) if x[key]]\\n    ys_ = [x[key] for x in tide if x[key]]\\n    ax.plot(xs_, ys_, color=color, lw=1.8, label=name)\\nfor a, b in REC['tide_gaps']:\\n    ax.axvspan(dt.datetime.fromisoformat(a), dt.datetime.fromisoformat(b), color=GRID, alpha=0.6, lw=0)\\n    ax.text(dt.datetime.fromisoformat(a), 0.6, ' no board saved', fontsize=8.5, color=MUTED)\\nsteps = REC['ours_steps']\\nsx = [dt.datetime.fromisoformat(s['t']) for s in steps] + [ts[-1]]\\nsy = [s['score'] for s in steps] + [steps[-1]['score']]\\nax.step(sx, sy, where='post', color=ACCENT, lw=2.2, label='ours, best scored')\\nown = next(s for s in steps if s['name'] == REC['own_hist']['bundle'])\\nlabel_point(ax, dt.datetime.fromisoformat(own['t']), own['score'], f\\\"{own['score']:.5f}, our own circuits\\\")\\nax.scatter([ts[-1]], [SCORE], marker='*', s=160, color=ACCENT, zorder=5, label='this zip, this run')\\nax.set_ylim(0, max(x['top1'] for x in tide) * 1.08)\\nax.set_ylabel('public LB score')\\nax.legend(loc='upper left', ncol=3)\\nax.set_title('Figure 10. The tide')\\nfig.autofmt_xdate()\\nshow(fig, 'f10_tide.png', 'data/qcc/lb/**/*publicleaderboard-*.csv (every saved board); our submissions list')\"},{\"cell_type\":\"code\",\"id\":\"c36\",\"metadata\":{\"_kg_hide-input\":true,\"jupyter\":{\"source_hidden\":true}},\"execution_count\":null,\"outputs\":[],\"source\":\"scores = np.array(REC['board_scores'])\\nvals, cnt = np.unique(np.round(scores, 5), return_counts=True)\\nfig, ax = plt.subplots(figsize=(10.4, 4.0))\\nkeep = vals >= 15\\nax.vlines(vals[keep], 0, cnt[keep], color='#868e96', lw=1.6)\\nfor i, c in enumerate(sorted(REC['clusters'], key=lambda c: -c['n'])[:3]):\\n    ax.annotate(f\\\"{c['n']} teams at {c['score']:.5f}: {c['notebook'].split('/')[0]}'s notebook\\\", (c['score'], c['n']),\\n                xytext=(0.36, 0.93 - 0.1 * i), textcoords='axes fraction', ha='left', va='center', fontsize=8.5,\\n                color=INK, arrowprops=dict(arrowstyle='-', color=MUTED, lw=0.8))\\nax.axvline(SCORE, color=ACCENT, lw=1.6)\\nax.text(SCORE, max(cnt) * 0.45, f\\\" this zip {SCORE:.5f}\\\", color=ACCENT, fontsize=10)\\nax.set_xlabel('score (rows at or above 15)')\\nax.set_ylabel('teams with exactly this score')\\nax.set_ylim(0, max(cnt) * 1.25)\\nax.set_title(f'Figure 11. The tie wall: {len(scores):,} teams, {int((cnt >= 2).sum())} scores shared by two or more')\\nshow(fig, 'f11_tie_wall.png', 'the latest saved board; notebook names: data/qcc/scout/2026-10-27T1609/33_clusters.txt')\"},{\"cell_type\":\"markdown\",\"id\":\"c37\",\"metadata\":{},\"source\":\"**The field, recorded.** We harvested 14 public submission zips; together they hold 2 distinct\\nfusion files, 6 distinct message-repair files and 9 distinct chemistry factorizations. The\\ntable lists the top public notebooks as their pages showed them, and our own run of the hosts' metric code on their\\noutput where we made one, as read on 2026-10-27 from 16:19 to 16:40 UTC. This notebook reads these records; it does\\nnot re-run those notebooks' outputs (`FIELD_LIVE = False`).\\n\\n**Since then.** Our notebook went public with LB 21.88210 (run 18:37 UTC, 2026-10-27), above every\\npublic score we had read, with our weights file in its dataset. SomeJoint's notebook \\\"Quantum Circuits, 21.98 Local GM: 883-Qubit DQI\\\" (run\\n21:54 UTC) and manwithacat's \\\"The Real \\\\$150K Was the Friends We Made\\\" (run 22:55 UTC) then wrote one zip,\\n`be8301da...`: mrmeows' newer fusion file, SomeJoint's 883-seat decoder, and Ahmed Berat Ozer's\\nchemistry circuits with our weights file, byte for byte (\\\"Ahmed Berat \u00d6zer's version 9 chemistry circuits with busyaprime's refitted weights\\\", as SomeJoint's output names it). It\\nreads 22.00949, and 18 teams stood at that score on the 2026-10-29 00:34:23 UTC board (ranks\\n591 to 608). Our V7 answered with our first fusion lookup and our loader on that\\nzip: LB 22.11838. Our V8 put the same fusion file into the SomeJoint team's 897-seat zip: LB\\n22.33981.\\n\\nOn 2026-10-28 the public zips took our first fusion file. The SomeJoint team's notebook (run 13:30 UTC) put it\\nnext to heliosli's 889-seat narrowing of their decoder and their new full-XOR chemistry: their team read\\n22.67253. heliosli's notebook (run 15:57 UTC) wrote his own circuits for their words: his team read\\n22.70030, and 53 teams stood at that score on the 2026-10-29 00:34:23 UTC board. avazaku's notebook (run\\n19:24 UTC) added his weights file. Our V9 and V10 put our second fusion file into those members: LB\\n22.72431.\\n\\n**The night of 2026-10-29.** Version 5 of our dataset, with our second fusion file, went public at 00:01 UTC.\\n64 minutes later kirilltym's run carried it, heliosli's run of 01:08 UTC too, and\\n23 of the 26 public outputs our field watcher harvested from runs of that day up to\\n16:23 UTC carry it; the other 3 carry our first. At 06:00 UTC our field\\nwatcher, which prices every public file with our verifier and takes the cheapest per job, picked our second fusion\\nfile, Mudit Chaturvedi's decoder from manwithacat's output and heliosli's chemistry; that pick is our sub_022, LB\\n22.79257.\\n\\n**The day of 2026-10-29, and k on the LB.** Our sub_022 (06:11 UTC: our second fusion file, Mudit\\nChaturvedi's 895-seat decoder, heliosli's chemistry) scored 22.79257. Our sub_023 (12:37\\nUTC: the same two files with our refit of Ahmed Berat Ozer's weights of 09:43 UTC) scored 22.80413, the k = 0\\nsplit of its hosts' metric run. Then the public decoders went to 889 seats. The lesson of the day is k on\\nthe LB: the verifier seeds its shots from the SHA-256 of the circuit file merged with the salt, so two decoders of the\\nsame seats meet different failure counts on the same secret salt, and only an LB of the same bytes reads it.\\nhengck23's file meets k = 1 there (kirilltym's 22.85529), the SomeJoint team's k = 0 (Ahmed Berat Ozer's\\n22.80996 and the SomeJoint team's 22.80621), while both meet k = 1 unsalted. hengck23's file is cheaper\\nby more than one failure's surcharge, so at the k each file meets on the hosts' salt it still wins\\n(-0.496%). At 16:23 UTC our watcher, which prices each decoder by its LB reading where one\\nexists, picked kirilltym's files for all three jobs: 22.868364 by the unsalted runs. This zip is that pick with our\\nrefit of the weights file: LB not read yet; 22.86842 by arithmetic (this decoder at k = 1 on the hosts' salt, as kirilltym's LB reads it), which would stand at rank 128 of 1,555 on the 2026-10-29 15:19:32 UTC board; our row there reads 22.80413 at rank 228, from sub_023.\\n\\nOn the 2026-10-29 15:19:32 UTC board kirilltym's team reads 22.85529 (rank 136), Ahmed Berat Ozer's\\n22.80996 (rank 176), the SomeJoint team's 22.80621 (rank 188, last submission\\n10:42 UTC), heliosli's 22.80578 (11:12 UTC), Dmitrii Gluzdov's 22.80258 and alex\\nchilton's 22.79549; rank 1 reads 26.14113 and the gold line 24.23407. If the hosts' salt met\\nthis decoder at k = 0, as kirilltym's own salt did, these bytes would read 22.90338, rank 114 there;\\nit met k = 1.\\n\\n| notebook | version | score shown | votes | licence on page | hosts' metric, our run (Public split) |\\n|---|---|---:|---:|---|---:|\\n| [ahmedberatozer/quantum-ai-df-thc-group-compression](https://www.kaggle.com/code/ahmedberatozer/quantum-ai-df-thc-group-compression) | V9 | 21.87960 | 91 | Apache 2.0 | 21.87960 |\\n| [leoprovorov/the-unbearable-lightness-of-quantum-circuits](https://www.kaggle.com/code/leoprovorov/the-unbearable-lightness-of-quantum-circuits) | V25 | 21.55383 | 21 | Apache 2.0 | 21.55384 |\\n| [kozykappa/lb-21-38884-quantum-ai-q-circuits](https://www.kaggle.com/code/kozykappa/lb-21-38884-quantum-ai-q-circuits) | V12 | 21.38884 | 19 | Apache 2.0 | not re-run |\\n| [heliosli/the-dataset-is-now-public-now-enjoy (read as heliosli/qcc-j5-chemistry-loaders-deeper-lookup-plans)](https://www.kaggle.com/code/heliosli/the-dataset-is-now-public-now-enjoy) | V7 | 21.38877 | 12 | Apache 2.0 | not re-run |\\n| [somejoint/quantum-circuits-22-34-local-gm-897-qubit-dqi (read as somejoint/quantum-circuits-21-34-local-gm-fused-dqi)](https://www.kaggle.com/code/somejoint/quantum-circuits-22-34-local-gm-897-qubit-dqi) | V12 | 21.37712 | 60 | Apache 2.0 | not re-run |\\n| [dmitriigluzdov/quantum-circuit-compilation-from-source](https://www.kaggle.com/code/dmitriigluzdov/quantum-circuit-compilation-from-source) | V24 | 21.28379 | 73 | Apache 2.0 | not re-run |\\n| [zongaobian/quantum-circuits-signed-digits-bm-psi-qrom](https://www.kaggle.com/code/zongaobian/quantum-circuits-signed-digits-bm-psi-qrom) | V5 | 21.08319 | 7 | Apache 2.0 | not re-run |\\n| [mrmeows/21-0-circuits-let-s-all-reach-the-plateau](https://www.kaggle.com/code/mrmeows/21-0-circuits-let-s-all-reach-the-plateau) | V8 | 21.02523 | 43 | Apache 2.0 | not re-run |\\n| [lightningv08/bezout-schur-5-word-qrom](https://www.kaggle.com/code/lightningv08/bezout-schur-5-word-qrom) | V15 | 19.57896 | 52 | Apache 2.0 | not re-run |\\n| [saddamaditya/narrowed-877q-dqi-and-progressive-r10-chemistry](https://www.kaggle.com/code/saddamaditya/narrowed-877q-dqi-and-progressive-r10-chemistry) | V2 | none shown | 6 | Apache 2.0 | not re-run |\\n| [prvsiyan/verifier-guided-quantum-circuit-optimization](https://www.kaggle.com/code/prvsiyan/verifier-guided-quantum-circuit-optimization) | V14 | none shown | 7 | Apache 2.0 | not re-run |\\n| [alexchilton/21-39-lb-verified-three-task-portfolio](https://www.kaggle.com/code/alexchilton/21-39-lb-verified-three-task-portfolio) | V46 | none shown | 38 | Apache 2.0 | not re-run |\\n| [leoprovorov/but-some-q-squared-width-lab](https://www.kaggle.com/code/leoprovorov/but-some-q-squared-width-lab) | V22 | none shown | 12 | Apache 2.0 | not re-run |\\n| [ahmedberatozer/vqcc-v9-components](https://www.kaggle.com/datasets/ahmedberatozer/vqcc-v9-components) (dataset) | V1 (20.77 MB) | - | 2 | Other (specified in description): \\\"Our own parts are released under Apache-2.0\\\" | not re-run |\\n| [mrmeows/qcc-1375-open-circuits](https://www.kaggle.com/datasets/mrmeows/qcc-1375-open-circuits) (dataset) | V8 (1.17 GB) | - | 5 | Apache 2.0 | not re-run |\\n| [zongaobian/quantum-circuits-signed-digits-bmpsi-and-qrom](https://www.kaggle.com/datasets/zongaobian/quantum-circuits-signed-digits-bmpsi-and-qrom) (dataset) | V3 (68.35 MB) | - | - | Other (specified in description) | not re-run |\\n\\n<sub>sources: board `data/qcc/lb/2026-10-29T1519/x/google-verifiable-quantum-circuit-compilation-publicleaderboard-2026-10-29T15:19:32.csv` (2026-10-29: the leaders', kirilltym's, the SomeJoint team's, Ahmed Berat Ozer's, Dmitrii Gluzdov's and our rows); the watcher's pick `data/qcc/watch/best_snapshot_2026-10-29T1623.json`, its LB-salt record `data/qcc/watch/dqi_lb_known.json` and its prices `data/qcc/watch/prices_snapshot_2026-10-29T1519.json`; kirilltym's notebook text and log (`data/qcc/v8/sub027/kt_pull/`, his output folder); sub_023's metric run `data/qcc/runs/sub_023/metric_local/metric_local.json`; our submissions list `data/qcc/lb/2026-10-29T1519/33_our_submissions_2026-10-29T1519.csv`; board `data/qcc/lb/2026-10-29T0035/x/` (2026-10-29 00:34:23 UTC: the 22.00949, 22.67253 and 22.70030 blocks); `data/qcc/scout/2026-10-28T0004/kernels_scoreDescending.csv` (last run times on 2026-10-27), `data/qcc/watch/state_snapshot_2026-10-28T2120.json` and `data/qcc/watch/state_snapshot_2026-10-29T0607.json` (last run times on 2026-10-28 and 2026-10-29); `data/qcc/watch/best_snapshot_2026-10-29T1623.json` and `data/qcc/watch/best_snapshot_2026-10-29T0600.json` (the watcher's picks, pinned copies of its `best.json`), `data/qcc/watch/prices_snapshot_2026-10-29T0607.json` (its prices); our dataset's version time `data/qcc/v8/sub022/our_datasets_2026-10-29T0607.csv`; `data/qcc/public/w_avazaku__gauge-prox-sign-copy-qrom__2026-10-28T192455/out/` (avazaku's output); `data/qcc/public/w_*/out/submission.zip` (the outputs it harvested on 2026-10-28); `data/qcc/public/h9_*/out/`, `data/qcc/public/w_somejoint__quantum-circuits-22-67-local-gm-full-xor-chem__2026-10-28T133038/out/` and `data/qcc/public/w_heliosli__the-dataset-is-now-public-now-enjoy__2026-10-28T155753/out/` (their outputs: zip, summary, logs); `data/qcc/scout/2026-10-27T1609/h8/pages.tsv` (page reads 16:19 to 16:40 UTC); `data/qcc/scout/2026-10-27T1609/h8/zip_members_batch*.tsv`; `data/qcc/runs/h8_metric/*/metric_local.json`</sub>\"},{\"cell_type\":\"markdown\",\"id\":\"c38\",\"metadata\":{},\"source\":\"## 9. Run it yourself\\n\\nThe hidden cells under the first screen are the whole solution, in five steps:\\n\\n1. **Locate and pin.** Each file of the zip is found under the attached inputs by name and accepted only by its\\n   SHA-256. All of them come from one dataset of ours, byte for byte, with sub-folders flattened\\n   (`dfthcsos__angle_k_0.kmb` is `dfthcsos/angle_k_0.kmb`). A wrong byte stops the notebook, naming the file, the\\n   expected hash and the source.\\n\\n| file in the zip | source | version | SHA-256 |\\n|---|---|---|---|\\n| `dfthcsos/` (16 files) | [busyaprime/33-qcc-v8-members](https://www.kaggle.com/datasets/busyaprime/33-qcc-v8-members) | version 6 (the 18 files of sub_028) | one per file, `SHA256SUMS` in the dataset |\\n| `dqi.kmb` | [busyaprime/33-qcc-v8-members](https://www.kaggle.com/datasets/busyaprime/33-qcc-v8-members) | version 6 (the 18 files of sub_028) | `7a378f47...` |\\n| `invsqrt.kmb` | [busyaprime/33-qcc-v8-members](https://www.kaggle.com/datasets/busyaprime/33-qcc-v8-members) | version 6 (the 18 files of sub_028) | `9a8627c8...` |\\n\\n2. **Write.** `submission.zip` in the competition's layout, with the bundle's own member stamps, so the bytes come out\\n   identical to our submission zip (SHA-256 `0070e217...`).\\n3. **Verify.** The hosts' metric code, copied unchanged from its notebook and pinned by SHA-256, runs in a child\\n   process with the competition's verifiers and kickmix. It refuses an empty or short salt, so it runs with the\\n   Public-split salts of our own local run of the same code on the same bytes.\\n4. **Compare.** Each job's cost against that record; the tolerance is 1e-9 relative.\\n5. **Receipts.** Each verifier's full report goes to `/kaggle/working/receipts/`.\\n\\nThe table below is this run against the record; the last cell checks the gates and fails the notebook if one fails.\"},{\"cell_type\":\"code\",\"id\":\"c39\",\"metadata\":{},\"execution_count\":null,\"outputs\":[],\"source\":\"rows = ['| job | verdict | seats | stamps per shot | failed shots | cost, this run | cost, record | rel. difference | seconds |',\\n        '|---|---|---:|---:|---:|---:|---:|---:|---:|']\\nfor t in TASKS:\\n    r = R[t]\\n    stamps = r.get('toffoli_equivalent', r['toffoli_count'])\\n    fails = r.get('value_errors', 0) + r.get('phase_errors', 0) if t == 'dqi' else 0\\n    rows.append(f\\\"| {JOB[t]} | **{r['status']}** | {r['num_qubits']} | {stamps:,.2f} | {fails} | {r['score']:,.4f} | \\\"\\n                f\\\"{EXP['costs'][t]:,.4f} | {REL[t]:.1e} | {r['_seconds']:.0f} |\\\")\\nrows.append(f\\\"| **score** | | | | | **{SCORE:.5f}** | {EXP['score']:.5f} | {REL_SCORE:.1e} | {RESULT['wall_seconds']:.0f} |\\\")\\ndisplay(Markdown('\\\\n'.join(rows) + f\\\"\\\\n\\\\n`submission.zip`: {OUT_ZIP.stat().st_size:,} B, SHA-256 `{ZIP_SHA}`; \\\"\\n                 f\\\"same bytes as our submission {REC['bundle']}: **{SAME}**. Record: `{EXP['metric_record']}`.\\\"))\"},{\"cell_type\":\"code\",\"id\":\"c40\",\"metadata\":{},\"execution_count\":null,\"outputs\":[],\"source\":\"WALL = time.monotonic() - T0\\nGATES = {f\\\"G2 bytes equal {REC['bundle']}\\\": SAME,\\n         'G3 every cost within 1e-9 of the record': max(REL.values()) <= 1e-9 and REL_SCORE <= 1e-9,\\n         'G4 wall time at most 1,800 s': WALL <= 1800,\\n         'G4 peak RSS at most 24 GiB': RSS_GIB <= 24}\\nsummary = {'bundle': REC['bundle'], 'score': SCORE, 'expected_score': EXP['score'], 'rel_score': REL_SCORE,\\n           'costs': {t: R[t]['score'] for t in TASKS}, 'rel': REL, 'k_dqi': k_run, 'zip_sha256': ZIP_SHA,\\n           'same_bytes': SAME, 'wall_seconds': WALL, 'pin_seconds': PIN_SECONDS, 'zip_seconds': ZIP_SECONDS,\\n           'metric_seconds': RESULT['wall_seconds'], 'verifier_seconds': {t: R[t]['_seconds'] for t in TASKS},\\n           'peak_rss_gib': RSS_GIB, 'maxrss_runner_kib': RESULT['maxrss_self_kib'], 'cpus': os.cpu_count(),\\n           'python': platform.python_version(), 'metric_sha256': METRIC_SHA, 'inputs': FOUND, 'gates': GATES,\\n           'own_lane': {t: r['score'] for t, r in OWN_REPORTS.items()}, 'start_utc': START_UTC}\\n(WORKING / 'qcc33_v8_run.json').write_text(json.dumps(summary, indent=1, default=float))\\nfor name, ok in GATES.items():\\n    print(f\\\"{'PASS' if ok else 'FAIL'}  {name}\\\")\\nprint(f'wall {WALL:,.0f} s, peak RSS {RSS_GIB:.2f} GiB, score {SCORE:.5f}')\\nassert all(GATES.values()), GATES\"},{\"cell_type\":\"markdown\",\"id\":\"c41\",\"metadata\":{},\"source\":\"## 10. What we concluded\\n\\n1. A seat is priced by the job. One qubit is 1.59% of the fusion bill but only 0.22% of\\n   message repair and 0.23% of chemistry (Figure 3).\\n2. Message repair charges a surcharge even with zero failures: R = 1.19126 at k = 0 (Figure 5).\\n3. The leaderboard lands on one of our k-indexed predictions: our copies of the two best public outputs of 2026-10-27\\n   scored 21.87960 and 21.87975 against 21.879604 and 21.879753 on our\\n   salts, and kirilltym's LB 22.85529 fits this zip's decoder at k = 1 on the hosts' salt, as our unsalted runs\\n   and both our metric splits meet it. So this run prints 22.86842 and these bytes read 22.86842 by\\n   arithmetic at the hosts' k; this zip's LB is not read yet (chapter 7). The verifier seeds its shots from the file's hash and\\n   the salt, so a decoder's k is read per file and per salt: hengck23's 889-seat file meets k = 1 on the LB,\\n   the SomeJoint team's file of the same seats k = 0 (chapter 8).\\n4. Our message-repair line stopped at 31.69x, while hengck23's public 889-seat file reaches\\n   59.57x in this run (Figure 6); this zip uses the public file. Its gain over the SomeJoint team's file of the\\n   same seats, -0.951% at equal k, is larger than the surcharge of one failed shot, so it holds at the k\\n   the hosts' salt draws for each (-0.496%).\\n5. Of the strongest public files, the fusion file still had room we could measure, twice: our first lookup moved its\\n   bill by -0.852%, window S1 by -0.307% more (Figure 4), and 23 of the\\n   26 public outputs of 2026-10-29 up to 16:23 UTC carry the second. In chemistry, our loader\\n   relations moved the SomeJoint team's bill by -0.0489% and heliosli's plans for the same words by\\n   -0.3666%; on Atakan Aldemir's circuits with Ahmed Berat Ozer's V14 weights, our refit moves the bill -0.00076%\\n   further, x1.0000025 on the score, with at least 2.1e-07 Ha to spare on every accuracy check\\n   (Figure 7b). Small steps, each measured on the hosts' platform.\\n6. Rank 100 rose 135% in 100 hours while rank 1 rose 28% (Figure 10).\\n7. A public file is a public input: SomeJoint's run that wrote the 22.00949 zip, with our weights in it, came\\n   3.3 hours after our notebook's run, and our second fusion file was in a public output\\n   64 minutes after our dataset version (chapter 8); hengck23's decoder, Atakan Aldemir's circuits\\n   and Ahmed Berat Ozer's V14 weights, which beat ours, are in this zip as his output carries them, the weights refit by us.\\n   We answer with pieces we can measure, and we credit the pieces we take.\\n\\n## 11. Changelog\\n\\n- V1 to V2, 2026-10-26: our first archive (our fusion circuit, a public message-repair file, our chemistry); three full verifier runs on Kaggle CPU; the zip byte-identical to the submission it rebuilds; the title takes its LB read.\\n- V3, 2026-10-26: made public on the owner's yes; source unchanged.\\n- V4 to V5, 2026-10-26: rebuilt for reading (result card, four figures from the verifier records); credits corrected and completed. No circuit changed.\\n- V5 to V6, 2026-10-27: redesigned from the first screen to the credits for readers outside the field; new title; the archive is sub_012a: the strongest public circuits (mrmeows' fusion file, Ahmed Berat Ozer's V9 message repair and chemistry circuits) with our chemistry weights, which lower the chemistry bill below every public file we verified; our own earlier circuits are the story of how we got here; a receipt printed live by the hosts' metric code; all inputs in one dataset; the race, the field and every credit in one place. What moved the score: LB 11.94676 (V1 to V5) to 21.88210. Most of it is the strongest public circuits in place of the V1 archive (chapter 7); our chemistry weights put these bytes +0.00235 above 21.87975, the LB of our byte copy of evgendvorkin's output, the best public notebook score we had read (chapter 6).\\n- V6 to V7, 2026-10-28: the archive is now sub_013: the public bar's zip (SomeJoint's new decoder, mrmeows' fusion file, Ahmed Berat Ozer's chemistry circuits and our weights) with two new pieces of ours, the fusion lookup (chapter 4) and the chemistry loader (chapter 6); the dataset is version 3 with these 18 files; the first screen, chapters 4 to 8, the conclusions and the credits follow the new archive. Also the text fixes prepared on 2026-10-27 and not pushed then: the inspector's dice in chapter 2, licences and versions in the credits, the lineage of the refit in chapter 6.\\n- V7 to V8, 2026-10-28: the archive is now sub_015: the SomeJoint team's public zip (their new 897-qubit decoder, heliosli's chemistry, mrmeows' fusion file) with our fusion lookup in place of their fusion file. heliosli's chemistry beats our weights and our loader, so neither is in this zip, and the first screen, chapters 5 to 8, the conclusions and the credits say so; his loader method is credited as his; dead links replaced by live ones; the dataset is version 4 with these 18 files.\\n- V8 to V9, 2026-10-29: the archive is now sub_020c: heliosli's public zip of 2026-10-28 (his 889-qubit narrowing of the SomeJoint team's decoder, his circuits for the SomeJoint team's chemistry words, and our first fusion file) with avazaku's public weights file for those words and our second fusion step, window S1, in place of our first. The first screen, chapters 4 to 8, the conclusions and the credits follow the new archive; chapter 6 adds avazaku's weights and our chemistry measurements of 2026-10-28, each beaten in public the same day; the notebook writes the zip in the order of the submitted zip's entries; the dataset is version 5 with those 18 files.\\n- V9 to V10, 2026-10-29: the title and the first screen take the LB read of the V9 output, 22.72431; no file changed.\\n- V10 to V11, 2026-10-29: the archive is now sub_028: Ahmed Berat Ozer's public V14 output of 16:06 UTC (our second fusion file, hengck23's 889-qubit decoder as kirilltym chose it, Atakan Aldemir's chemistry circuits and Ahmed Berat Ozer's V14 weights, as his notebook names them), the cheapest public file per job our field watcher had verified at 16:23 UTC, with our refit of the weights file in place of the one it carried. The first screen, chapters 4 to 8, the conclusions and the credits follow the new archive; chapters 5, 7 and 8 read this decoder's k on the hosts' salt from kirilltym's LB (k = 1) and set it beside the SomeJoint team's 889-qubit file (k = 0 there). The lesson: the verifier seeds each file's shots from the SHA-256 of the file merged with the salt, so a decoder's failures on the hosts' secret salt are a property of its exact bytes, read only from an LB of those bytes. A local score on another salt is not that read, so we price these bytes at the k their own decoder met on an LB; chapter 8 adds the day of 2026-10-29, with our sub_022 and sub_023; the dataset is version 6 with these 18 files.\\n\\n## 12. Credits\\n\\n| author | what we use | link | version or run | licence | what we changed |\\n|---|---|---|---|---|---|\\n| **busyaprime** (Akmal Xodarev) | fusion: `invsqrt.kmb` (XAG2C), mrmeows' 63-qubit file with two regions rebuilt by our searches (the main lookup in our V7 and V8, window S1 since our V9); chemistry: the weights file `dfthcsos/submission.npz`, Ahmed Berat Ozer's V14 file as his output of 2026-10-29 16:06 UTC carries it, with W and H2_I refit by us at fixed words (a constrained refit, then a column gauge, chapter 6); the two files of ours in this zip; this notebook; our earlier work, quoted as the story: the chemistry weights that went into the 22.00949 zip, the loader plans of our V7, our loader relations on the SomeJoint team's circuits (chapter 6), R18, R16-C48 | [dataset](https://www.kaggle.com/datasets/busyaprime/33-qcc-v8-members) (this run's input: the 18 files of this zip, the other authors' files unchanged) | version 6 | Apache 2.0 for our files and changes | ours |\\n| Ahmed Berat Ozer | the public output this zip is made from (17 of its 18 files byte for byte: our fusion file, hengck23's decoder, Atakan Aldemir's 15 circuits) and the weights file our refit starts from: his V14 update of Atakan Aldemir's factor (his text: \\\"The pinned public Atakan factor plus our selected delta reproduces W/H2_I and derived offset_W on CPU. Six other arrays are byte-identical to that public factor.\\\"); earlier: the chemistry of our sub_023 (his 09:43 UTC output, refit by us), mask projection in the decoder line, his V9 words, J5 compiler and factorization behind our V6 and V7, his 877-qubit narrowing in our V6 (Figure 6) | [notebook](https://www.kaggle.com/code/ahmedberatozer/quantum-ai-df-thc-group-compression), [dataset](https://www.kaggle.com/datasets/ahmedberatozer/vqcc-v14-psd-projective-portfolio) | his V14, the output of its run at 16:06 UTC, 2026-10-29 (zip `e883b87d...`); notebook text pulled 16:26 UTC | his notebook's text, pulled with the Kaggle API 2026-10-29 16:26 UTC: \\\"Our scripts are Apache-2.0. Every upstream asset retains its own terms; historical licence text does not relicense unrelated third-party sources.\\\"; his dataset vqcc-v14-psd-projective-portfolio: 'other' on its metadata (read 16:27 UTC) | `dfthcsos/submission.npz`: W and H2_I refit by us; nothing else |\\n| kirilltym (Kirill Tymchishin) | message repair: his notebook chose, checked and integrated hengck23's decoder in his output of 2026-10-29 14:08 UTC, which holds the same 17 files as this zip (Ahmed Berat Ozer's text credits Kirill's comparison with finding hengck23's decoder); his team's LB 22.85529 is the read of this decoder's k on the hosts' salt (chapter 7); the exact coefficient gauge in the public chemistry line; earlier: the first public output we harvested with our fusion file (his run at 01:05 UTC) | [notebook](https://www.kaggle.com/code/kirilltym/quantum-circuits-exact-gauge-5-word-qrom) | the output of its run at 14:08 UTC, 2026-10-29 (zip `f23332e9...`); notebook text pulled 15:20 UTC | his notebook's text, pulled with the Kaggle API 2026-10-29 15:20 UTC: \\\"New integration/audit code is Apache-2.0; upstream components retain their notices and licences.\\\" | nothing of his |\\n| Atakan Aldemir (atakanaldemir) | chemistry: the 15 angle circuits (byte for byte) and the factor Ahmed Berat Ozer's V14 weights update; his own text: \\\"This release rebuilds both DQI and all fifteen chemistry loaders from sources\\\"; he credits two of the AND reductions to heliosli and one to Dmitrii Gluzdov, and the factorization and words to the SomeJoint team; earlier: public chemistry files our loader method was measured on (chapter 6) | [notebook](https://www.kaggle.com/code/atakanaldemir/qcc-888q-repair-and-native-chemistry-co-design), [source bank](https://www.kaggle.com/datasets/atakanaldemir/qcc-native-chemistry-and-888q-source-bank) | his V3 archive's circuits as Ahmed Berat Ozer's output of 16:06 UTC carries them; notebook text pulled 15:21 UTC | his source bank qcc-native-chemistry-and-888q-source-bank: apache-2.0 on its metadata (read 2026-10-29 15:21 UTC); his notebook's text names no licence of its own | nothing |\\n| hengck23 | message repair: `dqi.kmb`, his 889-qubit decoder (DQI iteration 014: projective extraction, rolling continuants, a one-product tail and the SomeJoint team's stream converter, as his notebook lists them), unchanged; byte-equal to the hash in his build record; his own receipt, unsalted, PASS with 1 value error | [notebook](https://www.kaggle.com/code/hengck23/dqi-kmb-at-59-56854), [dataset](https://www.kaggle.com/datasets/hengck23/hengck23-dqi-59-57) | his dataset's files of 2026-10-29 12:42 UTC, as kirilltym's output carries the decoder; notebook text pulled 15:21 UTC | his dataset hengck23-dqi-59-57: apache-2.0 on its metadata (read 2026-10-29 15:21 UTC); his notebook's text: \\\"Our own changes: Apache-2.0. Keep the upstream NOTICE files with any derived work.\\\" | nothing |\\n| as hengck23 credits the decoder | the SomeJoint team / Agniv Banerjee (fused confluent decoder, 897 stream converter; Apache-2.0); the anazemcev, Artem1410, ViberTeam and Praxen ports; mrmeows and Ahmed Berat Ozer (mask projection); manwithacat (classical-mask projection); Alex Chilton (the 883-qubit Schur analysis he tested against); Dmitrii Gluzdov; Phuc Thai | [his notebook](https://www.kaggle.com/code/hengck23/dqi-kmb-at-59-56854), \\\"Credits and licences\\\" | pulled 2026-10-29 15:21 UTC | as his text states: \\\"Keep the upstream NOTICE files with any derived work\\\" | nothing |\\n| Agniv Banerjee and the SomeJoint team | message repair: the decoder line of this zip's file (above); their own 889-qubit decoder, priced beside it in chapters 5 and 7 (not in this zip); chemistry: the factorization and words the chemistry builds on; earlier: their 897-, 883- and 889-qubit decoders and their chemistry in our V7 to V10 (Figure 6) | [notebook](https://www.kaggle.com/code/somejoint/quantum-circuits-22-77-local-gm-889-qubit-dqi), [chemistry notebook](https://www.kaggle.com/code/somejoint/quantum-circuits-22-67-local-gm-full-xor-chem) | their outputs as cited in chapters 5 to 8 | their notebook's text, pulled with the Kaggle API 2026-10-29 14:05 UTC: \\\"The circuits keep their authors' licences; the notebook code is Apache-2.0.\\\" | nothing |\\n| Dmitrii Gluzdov | chemistry: one AND reduction in these circuits, as Atakan Aldemir credits it; his che