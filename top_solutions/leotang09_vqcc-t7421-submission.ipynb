  "blob": {
    "sourceNullable": "\"\"\"T7421: the submission for Kaggle google-verifiable-quantum-circuit-compilation.\n\nEvery circuit file was graded by the competition's own kickmix verifier on our fleet before it was put in the\nattached dataset; this notebook checks each file's sha256 against the manifest and writes them, unchanged, as\n/kaggle/working/submission.zip (invsqrt.kmb, dqi.kmb, dfthcsos/angle_k_*.kmb, dfthcsos/submission.npz).\n\"\"\"\nimport hashlib\nimport json\nimport os\nimport zipfile\n\n\ndef sha256(path):\n    h = hashlib.sha256()\n    with open(path, 'rb') as f:\n        for block in iter(lambda: f.read(1 << 20), b''):\n            h.update(block)\n    return h.hexdigest()\n\n\nroot = next((r for r, _, files in os.walk('/kaggle/input') if 'vqcc_manifest.json' in files), None)\nassert root, 'vqcc_manifest.json not found under /kaggle/input'\nwith open(os.path.join(root, 'vqcc_manifest.json')) as f:\n    manifest = json.load(f)\nout = '/kaggle/working/submission.zip'\nwith zipfile.ZipFile(out, 'w', compression=zipfile.ZIP_DEFLATED, allowZip64=True) as z:\n    for member, m in sorted(manifest['members'].items()):\n        path = os.path.join(root, m['file'])\n        got = sha256(path)\n        assert got == m['sha256'], f'{member}: sha256 {got} != manifest {m[\"sha256\"]}'\n        z.write(path, member)\n        print(member, got)\nprint(json.dumps({'submission': out, 'sha256': sha256(out), 'candidate_ids': manifest['candidate_ids']}))\n",
    "languageNullable": "python",
    "kernelTypeNullable": "script",
    "slugNullable": "vqcc-t7421-submission",
    "source": "\"\"\"T7421: the submission for Kaggle google-verifiable-quantum-circuit-compilation.\n\nEvery circuit file was graded by the competition's own kickmix verifier on our fleet before it was put in the\nattached dataset; this notebook checks each file's sha256 against the manifest and writes them, unchanged, as\n/kaggle/working/submission.zip (invsqrt.kmb, dqi.kmb, dfthcsos/angle_k_*.kmb, dfthcsos/submission.npz).\n\"\"\"\nimport hashlib\nimport json\nimport os\nimport zipfile\n\n\ndef sha256(path):\n    h = hashlib.sha256()\n    with open(path, 'rb') as f:\n        for block in iter(lambda: f.read(1 << 20), b''):\n            h.update(block)\n    return h.hexdigest()\n\n\nroot = next((r for r, _, files in os.walk('/kaggle/input') if 'vqcc_manifest.json' in files), None)\nassert root, 'vqcc_manifest.json not found under /kaggle/input'\nwith open(os.path.join(root, 'vqcc_manifest.json')) as f:\n    manifest = json.load(f)\nout = '/kaggle/working/submission.zip'\nwith zipfile.ZipFile(out, 'w', compression=zipfile.ZIP_DEFLATED, allowZip64=True) as z:\n    for member, m in sorted(manifest['members'].items()):\n        path = os.path.join(root, m['file'])\n        got = sha256(path)\n        assert got == m['sha256'], f'{member}: sha256 {got} != manifest {m[\"sha256\"]}'\n        z.write(path, member)\n        print(member, got)\nprint(json.dumps({'submission': out, 'sha256': sha256(out), 'candidate_ids': manifest['candidate_ids']}))\n",
