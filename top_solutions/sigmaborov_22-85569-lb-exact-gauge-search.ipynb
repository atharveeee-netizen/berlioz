hide-input\":true,\"jupyter\":{\"source_hidden\":true}},\"outputs\":[],\"source\":\"WEIGHT_BYTES=''\\nWEIGHT_SHA256='95e7ad386f8efd22d0a5629d50d96d177aa3ad54cc3ca5607b06e78c58962ad1'\\nraw=zlib.decompress(base64.b64decode(WEIGHT_BYTES));assert hashlib.sha256(raw).hexdigest()==WEIGHT_SHA256\\npath=SUB/'dfthcsos/submission.npz'\\nwith np.load(path,allow_pickle=False) as z:base={k:np.array(z[k]) for k in z.files}\\nwith np.load(io.BytesIO(raw),allow_pickle=False) as z:\\n    selected=dict(base,W=np.array(z['W']),H2_I=np.array(z['H2_I']))\\nif 'offset_W' in selected:selected['offset_W']=selected['H2_I']-selected['W'].sum(1)\\ncheckpoint=WORK/'selected_checkpoint.npz';np.savez(checkpoint,**selected)\\nfrom gauge_search import search\\noptimized=WORK/'production_optimized.npz'\\nsearch_result=search(checkpoint,optimized,sweeps=8)\\nwith np.load(optimized,allow_pickle=False) as z:production={k:np.array(z[k]) for k in z.files}\\nfor key in ('U','H1_I','Hsym_lower','tree_edges','angle_words','brot'):\\n    assert np.array_equal(base[key],production[key]),key\\nassert search_result['after']<=search_result['before']\\nshutil.copyfile(optimized,path)\\nprint('Production chemistry coefficients selected; all angles and immutable arrays unchanged.')\\n\"},{\"cell_type\":\"code\",\"execution_count\":null,\"id\":\"622e2f4f\",\"metadata\":{\"jupyter\":{\"source_hidden\":true}},\"outputs\":[],\"source\":\"RUN_ADDITIONAL_SEARCH=False\\nif RUN_ADDITIONAL_SEARCH:\\n    env=dict(os.environ,PYTHONPATH=os.pathsep.join(native+[str(COMP/'verifiers')]))\\n    study=WORK/'additional_multistart_study'\\n    subprocess.run([sys.executable,str(SRC/'gauge_multistart.py'),str(checkpoint),str(study),'--rounds','3','--trials','6'],env=env,check=True)\\n    print('Additional research candidate:',(study/'best_path.txt').read_text())\\n\"},{\"cell_type\":\"code\",\"execution_count\":null,\"id\":\"4cc5cc0d\",\"metadata\":{},\"outputs\":[],\"source\":\"env=dict(os.environ,PYTHONPATH=os.pathsep.join(native+[str(COMP/'verifiers')]))\\nproof=WORK/'reachable_proof_v5.json'\\nsubprocess.run([sys.executable,str(SRC/'verify_reachable.py'),str(SUB/'dfthcsos'),str(proof)],env=env,check=True)\\nassert json.loads(proof.read_text())['status']=='PASS'\\n\"},{\"cell_type\":\"markdown\",\"id\":\"c275d2e0\",\"metadata\":{},\"source\":\"## Full verification receipts and fresh 78,080-shot chemistry check\"},{\"cell_type\":\"code\",\"execution_count\":null,\"id\":\"1f5d230e\",\"metadata\":{},\"outputs\":[],\"source\":\"REFERENCE={'invsqrt': 2076774.233715282, 'dqi': 24439474177519.598, 'dfthcsos': 3355599588.3155365}\\nINVERSE_FULL_RECEIPT={'status': 'PASS', 'score': 102349.22184719678, 'toffoli_equivalent': 1624.5908229713775, 'toffoli_count': 1329.4999990824815, 'max_toffoli_count': 1397, 't_count': 1.0, 'rotation_count': 41.0, 'rotation_eps': 2.434041480874084e-13, 'num_qubits': 63, 'reaction_depth': 798, 'num_ops': 45576, 'verified_shots': 200540928, 'worst_error_over_tolerance': 0.9993237694056958, 'worst_x': 161, 'circuit_sha256': '9a8627c812833a6feca6eb82239f38d1a9a5e1eee299a9a7af9abd85e36339be', 'wall_seconds': 739.5807130336761}\\nDQI_FULL_RECEIPT={'status': 'PASS', 'score': 408399264306.69824, 'm': 4095, 'n': 70, 'degree': 12, 'r': 2016, 'verified_shots': 102400, 'value_errors': 0, 'phase_errors': 0, 'empirical_error_rate': 0.0, 'effective_error_rate': 0.0008660587301657926, 'log2_delta': -128.0, 'repetition_factor': 1.1912604648115832, 'mean_error_weight': 31.046737331746655, 'toffoli_count': 433785.1698242187, 'max_toffoli_count': 434512, 'reaction_depth': 4337, 'num_ops': 60050827, 'shot_operation_counts': {'NEG': 3480030, 'BIT_INVERT': 164212903520, 'BIT_STORE0': 11210444800, 'BIT_STORE1': 6350298, 'X': 26432774784, 'Z': 3055106960, 'R': 6734252641, 'HMR': 9222163041, 'CX': 5468086053571, 'CZ': 40951277278, 'SWAP': 160603937767, 'CSWAP': 1327104000, 'CCX': 43009962990, 'CCZ': 82534400, 'INFO_TAG': 1681817600, 'POP_CONDITION': 49356800, 'PUSH_CONDITION': 49356800}, 'num_qubits': 889, 'num_bits': 101853, 'circuit_sha256': '7a378f4755605e0c5fa6117f808891bf8dcf0797d047155e6d4c9e75e3c99421', 'wall_seconds': 65.57770276069641}\\nassert sha(SUB/'invsqrt.kmb')==INVERSE_FULL_RECEIPT['circuit_sha256']\\nassert sha(SUB/'dqi.kmb')==DQI_FULL_RECEIPT['circuit_sha256']\\nassert INVERSE_FULL_RECEIPT['status']=='PASS' and INVERSE_FULL_RECEIPT['verified_shots']==200540928\\nassert DQI_FULL_RECEIPT['status']=='PASS' and DQI_FULL_RECEIPT['verified_shots']==102400\\nfresh=chemistry.verify(str(SUB/'dfthcsos'),salt='notebook-verification')\\nassert fresh['status']=='PASS' and fresh['verified_shots']==78080\\nassert fresh['score']<baseline_fresh['score'], 'The new portfolio must improve the leader'\\nresults=dict(invsqrt=INVERSE_FULL_RECEIPT,dqi=DQI_FULL_RECEIPT,dfthcsos=fresh)\\nratios={t:REFERENCE[t]/r['score'] for t,r in results.items()}\\nlocal_score=math.prod(ratios.values())**(1/3)\\nfor t,r in results.items():print(t,'PASS','cost',r['score'],'ratio',ratios[t])\\ndisplay(Markdown(f'### Measured local score: **{local_score:.8f}**'))\\nprojected_public_score=22.85582*(baseline_fresh['score']/fresh['score'])**(1/3)\\ncomparison=[dict(version='Public leader V1',normalization=baseline_fresh['lambda_eff'],chemistry_cost=baseline_fresh['score'],official_public_score=22.85582),dict(version='This V5',normalization=fresh['lambda_eff'],chemistry_cost=fresh['score'],official_public_score=None,projected_public_score=projected_public_score)]\\nprint(json.dumps(comparison,indent=2))\\ndisplay(Markdown(f\\\"Chemistry cost reduction: **{100*(1-fresh['score']/baseline_fresh['score']):.5f}%**. Projected public score: **{projected_public_score:.8f}**; official evaluation pending.\\\"))\\n(WORK/'comparison_v5.json').write_text(json.dumps(comparison,indent=2))\\nprint('New decoder receipt errors:',DQI_FULL_RECEIPT['value_errors'],DQI_FULL_RECEIPT['phase_errors'])\\n\"},{\"cell_type\":\"code\",\"execution_count\":null,\"id\":\"82628a38\",\"metadata\":{},\"outputs\":[],\"source\":\"names=sorted(p.relative_to(SUB).as_posix() for p in SUB.rglob('*') if p.is_file())\\nassert names==sorted(PINS) and len(names)==18\\nALLOWED={'X','CX','CCX','Z','CZ','CCZ','Z_POW','NEG','SWAP','CSWAP','R','HMR','BIT_INVERT','BIT_STORE0','BIT_STORE1','PUSH_CONDITION','POP_CONDITION','INFO_TAG','DEBUG_PRINT'}\\nfor name in names:\\n    if name.endswith('.kmb'):\\n        c=km.Circuit.from_file(SUB/name,format='kmb')\\n        assert not(set(c.operation_statistics())-ALLOWED)\\n        assert max(c.num_qubits,c.num_bits)<2**30//1536\\n        assert all(isinstance(k,str) for k in c.register_data)\\nhashes={name:sha(SUB/name) for name in names}\\nchanged_files=[n for n in names if hashes[n]!=PINS[n]]\\nassert changed_files==['dfthcsos/submission.npz'],changed_files\\narchive=WORK/'submission.zip'\\nwith zipfile.ZipFile(archive,'w',zipfile.ZIP_DEFLATED,compresslevel=6) as z:\\n    for name in names:z.write(SUB/name,name)\\nwith zipfile.ZipFile(archive) as z:\\n    assert sorted(z.namelist())==names and z.testzip() is None\\n    for name,pin in hashes.items():\\n        with z.open(name) as f:assert hashlib.file_digest(f,'sha256').hexdigest()==pin\\nreceipt=dict(status='PASS',local_score=local_score,reference=REFERENCE,results=results,ratios=ratios,\\n    fixed_salt='notebook-verification',public_target_at_source_selection=22.85582,baseline_chemistry=baseline_fresh,projected_public_score=projected_public_score,changed_files=changed_files,\\n    upstream_kernel='baidalinadilzhan/quantumai-improved-public-oct29/1',upstream_sha256=UPSTREAM_ZIP_SHA256,\\n    checkpoint_sha256=WEIGHT_SHA256,search=search_result,files=hashes,archive_sha256=sha(archive),\\n    leaderboard_score_measured=False,elapsed_seconds=time.monotonic()-started)\\n(WORK/'verification_receipt_v5.json').write_text(json.dumps(receipt,indent=2))\\nprint('Verified 18-member ZIP ready for notebook-associated submission:',sha(archive))\\n\"},{\"cell_type\":\"markdown\",\"id\":\"6c7263f3\",\"metadata\":{},\"source\":\"## Attribution and scope\\n\\n- **New copied public baseline:** [Baidalin Adilzhan V1](https://www.kaggle.com/code/baidalinadilzhan/quantumai-improved-public-oct29), Public Score 22.85582. Its original notebook is included unchanged in `source_v5/upstream_public_leader_v1.ipynb`. It continues our V3 numerical study; we extend it with the stronger V4 basis and new V5 trials.\\n\\n- **Frozen starting portfolio and independent comparison:** [Kirill Tymchishin, V25](https://www.kaggle.com/code/kirilltym/quantum-circuits-exact-gauge-5-word-qrom). Its exact selected 18 member hashes and archived bytes are authenticated above.\\n- **DQI:** [hengck23's public dqi_iter014](https://www.kaggle.com/datasets/hengck23/hengck23-dqi-59-57), unchanged. Projective extraction, rolling continuants, one-product tail and streamed converter. It is approximate and omits some low-weight guards. Full error counts and the confidence penalty are retained. Earlier decoder lineage: SomeJoint, GPT-6 Astra Pro, Ahmed Berat \u00d6zer, Alex Chilton, jday96314, mrmeows, manwithacat, Dmitrii Gluzdov, ViberTeam and Phuc Thai.\\n- **Starting chemistry and compiled ANGLE streams:** [Atakan Aldemir V3](https://www.kaggle.com/code/atakanaldemir/qcc-888q-repair-and-native-chemistry-co-design), Heliosli, Dmitrii Gluzdov, on SomeJoint's R8/B143/C60 factorization. Earlier chemistry: Michael Rustad, Ahmed Berat \u00d6zer, busyaprime, lightningv08 and mrmeows. Our coefficient changes keep all of these angle words and circuits unchanged.\\n- **invsqrt:** busyaprime's rebuild of mrmeows' 63Q circuit, on Phuc Thai, Dmitrii Gluzdov and marsyas. Unchanged byte-for-byte.\\n- **Our numerical study:** exact sign-interval pair minimization, CPU Cayley optimization and a CPU adaptation of [Ahmed Berat \u00d6zer's float64 constrained joint fitter](https://www.kaggle.com/code/ahmedberatozer/quantum-ai-df-thc-group-compression). The upstream joint fitter and q8lib retain their original authorship and Apache-2.0 terms. Augmented Gram gauge credited upstream to Kirill Tymchishin and mrmeows.\\n- **Reachable-state proof:** Ahmed Berat \u00d6zer's adaptation of mrmeows' symbolic HMR audit. Every valid address, both host-required traversals, every independent HMR outcome. No arbitrary-target XOR claim.\\n- **Organizers:** Google Quantum AI/Qualtran, Kickmix, reference data and unchanged official verifiers. [Benchmark paper](https://arxiv.org/abs/2610.23832), [measurement uncomputation](https://quantum-journal.org/papers/q-2018-06-18-74/), [official ANGLE clarification](https://www.kaggle.com/competitions/google-verifiable-quantum-circuit-compilation/discussion/753092).\\n\\nCompiled circuit binaries remain their authors' work; we do not claim to have\\nsynthesized the upstream production loaders or decoder. Our search additions\\nare Apache-2.0; upstream components retain their own terms.\\n\"}],\"metadata\":{\"kernelspec\":{\"display_name\":\"Python 3\",\"language\":\"python\",\"name\":\"python3\"},\"title\":\"22.85569 LB | Exact Gauge Search\"},\"nbformat\":4,\"nbformat_minor\":5}",
