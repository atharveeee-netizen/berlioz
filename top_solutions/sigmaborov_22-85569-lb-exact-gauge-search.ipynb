      comment syntax for the file format. We also recommend that a\\\\\\\\\\\\\\\\n      file or class name and description of purpose be included on the\\\\\\\\\\\\\\\\n      same \\\\\\\\\\\"printed page\\\\\\\\\\\" as the copyright notice for easier\\\\\\\\\\\\\\\\n      identification within third-party archives.\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n   Copyright [yyyy] [name of copyright owner]\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n   Licensed under the Apache License, Version 2.0 (the \\\\\\\\\\\"License\\\\\\\\\\\");\\\\\\\\\\\\\\\\n   you may not use this file except in compliance with the License.\\\\\\\\\\\\\\\\n   You may obtain a copy of the License at\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n       http://www.apache.org/licenses/LICENSE-2.0\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n   Unless required by applicable law or agreed to in writing, software\\\\\\\\\\\\\\\\n   distributed under the License is distributed on an \\\\\\\\\\\"AS IS\\\\\\\\\\\" BASIS,\\\\\\\\\\\\\\\\n   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\\\\\\\\\\\\\\\\n   See the License for the specific language governing permissions and\\\\\\\\\\\\\\\\n   limitations under the License.\\\\\\\\\\\\\\\\n\\\\',encoding=\\\\'utf-8\\\\')\\\\\\\\np=SRC/\\\\'research_cpu/fixed_word_joint64.py\\\\';p.parent.mkdir(parents=True,exist_ok=True);p.write_text(\\\\'# CPU adaptation of Ahmed Berat Ozer\\\\\\\\\\\\\\\\\\\\'s v11 fixed_word_joint64.py (Apache-2.0).\\\\\\\\\\\\\\\\n# Device changed to CPU; feasibility caps leave numerical safety margins.\\\\\\\\\\\\\\\\n\\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\"Full float64 constrained W/identity fit with fixed XOR-table bytes.\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nNew control: the published Kirill joint study used float32 MPS and lost gap\\\\\\\\\\\\\\\\naccuracy near 22,000 Ha. Here the true one-body, two-body and gap constraints\\\\\\\\\\\\\\\\nare differentiated in float64, with QR-whitened physical coordinates and an\\\\\\\\\\\\\\\\nanchored two-body residual. This is not another exact column gauge search.\\\\\\\\\\\\\\\\n\\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\\\\\\nimport argparse\\\\\\\\\\\\\\\\nimport json\\\\\\\\\\\\\\\\nimport os\\\\\\\\\\\\\\\\nfrom pathlib import Path\\\\\\\\\\\\\\\\nimport sys\\\\\\\\\\\\\\\\nimport time\\\\\\\\\\\\\\\\nimport numpy as np\\\\\\\\\\\\\\\\nfrom scipy.optimize import minimize\\\\\\\\\\\\\\\\nfrom scipy.optimize import linear_sum_assignment\\\\\\\\\\\\\\\\nimport torch\\\\\\\\\\\\\\\\nCOMP=Path(os.environ[\\\\\\\\\\\\\\\\\\\\'QCC_COMP_DIR\\\\\\\\\\\\\\\\\\\\']);sys.path[:0]=[str(COMP/\\\\\\\\\\\\\\\\\\\\'verifiers\\\\\\\\\\\\\\\\\\\\')]\\\\\\\\\\\\\\\\nfrom dfthcsos import verify as V\\\\\\\\\\\\\\\\nfrom dfthcsos.scoreinfra import dfthc_math as M\\\\\\\\\\\\\\\\nimport q8lib as L\\\\\\\\\\\\\\\\nap=argparse.ArgumentParser();ap.add_argument(\\\\\\\\\\\\\\\\\\\\'initial\\\\\\\\\\\\\\\\\\\\',type=Path);ap.add_argument(\\\\\\\\\\\\\\\\\\\\'out\\\\\\\\\\\\\\\\\\\\',type=Path)\\\\\\\\\\\\\\\\nap.add_argument(\\\\\\\\\\\\\\\\\\\\'--evaluations\\\\\\\\\\\\\\\\\\\\',type=int,default=650)\\\\\\\\\\\\\\\\nap.add_argument(\\\\\\\\\\\\\\\\\\\\'--fixed-gap\\\\\\\\\\\\\\\\\\\\',action=\\\\\\\\\\\\\\\\\\\\'store_true\\\\\\\\\\\\\\\\\\\\',help=\\\\\\\\\\\\\\\\\\\\'Implicitly eliminate the stiff global offset scale\\\\\\\\\\\\\\\\\\\\')\\\\\\\\\\\\\\\\nap.add_argument(\\\\\\\\\\\\\\\\\\\\'--iterations\\\\\\\\\\\\\\\\\\\\',type=int,default=180)\\\\\\\\\\\\\\\\nap.add_argument(\\\\\\\\\\\\\\\\\\\\'--smooth-l1\\\\\\\\\\\\\\\\\\\\',type=float,default=0.)\\\\\\\\\\\\\\\\na=ap.parse_args();a.out.mkdir(parents=True,exist_ok=True)\\\\\\\\\\\\\\\\ntorch.set_num_threads(1);torch.set_default_dtype(torch.float64)\\\\\\\\\\\\\\\\n# CPU float64; no CUDA backend\\\\\\\\\\\\\\\\nstart=time.time();z=dict(np.load(a.initial,allow_pickle=False));inp=V.load_inputs(a.initial)\\\\\\\\\\\\\\\\nbase=V.evaluate_words(inp,z[\\\\\\\\\\\\\\\\\\\\'angle_words\\\\\\\\\\\\\\\\\\\\'],z[\\\\\\\\\\\\\\\\\\\\'tree_edges\\\\\\\\\\\\\\\\\\\\'],int(z[\\\\\\\\\\\\\\\\\\\\'brot\\\\\\\\\\\\\\\\\\\\']))\\\\\\\\\\\\\\\\nhalf=2**(int(z[\\\\\\\\\\\\\\\\\\\\'brot\\\\\\\\\\\\\\\\\\\\'])-1);signed=((z[\\\\\\\\\\\\\\\\\\\\'angle_words\\\\\\\\\\\\\\\\\\\\'].astype(np.int64)+half)%(2*half))-half\\\\\\\\\\\\\\\\nall_u=M.reconstruct_u_vectors(signed/half,z[\\\\\\\\\\\\\\\\\\\\'tree_edges\\\\\\\\\\\\\\\\\\\\']);all_u/=np.linalg.norm(all_u,axis=-1,keepdims=True)\\\\\\\\\\\\\\\\nuo,u=M.split_u_vectors(all_u,z[\\\\\\\\\\\\\\\\\\\\'W\\\\\\\\\\\\\\\\\\\\']);r,b,c=z[\\\\\\\\\\\\\\\\\\\\'W\\\\\\\\\\\\\\\\\\\\'].shape\\\\\\\\\\\\\\\\ntarget=L.TwoBody(\\\\\\\\\\\\\\\\\\\\'cpu\\\\\\\\\\\\\\\\\\\\',torch.float64)\\\\\\\\\\\\\\\\nut=torch.tensor(u,device=\\\\\\\\\\\\\\\\\\\\'cpu\\\\\\\\\\\\\\\\\\\\');projectors=target.pair(ut).transpose(1,2)\\\\\\\\\\\\\\\\nQ,Rt=torch.linalg.qr(projectors)\\\\\\\\\\\\\\\\nw0=torch.tensor(z[\\\\\\\\\\\\\\\\\\\\'W\\\\\\\\\\\\\\\\\\\\'],device=\\\\\\\\\\\\\\\\\\\\'cpu\\\\\\\\\\\\\\\\\\\\');v0=Rt@w0\\\\\\\\\\\\\\\\nK0=v0@v0.transpose(1,2)\\\\\\\\\\\\\\\\ncross=torch.einsum(\\\\\\\\\\\\\\\\\\\\'rpi,spj->rsij\\\\\\\\\\\\\\\\\\\\',Q,Q)\\\\\\\\\\\\\\\\nprojected_target=Q.transpose(1,2)@target.T@Q\\\\\\\\\\\\\\\\nE0=torch.einsum(\\\\\\\\\\\\\\\\\\\\'rsij,sjk,rslk->ril\\\\\\\\\\\\\\\\\\\\',cross,K0,cross)-projected_target\\\\\\\\\\\\\\\\nx0=torch.einsum(\\\\\\\\\\\\\\\\\\\\'rpi,ric->rcp\\\\\\\\\\\\\\\\\\\\',Q,v0).reshape(r*c,-1)\\\\\\\\\\\\\\\\nerror0=(x0.T@x0-target.T).square().sum()\\\\\\\\\\\\\\\\noffset0=torch.tensor(inp.W,device=\\\\\\\\\\\\\\\\\\\\'cpu\\\\\\\\\\\\\\\\\\\\')\\\\\\\\\\\\\\\\nh1=inp.ref[\\\\\\\\\\\\\\\\\\\\'oei\\\\\\\\\\\\\\\\\\\\']-.5*np.einsum(\\\\\\\\\\\\\\\\\\\\'prrq->pq\\\\\\\\\\\\\\\\\\\\',inp.ref[\\\\\\\\\\\\\\\\\\\\'tei\\\\\\\\\\\\\\\\\\\\'])\\\\\\\\\\\\\\\\nconstant=torch.tensor(h1-.5*inp.ref[\\\\\\\\\\\\\\\\\\\\'electrons\\\\\\\\\\\\\\\\\\\\']*inp.S+inp.beta_1*np.eye(76),device=\\\\\\\\\\\\\\\\\\\\'cpu\\\\\\\\\\\\\\\\\\\\')\\\\\\\\\\\\\\\\nenergy=float(inp.energy_upper-inp.ref[\\\\\\\\\\\\\\\\\\\\'ecore\\\\\\\\\\\\\\\\\\\\']+inp.ref[\\\\\\\\\\\\\\\\\\\\'electrons\\\\\\\\\\\\\\\\\\\\']*inp.beta_1)\\\\\\\\\\\\\\\\none=torch.tensor(uo,device=\\\\\\\\\\\\\\\\\\\\'cpu\\\\\\\\\\\\\\\\\\\\')\\\\\\\\\\\\\\\\nhp0=constant-torch.einsum(\\\\\\\\\\\\\\\\\\\\'rb,rbp,rbq->pq\\\\\\\\\\\\\\\\\\\\',(w0*offset0[:,None]).sum(-1),ut,ut)\\\\\\\\\\\\\\\\n_,eigvec=torch.linalg.eigh(hp0)\\\\\\\\\\\\\\\\nrows,cols=linear_sum_assignment(-np.abs(uo@eigvec.cpu().numpy()))\\\\\\\\\\\\\\\\npermutation=np.empty(76,dtype=np.int64);permutation[rows]=cols\\\\\\\\\\\\\\\\nperm=torch.tensor(permutation,device=\\\\\\\\\\\\\\\\\\\\'cpu\\\\\\\\\\\\\\\\\\\\')\\\\\\\\\\\\\\\\ncut=r*b*c;size=cut+r*c;calls=0;best=float(base[\\\\\\\\\\\\\\\\\\\\'lambda_eff\\\\\\\\\\\\\\\\\\\\']);best_z=np.zeros(size);history=[]\\\\\\\\\\\\\\\\ne_cap=.0199998;gap_floor=3.9149\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ndef quantities(flat):\\\\\\\\\\\\\\\\n    dv=flat[:cut].reshape(r,b,c);off=offset0+flat[cut:].reshape(r,c)\\\\\\\\\\\\\\\\n    vv=v0+dv;w=torch.linalg.solve_triangular(Rt,vv,upper=True)\\\\\\\\\\\\\\\\n    delta=v0@dv.transpose(1,2)+dv@v0.transpose(1,2)+dv@dv.transpose(1,2)\\\\\\\\\\\\\\\\n    dm=torch.einsum(\\\\\\\\\\\\\\\\\\\\'rsij,sjk,rslk->ril\\\\\\\\\\\\\\\\\\\\',cross,delta,cross)\\\\\\\\\\\\\\\\n    e2sq=error0+2*(E0*delta).sum()+(delta*dm).sum()\\\\\\\\\\\\\\\\n    if a.fixed_gap:\\\\\\\\\\\\\\\\n        # Solve the scalar physical gap equation outside autograd, then attach\\\\\\\\\\\\\\\\n        # its exact implicit first derivative. No eigenvector or shift changes.\\\\\\\\\\\\\\\\n        C=torch.einsum(\\\\\\\\\\\\\\\\\\\\'rb,rbp,rbq->pq\\\\\\\\\\\\\\\\\\\\',(w*off[:,None]).sum(-1),ut,ut)\\\\\\\\\\\\\\\\n        with torch.no_grad():\\\\\\\\\\\\\\\\n            alpha=torch.ones((),device=\\\\\\\\\\\\\\\\\\\\'cpu\\\\\\\\\\\\\\\\\\\\')\\\\\\\\\\\\\\\\n            offnorm=off.square().sum()\\\\\\\\\\\\\\\\n            for _ in range(8):\\\\\\\\\\\\\\\\n                ee,qq=torch.linalg.eigh(constant-alpha*C)\\\\\\\\\\\\\\\\n                f=energy+ee.abs().sum()-ee.sum()+.5*alpha.square()*offnorm-gap_floor\\\\\\\\\\\\\\\\n                projected=torch.diagonal(qq.T@C@qq)\\\\\\\\\\\\\\\\n                derivative=alpha*offnorm-((ee.sign()-1)*projected).sum()\\\\\\\\\\\\\\\\n                alpha-=f/derivative\\\\\\\\\\\\\\\\n                if abs(float(f))<2e-12:break\\\\\\\\\\\\\\\\n        ee=torch.linalg.eigvalsh(constant-alpha*C)\\\\\\\\\\\\\\\\n        f=energy+ee.abs().sum()-ee.sum()+.5*alpha.square()*off.square().sum()-gap_floor\\\\\\\\\\\\\\\\n        implicit_alpha=alpha-f/derivative\\\\\\\\\\\\\\\\n        off=off*implicit_alpha\\\\\\\\\\\\\\\\n    hp=constant-torch.einsum(\\\\\\\\\\\\\\\\\\\\'rb,rbp,rbq->pq\\\\\\\\\\\\\\\\\\\\',(w*off[:,None]).sum(-1),ut,ut)\\\\\\\\\\\\\\\\n    ev=torch.linalg.eigvalsh(hp)\\\\\\\\\\\\\\\\n    hq=torch.einsum(\\\\\\\\\\\\\\\\\\\\'j,jp,jq->pq\\\\\\\\\\\\\\\\\\\\',ev[perm],one,one)\\\\\\\\\\\\\\\\n    e1sq=(hq-hp).square().sum()\\\\\\\\\\\\\\\\n    lam1=ev.abs().sum()\\\\\\\\\\\\\\\\n    lam=lam1+.25*(w.abs().sum(1)+(off+w.sum(1)).abs()).square().sum()\\\\\\\\\\\\\\\\n    gap=energy+lam1-ev.sum()+.5*off.square().sum()\\\\\\\\\\\\\\\\n    effective=(gap*(2*lam-gap)).sqrt()\\\\\\\\\\\\\\\\n    return effective,e1sq,e2sq,gap,lam,w,off\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nzero=torch.zeros(size,device=\\\\\\\\\\\\\\\\\\\\'cpu\\\\\\\\\\\\\\\\\\\\');initial=quantities(zero)\\\\\\\\\\\\\\\\ninitial_values=[float(initial[i]) for i in range(5)]\\\\\\\\\\\\\\\\nif not a.fixed_gap:\\\\\\\\\\\\\\\\n    assert abs(initial_values[0]-base[\\\\\\\\\\\\\\\\\\\\'lambda_eff\\\\\\\\\\\\\\\\\\\\'])<1e-7\\\\\\\\\\\\\\\\n    assert abs(np.sqrt(initial_values[1])-base[\\\\\\\\\\\\\\\\\\\\'error_1\\\\\\\\\\\\\\\\\\\\'])<1e-8\\\\\\\\\\\\\\\\nassert abs(np.sqrt(initial_values[2])-base[\\\\\\\\\\\\\\\\\\\\'error_2\\\\\\\\\\\\\\\\\\\\'])<1e-8\\\\\\\\\\\\\\\\nprint(json.dumps({\\\\\\\\\\\\\\\\\\\\'event\\\\\\\\\\\\\\\\\\\\':\\\\\\\\\\\\\\\\\\\\'native_fixture_PASS\\\\\\\\\\\\\\\\\\\\',\\\\\\\\\\\\\\\\\\\\'initial\\\\\\\\\\\\\\\\\\\\':initial_values,\\\\\\\\\\\\\\\\\\\\'native\\\\\\\\\\\\\\\\\\\\':{k:float(base[k]) for k in (\\\\\\\\\\\\\\\\\\\\'lambda_eff\\\\\\\\\\\\\\\\\\\\',\\\\\\\\\\\\\\\\\\\\'error_1\\\\\\\\\\\\\\\\\\\\',\\\\\\\\\\\\\\\\\\\\'error_2\\\\\\\\\\\\\\\\\\\\',\\\\\\\\\\\\\\\\\\\\'E_gap\\\\\\\\\\\\\\\\\\\\')},\\\\\\\\\\\\\\\\\\\\'seconds\\\\\\\\\\\\\\\\\\\\':time.time()-start}),flush=True)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nclass Limit(Exception):pass\\\\\\\\\\\\\\\\ndef objective(flat_np,mu):\\\\\\\\\\\\\\\\n    global calls,best,best_z\\\\\\\\\\\\\\\\n    calls+=1\\\\\\\\\\\\\\\\n    if calls>a.evaluations:raise Limit\\\\\\\\\\\\\\\\n    flat=torch.tensor(flat_np,device=\\\\\\\\\\\\\\\\\\\\'cpu\\\\\\\\\\\\\\\\\\\\',requires_grad=True)\\\\\\\\\\\\\\\\n    lam,e1,e2,gap,Lam,_,_=quantities(flat)\\\\\\\\\\\\\\\\n    constraints=torch.stack([1-e1/e_cap**2,1-e2/e_cap**2] if a.fixed_gap else\\\\\\\\\\\\\\\\n                            [1-e1/e_cap**2,1-e2/e_cap**2,gap-gap_floor])\\\\\\\\\\\\\\\\n    valid=bool((constraints>0).all()) and (not a.fixed_gap or abs(float(gap.detach())-gap_floor)<2e-8)\\\\\\\\\\\\\\\\n    if valid:\\\\\\\\\\\\\\\\n        surrogate=lam\\\\\\\\\\\\\\\\n        if a.smooth_l1:\\\\\\\\\\\\\\\\n            ww,hh=quantities(flat)[-2:]\\\\\\\\\\\\\\\\n            eps=a.smooth_l1\\\\\\\\\\\\\\\\n            smooth=.25*(torch.sqrt(ww.square()+eps*eps).sum(1)+torch.sqrt((hh+ww.sum(1)).square()+eps*eps)).square().sum()\\\\\\\\\\\\\\\\n            exact=.25*(ww.abs().sum(1)+(hh+ww.sum(1)).abs()).square().sum()\\\\\\\\\\\\\\\\n            surrogate=(gap*(2*(Lam+smooth-exact)-gap)).sqrt()\\\\\\\\\\\\\\\\n        loss=surrogate.log()-mu*constraints.log().sum()\\\\\\\\\\\\\\\\n        if float(lam.detach())<best:\\\\\\\\\\\\\\\\n            best=float(lam.detach());best_z=flat_np.copy()\\\\\\\\\\\\\\\\n    else:\\\\\\\\\\\\\\\\n        loss=1000+1e5*torch.minimum(constraints,torch.zeros_like(constraints)).square().sum()\\\\\\\\\\\\\\\\n    loss.backward();grad=flat.grad.detach().cpu().numpy()\\\\\\\\\\\\\\\\n    if calls%25==0:\\\\\\\\\\\\\\\\n        rec={\\\\\\\\\\\\\\\\\\\\'call\\\\\\\\\\\\\\\\\\\\':calls,\\\\\\\\\\\\\\\\\\\\'lambda_eff\\\\\\\\\\\\\\\\\\\\':float(lam.detach()),\\\\\\\\\\\\\\\\\\\\'best\\\\\\\\\\\\\\\\\\\\':best,\\\\\\\\\\\\\\\\\\\\'error_1\\\\\\\\\\\\\\\\\\\\':float(e1.detach().sqrt()),\\\\\\\\\\\\\\\\n             \\\\\\\\\\\\\\\\\\\\'error_2\\\\\\\\\\\\\\\\\\\\':float(e2.detach().sqrt()),\\\\\\\\\\\\\\\\\\\\'gap\\\\\\\\\\\\\\\\\\\\':float(gap.detach()),\\\\\\\\\\\\\\\\\\\\'mu\\\\\\\\\\\\\\\\\\\\':mu,\\\\\\\\\\\\\\\\\\\\'seconds\\\\\\\\\\\\\\\\\\\\':time.time()-start}\\\\\\\\\\\\\\\\n        history.append(rec);print(json.dumps(rec),flush=True)\\\\\\\\\\\\\\\\n        np.save(a.out/\\\\\\\\\\\\\\\\\\\\'best_coordinates.npy\\\\\\\\\\\\\\\\\\\\',best_z)\\\\\\\\\\\\\\\\n        (a.out/\\\\\\\\\\\\\\\\\\\\'history.json\\\\\\\\\\\\\\\\\\\\').write_text(json.dumps(history,indent=2))\\\\\\\\\\\\\\\\n    return float(loss.detach()),grad\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nif a.fixed_gap:\\\\\\\\\\\\\\\\n    torch.manual_seed(20261029)\\\\\\\\\\\\\\\\n    probe=torch.randn(size,device=\\\\\\\\\\\\\\\\\\\\'cpu\\\\\\\\\\\\\\\\\\\\');probe/=probe.norm()\\\\\\\\\\\\\\\\n    # Check away from the exact L1 kinks of a sparse optimized gauge.\\\\\\\\\\\\\\\\n    center=1e-3*probe\\\\\\\\\\\\\\\\n    point=center.detach().clone().requires_grad_(True)\\\\\\\\\\\\\\\\n    def smooth_probe(x):\\\\\\\\\\\\\\\\n        v=quantities(x)\\\\\\\\\\\\\\\\n        return v[1]+v[2]+v[3]+1e-4*(torch.sqrt(v[-2].square()+1e-8).sum()+torch.sqrt(v[-1].square()+1e-8).sum())\\\\\\\\\\\\\\\\n    val=smooth_probe(point);val.backward();analytic=float(point.grad@probe)\\\\\\\\\\\\\\\\n    with torch.no_grad():fd=float((smooth_probe(center+1e-6*probe)-smooth_probe(center-1e-6*probe))/2e-6)\\\\\\\\\\\\\\\\n    assert abs(fd-analytic)<1e-5*max(1.,abs(analytic)),(fd,analytic)\\\\\\\\\\\\\\\\n    print(json.dumps({\\\\\\\\\\\\\\\\\\\\'implicit_gap_gradient\\\\\\\\\\\\\\\\\\\\':\\\\\\\\\\\\\\\\\\\\'PASS\\\\\\\\\\\\\\\\\\\\',\\\\\\\\\\\\\\\\\\\\'analytic\\\\\\\\\\\\\\\\\\\\':analytic,\\\\\\\\\\\\\\\\\\\\'finite_difference\\\\\\\\\\\\\\\\\\\\':fd}),flush=True)\\\\\\\\\\\\\\\\ncurrent=np.zeros(size)\\\\\\\\\\\\\\\\ntry:\\\\\\\\\\\\\\\\n    for mu in (1e-5,1e-6,1e-7):\\\\\\\\\\\\\\\\n        opt=minimize(lambda x:objective(x,mu),current,jac=True,method=\\\\\\\\\\\\\\\\\\\\'L-BFGS-B\\\\\\\\\\\\\\\\\\\\',\\\\\\\\\\\\\\\\n                     options={\\\\\\\\\\\\\\\\\\\\'maxiter\\\\\\\\\\\\\\\\\\\\':a.iterations,\\\\\\\\\\\\\\\\\\\\'maxcor\\\\\\\\\\\\\\\\\\\\':30,\\\\\\\\\\\\\\\\\\\\'ftol\\\\\\\\\\\\\\\\\\\\':1e-15 if a.fixed_gap else 1e-13,\\\\\\\\\\\\\\\\\\\\'gtol\\\\\\\\\\\\\\\\\\\\':1e-9,\\\\\\\\\\\\\\\\\\\\'maxls\\\\\\\\\\\\\\\\\\\\':30})\\\\\\\\\\\\\\\\n        current=opt.x.copy()\\\\\\\\\\\\\\\\nexcept Limit:print(\\\\\\\\\\\\\\\\\\\\'evaluation budget reached\\\\\\\\\\\\\\\\\\\\',flush=True)\\\\\\\\\\\\\\\\nwith torch.no_grad():\\\\\\\\\\\\\\\\n    got=quantities(torch.tensor(best_z,device=\\\\\\\\\\\\\\\\\\\\'cpu\\\\\\\\\\\\\\\\\\\\'));w,off=got[-2:]\\\\\\\\\\\\\\\\n    result=dict(z);result[\\\\\\\\\\\\\\\\\\\\'W\\\\\\\\\\\\\\\\\\\\']=w.cpu().numpy();result[\\\\\\\\\\\\\\\\\\\\'H2_I\\\\\\\\\\\\\\\\\\\\']=(off+w.sum(1)).cpu().numpy();result[\\\\\\\\\\\\\\\\\\\\'offset_W\\\\\\\\\\\\\\\\\\\\']=off.cpu().numpy()\\\\\\\\\\\\\\\\nnp.savez(a.out/\\\\\\\\\\\\\\\\\\\\'submission.npz\\\\\\\\\\\\\\\\\\\\',**result)\\\\\\\\\\\\\\\\nnative=V.evaluate_words(V.load_inputs(a.out/\\\\\\\\\\\\\\\\\\\\'submission.npz\\\\\\\\\\\\\\\\\\\\'),result[\\\\\\\\\\\\\\\\\\\\'angle_words\\\\\\\\\\\\\\\\\\\\'],result[\\\\\\\\\\\\\\\\\\\\'tree_edges\\\\\\\\\\\\\\\\\\\\'],int(result[\\\\\\\\\\\\\\\\\\\\'brot\\\\\\\\\\\\\\\\\\\\']))\\\\\\\\\\\\\\\\nreport={\\\\\\\\\\\\\\\\\\\\'status\\\\\\\\\\\\\\\\\\\\':\\\\\\\\\\\\\\\\\\\\'numerical_candidate\\\\\\\\\\\\\\\\\\\\',\\\\\\\\\\\\\\\\\\\\'before\\\\\\\\\\\\\\\\\\\\':{k:float(base[k]) for k in (\\\\\\\\\\\\\\\\\\\\'lambda_eff\\\\\\\\\\\\\\\\\\\\',\\\\\\\\\\\\\\\\\\\\'error_1\\\\\\\\\\\\\\\\\\\\',\\\\\\\\\\\\\\\\\\\\'error_2\\\\\\\\\\\\\\\\\\\\',\\\\\\\\\\\\\\\\\\\\'E_gap\\\\\\\\\\\\\\\\\\\\')},\\\\\\\\\\\\\\\\n        \\\\\\\\\\\\\\\\\\\\'after\\\\\\\\\\\\\\\\\\\\':{k:float(native[k]) for k in (\\\\\\\\\\\\\\\\\\\\'lambda_eff\\\\\\\\\\\\\\\\\\\\',\\\\\\\\\\\\\\\\\\\\'error_1\\\\\\\\\\\\\\\\\\\\',\\\\\\\\\\\\\\\\\\\\'error_2\\\\\\\\\\\\\\\\\\\\',\\\\\\\\\\\\\\\\\\\\'E_gap\\\\\\\\\\\\\\\\\\\\')},\\\\\\\\\\\\\\\\\\\\'calls\\\\\\\\\\\\\\\\\\\\':calls,\\\\\\\\\\\\\\\\\\\\'seconds\\\\\\\\\\\\\\\\\\\\':time.time()-start,\\\\\\\\\\\\\\\\n        \\\\\\\\\\\\\\\\\\\\'words_identical\\\\\\\\\\\\\\\\\\\\':bool(np.array_equal(result[\\\\\\\\\\\\\\\\\\\\'angle_words\\\\\\\\\\\\\\\\\\\\'],z[\\\\\\\\\\\\\\\\\\\\'angle_words\\\\\\\\\\\\\\\\\\\\']))}\\\\\\\\\\\\\\\\n(a.out/\\\\\\\\\\\\\\\\\\\\'report.json\\\\\\\\\\\\\\\\\\\\').write_text(json.dumps(report,indent=2));print(json.dumps(report),flush=True)\\\\\\\\\\\\\\\\n\\\\',encoding=\\\\'utf-8\\\\')\\\\\\\\np=SRC/\\\\'research_cpu/q8lib.py\\\\';p.parent.mkdir(parents=True,exist_ok=True);p.write_text(\\\\'\\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\"GPU helpers for 8-bit DF-THC research: target, Givens tree, word decoding, two-body error.\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nThe two-body error is the official error_2 (Frobenius norm of the shifted two-body residual),\\\\\\\\\\\\\\\\nevaluated in the orthonormal symmetric pair basis (2926 coordinates for N = 76).\\\\\\\\\\\\\\\\n\\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\\\\\\nfrom __future__ import annotations\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nimport math\\\\\\\\\\\\\\\\nimport os\\\\\\\\\\\\\\\\nimport pathlib\\\\\\\\\\\\\\\\nimport sys\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nimport numpy as np\\\\\\\\\\\\\\\\nimport torch\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nN = 76\\\\\\\\\\\\\\\\nCOMP = pathlib.Path(os.environ[\\\\\\\\\\\\\\\\\\\\'QCC_COMP_DIR\\\\\\\\\\\\\\\\\\\\'])\\\\\\\\\\\\\\\\nTARGET_CACHE = pathlib.Path(os.environ.get(\\\\\\\\\\\\\\\\\\\\'QCC_TARGET_CACHE\\\\\\\\\\\\\\\\\\\\', \\\\\\\\\\\\\\\\\\\\'outputs/search/target_ts64.npy\\\\\\\\\\\\\\\\\\\\')).resolve()\\\\\\\\\\\\\\\\nDEV = \\\\\\\\\\\\\\\\\\\\'cpu\\\\\\\\\\\\\\\\\\\\'\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ndef build_target64() -> np.ndarray:\\\\\\\\\\\\\\\\n    if TARGET_CACHE.exists():\\\\\\\\\\\\\\\\n        return np.load(TARGET_CACHE)\\\\\\\\\\\\\\\\n    sys.path.insert(0, str(COMP / \\\\\\\\\\\\\\\\\\\\'verifiers\\\\\\\\\\\\\\\\\\\\'))\\\\\\\\\\\\\\\\n    from dfthcsos.scoreinfra.dfthc_math import symmetric_from_lower\\\\\\\\\\\\\\\\n    from dfthcsos.scoreinfra.reference import load_fixed_shifts, load_reference\\\\\\\\\\\\\\\\n    base = COMP / \\\\\\\\\\\\\\\\\\\\'verifiers\\\\\\\\\\\\\\\\\\\\' / \\\\\\\\\\\\\\\\\\\\'dfthcsos\\\\\\\\\\\\\\\\\\\\'\\\\\\\\\\\\\\\\n    ref = load_reference(base / \\\\\\\\\\\\\\\\\\\\'FeMoCo76o113e.fcidump\\\\\\\\\\\\\\\\\\\\')\\\\\\\\\\\\\\\\n    shifts = load_fixed_shifts(base / \\\\\\\\\\\\\\\\\\\\'FeMoCo76o113e.fixed_shifts.npz\\\\\\\\\\\\\\\\\\\\')\\\\\\\\\\\\\\\\n    s = np.asarray(symmetric_from_lower(shifts[\\\\\\\\\\\\\\\\\\\\'Hsym_lower\\\\\\\\\\\\\\\\\\\\'], N), dtype=np.float64)\\\\\\\\\\\\\\\\n    t = np.asarray(ref[\\\\\\\\\\\\\\\\\\\\'tei\\\\\\\\\\\\\\\\\\\\'], dtype=np.float64).copy()\\\\\\\\\\\\\\\\n    d = np.arange(N)\\\\\\\\\\\\\\\\n    t[:, :, d, d] += 0.5 * s[:, :, None]\\\\\\\\\\\\\\\\n    t[d, d, :, :] += 0.5 * s[None, :, :]\\\\\\\\\\\\\\\\n    rows, cols = np.tril_indices(N)\\\\\\\\\\\\\\\\n    scale = np.where(rows == cols, 1.0, math.sqrt(2.0))\\\\\\\\\\\\\\\\n    pairs = rows * N + cols\\\\\\\\\\\\\\\\n    ts = t.reshape(N * N, N * N)[np.ix_(pairs, pairs)] * np.outer(scale, scale)\\\\\\\\\\\\\\\\n    np.save(TARGET_CACHE, ts)\\\\\\\\\\\\\\\\n    return ts\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nclass Pair:\\\\\\\\\\\\\\\\n    \\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\"Map unit vectors u (..., N) to symmetric pair coordinates of u u^T (..., 2926).\\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    def __init__(self, dev=DEV, dtype=torch.float64):\\\\\\\\\\\\\\\\n        rows, cols = np.tril_indices(N)\\\\\\\\\\\\\\\\n        self.ri = torch.tensor(rows, device=dev)\\\\\\\\\\\\\\\\n        self.ci = torch.tensor(cols, device=dev)\\\\\\\\\\\\\\\\n        self.scale = torch.tensor(np.where(rows == cols, 1.0, math.sqrt(2.0)), device=dev, dtype=dtype)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    def __call__(self, u):\\\\\\\\\\\\\\\\n        return u[..., self.ri] * u[..., self.ci] * self.scale\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nclass Tree:\\\\\\\\\\\\\\\\n    \\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\"Level-parallel Givens tree (official parent-before-child order): angles (units of pi) -> unit vectors.\\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    def __init__(self, edges, dev=DEV, dtype=torch.float64):\\\\\\\\\\\\\\\\n        edges = [(int(p), int(q)) for p, q in edges]\\\\\\\\\\\\\\\\n        self.edges = edges\\\\\\\\\\\\\\\\n        levels, cur, used = [], [], set()\\\\\\\\\\\\\\\\n        for t, (p, q) in enumerate(edges):\\\\\\\\\\\\\\\\n            if p in used or q in used:\\\\\\\\\\\\\\\\n                levels.append(cur)\\\\\\\\\\\\\\\\n                cur, used = [], set()\\\\\\\\\\\\\\\\n            cur.append(t)\\\\\\\\\\\\\\\\n            used.update((p, q))\\\\\\\\\\\\\\\\n        levels.append(cur)\\\\\\\\\\\\\\\\n        self.plan = []\\\\\\\\\\\\\\\\n        for level in levels:\\\\\\\\\\\\\\\\n            colmap = np.full(N, N - 1, dtype=np.int64)\\\\\\\\\\\\\\\\n            sgn = np.zeros(N)\\\\\\\\\\\\\\\\n            perm = np.arange(N)\\\\\\\\\\\\\\\\n            for t in level:\\\\\\\\\\\\\\\\n                p, q = edges[t]\\\\\\\\\\\\\\\\n                colmap[p] = colmap[q] = t\\\\\\\\\\\\\\\\n                sgn[p], sgn[q] = -1.0, 1.0\\\\\\\\\\\\\\\\n                perm[p], perm[q] = q, p\\\\\\\\\\\\\\\\n            self.plan.append((torch.tensor(colmap, device=dev), torch.tensor(sgn, device=dev, dtype=dtype),\\\\\\\\\\\\\\\\n                              torch.tensor(perm, device=dev)))\\\\\\\\\\\\\\\\n        self.dev, self.dtype = dev, dtype\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    def __call__(self, theta):\\\\\\\\\\\\\\\\n        \\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\"theta: (..., N-1) in units of pi.\\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\\\\\\n        shp = theta.shape[:-1]\\\\\\\\\\\\\\\\n        th = theta.reshape(-1, N - 1)\\\\\\\\\\\\\\\\n        k = th.shape[0]\\\\\\\\\\\\\\\\n        ang = math.pi * th\\\\\\\\\\\\\\\\n        one = torch.ones(k, 1, device=th.device, dtype=th.dtype)\\\\\\\\\\\\\\\\n        c = torch.cat([torch.cos(ang), one], dim=1)\\\\\\\\\\\\\\\\n        s = torch.cat([torch.sin(ang), 0 * one], dim=1)\\\\\\\\\\\\\\\\n        u = torch.zeros(k, N, device=th.device, dtype=th.dtype)\\\\\\\\\\\\\\\\n        u[:, 0] = 1.0\\\\\\\\\\\\\\\\n        for colmap, sgn, perm in self.plan:\\\\\\\\\\\\\\\\n            u = u * c[:, colmap] + u[:, perm] * (s[:, colmap] * sgn.to(th.dtype))\\\\\\\\\\\\\\\\n        return u.reshape(*shp, N)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ndef signed_words(words, brot):\\\\\\\\\\\\\\\\n    half = 1 << (brot - 1)\\\\\\\\\\\\\\\\n    return ((np.asarray(words, dtype=np.int64) + half) % (1 << brot)) - half\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ndef canonical_gauge_words(words, edges, brot):\\\\\\\\\\\\\\\\n    \\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\"Exactly preserve vector projectors while moving Givens words to the sign gauge.\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    Integer sign propagation, after marculera\\\\\\\\\\\\\\\\\\\\'s onebody.signed_gauge (Apache-2.0,\\\\\\\\\\\\\\\\n    kaggle.com/datasets/marculera/dfthc-merge-pipeline). Independent clipping or\\\\\\\\\\\\\\\\n    reduction modulo pi at every edge would change a subtree\\\\\\\\\\\\\\\\\\\\'s relative signs.\\\\\\\\\\\\\\\\n    \\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\\\\\\n    shape = np.asarray(words).shape\\\\\\\\\\\\\\\\n    edges = np.asarray(edges, dtype=np.int64)\\\\\\\\\\\\\\\\n    out = np.asarray(words, dtype=np.int64).reshape(-1, len(edges)).copy() % (1 << brot)\\\\\\\\\\\\\\\\n    mod, half, quarter = 1 << brot, 1 << (brot - 1), 1 << (brot - 2)\\\\\\\\\\\\\\\\n    signs = np.ones((len(out), len(edges) + 1), dtype=np.int8)\\\\\\\\\\\\\\\\n    for k in reversed(range(len(edges))):\\\\\\\\\\\\\\\\n        p, q = edges[k]\\\\\\\\\\\\\\\\n        angle = np.where(signs[:, p] != signs[:, q], -out[:, k], out[:, k]) % mod\\\\\\\\\\\\\\\\n        flip = (angle >= quarter) & (angle < 3 * quarter)\\\\\\\\\\\\\\\\n        out[:, k] = np.where(flip, (angle + half) % mod, angle)\\\\\\\\\\\\\\\\n        signs[flip, p] *= -1\\\\\\\\\\\\\\\\n        signs[:, q] = 1\\\\\\\\\\\\\\\\n    return out.reshape(shape)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ndef theta_of_words(words, brot):\\\\\\\\\\\\\\\\n    \\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\"Official convention: theta / pi = word / 2**(brot - 1) (mod 2).\\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\\\\\\n    return signed_words(words, brot).astype(np.float64) / (1 << (brot - 1))\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ndef gauge_angles(u, edges):\\\\\\\\\\\\\\\\n    \\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\"Continuous angles (units of pi) of unit vectors in the signed half-open gauge, reproducing +-u.\\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\\\\\\n    a = np.array(u, dtype=np.float64, copy=True)\\\\\\\\\\\\\\\\n    ang = np.zeros((a.shape[0], len(edges)))\\\\\\\\\\\\\\\\n    for j in reversed(range(len(edges))):\\\\\\\\\\\\\\\\n        p, q = edges[j]\\\\\\\\\\\\\\\\n        norm = np.hypot(a[:, p], a[:, q])\\\\\\\\\\\\\\\\n        sign = np.where(np.abs(a[:, p]) < 1e-12, np.where(a[:, q] > 0, -1.0, 1.0), np.where(a[:, p] < 0, -1.0, 1.0))\\\\\\\\\\\\\\\\n        ang[:, j] = np.where(norm < 1e-12, 0.0, np.arctan2(a[:, q] * sign, a[:, p] * sign))\\\\\\\\\\\\\\\\n        a[:, p] = np.where(norm < 1e-12, 0.0, norm * sign)\\\\\\\\\\\\\\\\n        a[:, q] = 0.0\\\\\\\\\\\\\\\\n    return ang / np.pi\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nclass TwoBody:\\\\\\\\\\\\\\\\n    \\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\"error_2 = || sum_{r,c} x_rc x_rc^T - T ||_F with x_rc = sum_b w_rbc p(u_rb).\\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    def __init__(self, dev=DEV, dtype=torch.float64):\\\\\\\\\\\\\\\\n        self.T = torch.tensor(build_target64(), device=dev, dtype=dtype)\\\\\\\\\\\\\\\\n        self.pair = Pair(dev, dtype)\\\\\\\\\\\\\\\\n        self.dev, self.dtype = dev, dtype\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    def X(self, U, w):\\\\\\\\\\\\\\\\n        v = self.pair(U)                                  # (R, B, P)\\\\\\\\\\\\\\\\n        return torch.einsum(\\\\\\\\\\\\\\\\\\\\'rbm,rbc->rcm\\\\\\\\\\\\\\\\\\\\', v, w).reshape(-1, v.shape[-1])   # (R*C, P)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    def resid(self, U, w):\\\\\\\\\\\\\\\\n        a = self.X(U, w)\\\\\\\\\\\\\\\\n        return a.T @ a - self.T\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    def err(self, U, w):\\\\\\\\\\\\\\\\n        e = self.resid(U, w)\\\\\\\\\\\\\\\\n        return torch.sqrt((e * e).sum())\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ndef load_submission(path):\\\\\\\\\\\\\\\\n    z = np.load(path)\\\\\\\\\\\\\\\\n    out = {k: np.array(z[k]) for k in z.files}\\\\\\\\\\\\\\\\n    return out\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ndef dpen(w):\\\\\\\\\\\\\\\\n    a = w.abs().sum(dim=1)\\\\\\\\\\\\\\\\n    s = w.sum(dim=1)\\\\\\\\\\\\\\\\n    return 0.5 * (a * a - s * s).sum()\\\\\\\\\\\\\\\\n\\\\',encoding=\\\\'utf-8\\\\')\\\\\\\\np=SRC/\\\\'verify_reachable.py\\\\';p.parent.mkdir(parents=True,exist_ok=True);p.write_text(\\\\'\\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\"Exact host-domain ANGLE proof, all addresses and independent HMR outcomes.\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nSPDX-License-Identifier: Apache-2.0\\\\\\\\\\\\\\\\nAdapted from mrmeows\\\\\\\\\\\\\\\\\\\\' Apache-2.0 audit_affine_hmr.py. Ahmed Berat Ozer:\\\\\\\\\\\\\\\\nreachable-domain initialization, both traversals, hash-bound certificates.\\\\\\\\\\\\\\\\nThe address is fixed symbolically across a bit-packed vector of all valid\\\\\\\\\\\\\\\\naddresses; each measurement contributes an independent linear phase mask.\\\\\\\\\\\\\\\\n\\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\\\\\\nimport argparse\\\\\\\\\\\\\\\\nimport hashlib\\\\\\\\\\\\\\\\nimport json\\\\\\\\\\\\\\\\nfrom pathlib import Path\\\\\\\\\\\\\\\\nimport time\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nimport numpy as np\\\\\\\\\\\\\\\\nimport kickmix as km\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nHOST = \\\\\\\\\\\\\\\\\\\\'https://www.kaggle.com/competitions/google-verifiable-quantum-circuit-compilation/discussion/753092\\\\\\\\\\\\\\\\\\\\'\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ndef packed(bits):\\\\\\\\\\\\\\\\n    return int.from_bytes(np.packbits(np.asarray(bits, np.uint8), bitorder=\\\\\\\\\\\\\\\\\\\\'little\\\\\\\\\\\\\\\\\\\\').tobytes(), \\\\\\\\\\\\\\\\\\\\'little\\\\\\\\\\\\\\\\\\\\')\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ndef prove(text, initial, expected, nq):\\\\\\\\\\\\\\\\n    count, words = initial.shape\\\\\\\\\\\\\\\\n    assert expected.shape == initial.shape and words == 5\\\\\\\\\\\\\\\\n    n = (count - 1).bit_length()\\\\\\\\\\\\\\\\n    full = (1 << count) - 1\\\\\\\\\\\\\\\\n    values = [0] * nq\\\\\\\\\\\\\\\\n    for i in range(n): values[i] = packed((np.arange(count) >> i) & 1)\\\\\\\\\\\\\\\\n    addresses = values[:n].copy()\\\\\\\\\\\\\\\\n    for j in range(words):\\\\\\\\\\\\\\\\n        for bit in range(8): values[n + 8*j + bit] = packed((initial[:, j] >> bit) & 1)\\\\\\\\\\\\\\\\n    phase = []\\\\\\\\\\\\\\\\n    classical = {}\\\\\\\\\\\\\\\\n    ccx = 0\\\\\\\\\\\\\\\\n    for line in text.splitlines():\\\\\\\\\\\\\\\\n        fields = line.split()\\\\\\\\\\\\\\\\n        if not fields: continue\\\\\\\\\\\\\\\\n        name = fields[0]\\\\\\\\\\\\\\\\n        if name in (\\\\\\\\\\\\\\\\\\\\'REGISTER\\\\\\\\\\\\\\\\\\\\', \\\\\\\\\\\\\\\\\\\\'APPEND_TO_REGISTER\\\\\\\\\\\\\\\\\\\\'): continue\\\\\\\\\\\\\\\\n        condition = None\\\\\\\\\\\\\\\\n        if \\\\\\\\\\\\\\\\\\\\'if\\\\\\\\\\\\\\\\\\\\' in fields:\\\\\\\\\\\\\\\\n            index = fields.index(\\\\\\\\\\\\\\\\\\\\'if\\\\\\\\\\\\\\\\\\\\')\\\\\\\\\\\\\\\\n            assert len(fields) == index + 2\\\\\\\\\\\\\\\\n            condition = fields[index+1]\\\\\\\\\\\\\\\\n            fields = fields[:index]\\\\\\\\\\\\\\\\n        ids = [int(q[1:]) for q in fields[1:] if q.startswith(\\\\\\\\\\\\\\\\\\\\'q\\\\\\\\\\\\\\\\\\\\')]\\\\\\\\\\\\\\\\n        if name not in (\\\\\\\\\\\\\\\\\\\\'CZ\\\\\\\\\\\\\\\\\\\\', \\\\\\\\\\\\\\\\\\\\'Z\\\\\\\\\\\\\\\\\\\\', \\\\\\\\\\\\\\\\\\\\'NEG\\\\\\\\\\\\\\\\\\\\'):\\\\\\\\\\\\\\\\n            assert condition is None, (\\\\\\\\\\\\\\\\\\\\'unsupported conditioned value gate\\\\\\\\\\\\\\\\\\\\', line)\\\\\\\\\\\\\\\\n        if name == \\\\\\\\\\\\\\\\\\\\'X\\\\\\\\\\\\\\\\\\\\':\\\\\\\\\\\\\\\\n            q, = ids; values[q] ^= full\\\\\\\\\\\\\\\\n        elif name == \\\\\\\\\\\\\\\\\\\\'CX\\\\\\\\\\\\\\\\\\\\':\\\\\\\\\\\\\\\\n            a, b = ids; values[b] ^= values[a]\\\\\\\\\\\\\\\\n        elif name == \\\\\\\\\\\\\\\\\\\\'CCX\\\\\\\\\\\\\\\\\\\\':\\\\\\\\\\\\\\\\n            a, b, c = ids; values[c] ^= values[a] & values[b]; ccx += 1\\\\\\\\\\\\\\\\n        elif name == \\\\\\\\\\\\\\\\\\\\'HMR\\\\\\\\\\\\\\\\\\\\':\\\\\\\\\\\\\\\\n            q, = ids\\\\\\\\\\\\\\\\n            bit = next(x for x in fields[1:] if x.startswith(\\\\\\\\\\\\\\\\\\\\'b\\\\\\\\\\\\\\\\\\\\'))\\\\\\\\\\\\\\\\n            classical[bit] = len(phase)\\\\\\\\\\\\\\\\n            phase.append(values[q])\\\\\\\\\\\\\\\\n            values[q] = 0\\\\\\\\\\\\\\\\n        elif name == \\\\\\\\\\\\\\\\\\\\'R\\\\\\\\\\\\\\\\\\\\':\\\\\\\\\\\\\\\\n            q, = ids; assert values[q] == 0, (\\\\\\\\\\\\\\\\\\\\'discarded information\\\\\\\\\\\\\\\\\\\\', line)\\\\\\\\\\\\\\\\n        elif name in (\\\\\\\\\\\\\\\\\\\\'CZ\\\\\\\\\\\\\\\\\\\\', \\\\\\\\\\\\\\\\\\\\'Z\\\\\\\\\\\\\\\\\\\\', \\\\\\\\\\\\\\\\\\\\'NEG\\\\\\\\\\\\\\\\\\\\'):\\\\\\\\\\\\\\\\n            assert condition in classical, (\\\\\\\\\\\\\\\\\\\\'unsupported phase condition\\\\\\\\\\\\\\\\\\\\', line)\\\\\\\\\\\\\\\\n            correction = full\\\\\\\\\\\\\\\\n            for q in ids: correction &= values[q]\\\\\\\\\\\\\\\\n            phase[classical[condition]] ^= correction\\\\\\\\\\\\\\\\n        else:\\\\\\\\\\\\\\\\n            raise AssertionError((\\\\\\\\\\\\\\\\\\\\'unsupported instruction\\\\\\\\\\\\\\\\\\\\', line))\\\\\\\\\\\\\\\\n    assert values[:n] == addresses, \\\\\\\\\\\\\\\\\\\\'selection changed\\\\\\\\\\\\\\\\\\\\'\\\\\\\\\\\\\\\\n    for j in range(words):\\\\\\\\\\\\\\\\n        for bit in range(8):\\\\\\\\\\\\\\\\n            assert values[n+8*j+bit] == packed((expected[:, j] >> bit) & 1), (\\\\\\\\\\\\\\\\\\\\'wrong reachable word\\\\\\\\\\\\\\\\\\\\', j, bit)\\\\\\\\\\\\\\\\n    assert not any(values[n+8*words:]), \\\\\\\\\\\\\\\\\\\\'dirty scratch\\\\\\\\\\\\\\\\\\\\'\\\\\\\\\\\\\\\\n    assert not any(phase), \\\\\\\\\\\\\\\\\\\\'measurement phase is not paid for every outcome\\\\\\\\\\\\\\\\\\\\'\\\\\\\\\\\\\\\\n    return dict(status=\\\\\\\\\\\\\\\\\\\\'PASS\\\\\\\\\\\\\\\\\\\\', all_addresses=count, independent_HMR_outcomes=len(phase),\\\\\\\\\\\\\\\\n                all_measurement_assignments=f\\\\\\\\\\\\\\\\\\\\'2^{len(phase)}\\\\\\\\\\\\\\\\\\\\', zero_phase_every_outcome=True,\\\\\\\\\\\\\\\\n                selection_restored=True, scratch_zero=True, CCX=ccx, Q=nq)\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ndef verify(folder, out):\\\\\\\\\\\\\\\\n    from dfthcsos.scoreinfra.circuits import register_layout\\\\\\\\\\\\\\\\n    started = time.time()\\\\\\\\\\\\\\\\n    with np.load(folder/\\\\\\\\\\\\\\\\\\\\'submission.npz\\\\\\\\\\\\\\\\\\\\', allow_pickle=False) as z:\\\\\\\\\\\\\\\\n        words = np.asarray(z[\\\\\\\\\\\\\\\\\\\\'angle_words\\\\\\\\\\\\\\\\\\\\'], dtype=np.int64)\\\\\\\\\\\\\\\\n    assert words.shape == (1220, 75)\\\\\\\\\\\\\\\\n    batches = words.reshape(len(words), 15, 5)\\\\\\\\\\\\\\\\n    report = dict(status=\\\\\\\\\\\\\\\\\\\\'RUNNING\\\\\\\\\\\\\\\\\\\\', contract=\\\\\\\\\\\\\\\\\\\\'official reachable forward/reverse states\\\\\\\\\\\\\\\\\\\\',\\\\\\\\\\\\\\\\n                  host_clarification=HOST, arbitrary_target_claim=False, circuits=[])\\\\\\\\\\\\\\\\n    for k in range(15):\\\\\\\\\\\\\\\\n        file = folder/f\\\\\\\\\\\\\\\\\\\\'angle_k_{k}.kmb\\\\\\\\\\\\\\\\\\\\'\\\\\\\\\\\\\\\\n        c = km.Circuit.from_file(file, format=\\\\\\\\\\\\\\\\\\\\'kmb\\\\\\\\\\\\\\\\\\\\')\\\\\\\\\\\\\\\\n        layout = register_layout([c])\\\\\\\\\\\\\\\\n        live = [q.id for q in layout.selection] + [q.id for w in layout.words for q in w]\\\\\\\\\\\\\\\\n        assert live == list(range(51)), \\\\\\\\\\\\\\\\\\\\'unexpected declared register layout\\\\\\\\\\\\\\\\\\\\'\\\\\\\\\\\\\\\\n        previous = np.zeros_like(batches[:, k]) if k == 0 else batches[:, k-1]\\\\\\\\\\\\\\\\n        current = batches[:, k]\\\\\\\\\\\\\\\\n        forward = prove(str(c), previous, current, c.num_qubits)\\\\\\\\\\\\\\\\n        reverse = prove(str(c), current, previous, c.num_qubits)\\\\\\\\\\\\\\\\n        row = dict(batch=k, sha256=hashlib.sha256(file.read_bytes()).hexdigest(),\\\\\\\\\\\\\\\\n                   forward=forward, reverse=reverse)\\\\\\\\\\\\\\\\n        report[\\\\\\\\\\\\\\\\\\\\'circuits\\\\\\\\\\\\\\\\\\\\'].append(row)\\\\\\\\\\\\\\\\n        out.write_text(json.dumps(report, indent=2))\\\\\\\\\\\\\\\\n        print(json.dumps(dict(batch=k, forward=\\\\\\\\\\\\\\\\\\\\'PASS\\\\\\\\\\\\\\\\\\\\', reverse=\\\\\\\\\\\\\\\\\\\\'PASS\\\\\\\\\\\\\\\\\\\\', Q=c.num_qubits,\\\\\\\\\\\\\\\\n                             T=c.operation_statistics().num_toffoli_like)), flush=True)\\\\\\\\\\\\\\\\n    report.update(status=\\\\\\\\\\\\\\\\\\\\'PASS\\\\\\\\\\\\\\\\\\\\', seconds=time.time()-started)\\\\\\\\\\\\\\\\n    out.write_text(json.dumps(report, indent=2))\\\\\\\\\\\\\\\\n    return report\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nif __name__ == \\\\\\\\\\\\\\\\\\\\'__main__\\\\\\\\\\\\\\\\\\\\':\\\\\\\\\\\\\\\\n    p = argparse.ArgumentParser(); p.add_argument(\\\\\\\\\\\\\\\\\\\\'folder\\\\\\\\\\\\\\\\\\\\', type=Path); p.add_argument(\\\\\\\\\\\\\\\\\\\\'out\\\\\\\\\\\\\\\\\\\\', type=Path)\\\\\\\\\\\\\\\\n    a = p.parse_args(); result = verify(a.folder, a.out)\\\\\\\\\\\\\\\\n    print(json.dumps(dict(status=result[\\\\\\\\\\\\\\\\\\\\'status\\\\\\\\\\\\\\\\\\\\'], seconds=result[\\\\\\\\\\\\\\\\\\\\'seconds\\\\\\\\\\\\\\\\\\\\'])), flush=True)\\\\\\\\\\\\\\\\n\\\\',encoding=\\\\'utf-8\\\\')\\\\\\\\n(SRC/\\\\'metric_preflight.py\\\\').write_text(\\\\'\\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\"Official Kaggle metric v10 readers, unchanged except formatting.\\\\\\\\\\\\\\\\nSource: https://www.kaggle.com/code/metric/google-quantum-ai-metric\\\\\\\\\\\\\\\\nAdapter preflight_directory only checks the file contract; task verification is separate.\\\\\\\\\\\\\\\\n\\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\\\\\\nimport json\\\\\\\\\\\\\\\\nimport math\\\\\\\\\\\\\\\\nimport pathlib\\\\\\\\\\\\\\\\nimport random\\\\\\\\\\\\\\\\nimport stat\\\\\\\\\\\\\\\\nimport sys\\\\\\\\\\\\\\\\nimport time\\\\\\\\\\\\\\\\nimport tokenize\\\\\\\\\\\\\\\\nimport zipfile\\\\\\\\\\\\\\\\nimport zlib\\\\\\\\\\\\\\\\nfrom collections.abc import Callable, Mapping\\\\\\\\\\\\\\\\nfrom typing import Any\\\\\\\\\\\\\\\\nimport numpy as np\\\\\\\\\\\\\\\\nimport pandas as pd\\\\\\\\\\\\\\\\nALLOWED_INSTRUCTIONS = {\\\\\\\\\\\\\\\\\\\\'X\\\\\\\\\\\\\\\\\\\\', \\\\\\\\\\\\\\\\\\\\'CX\\\\\\\\\\\\\\\\\\\\', \\\\\\\\\\\\\\\\\\\\'CCX\\\\\\\\\\\\\\\\\\\\', \\\\\\\\\\\\\\\\\\\\'Z\\\\\\\\\\\\\\\\\\\\', \\\\\\\\\\\\\\\\\\\\'CZ\\\\\\\\\\\\\\\\\\\\', \\\\\\\\\\\\\\\\\\\\'CCZ\\\\\\\\\\\\\\\\\\\\', \\\\\\\\\\\\\\\\\\\\'Z_POW\\\\\\\\\\\\\\\\\\\\', \\\\\\\\\\\\\\\\\\\\'NEG\\\\\\\\\\\\\\\\\\\\', \\\\\\\\\\\\\\\\\\\\'SWAP\\\\\\\\\\\\\\\\\\\\', \\\\\\\\\\\\\\\\\\\\'CSWAP\\\\\\\\\\\\\\\\\\\\', \\\\\\\\\\\\\\\\\\\\'R\\\\\\\\\\\\\\\\\\\\', \\\\\\\\\\\\\\\\\\\\'HMR\\\\\\\\\\\\\\\\\\\\', \\\\\\\\\\\\\\\\\\\\'BIT_INVERT\\\\\\\\\\\\\\\\\\\\', \\\\\\\\\\\\\\\\\\\\'BIT_STORE0\\\\\\\\\\\\\\\\\\\\', \\\\\\\\\\\\\\\\\\\\'BIT_STORE1\\\\\\\\\\\\\\\\\\\\', \\\\\\\\\\\\\\\\\\\\'PUSH_CONDITION\\\\\\\\\\\\\\\\\\\\', \\\\\\\\\\\\\\\\\\\\'POP_CONDITION\\\\\\\\\\\\\\\\\\\\', \\\\\\\\\\\\\\\\\\\\'INFO_TAG\\\\\\\\\\\\\\\\\\\\', \\\\\\\\\\\\\\\\\\\\'DEBUG_PRINT\\\\\\\\\\\\\\\\\\\\'}\\\\\\\\\\\\\\\\nMAX_QUBIT_OR_BIT_ID = 2 ** 30 // 1536\\\\\\\\\\\\\\\\nMAX_NPZ_BYTES = 2 ** 26\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\nclass ParticipantVisibleError(Exception):\\\\\\\\\\\\\\\\n    pass\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ndef read_circuit(path: pathlib.Path, max_registers: int) -> Any:\\\\\\\\\\\\\\\\n    \\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\"Return a submitted .kmx or .kmb circuit as a kickmix.Circuit; raise ValueError unless it is fit to verify.\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    kickmix validates a file as it parses it, within limits that keep parsing cheap, but simulating\\\\\\\\\\\\\\\\n    takes memory that grows with the largest qubit and bit ids, which kickmix allows up to ~5e8,\\\\\\\\\\\\\\\\n    so those are capped at MAX_QUBIT_OR_BIT_ID. kickmix also allows a million registers, at\\\\\\\\\\\\\\\\n    ~110 bytes each even if empty, so a circuit may have at most `max_registers`, the most its\\\\\\\\\\\\\\\\n    benchmark needs. Every register must be named: the dfthcsos verifier crashes on an unnamed one.\\\\\\\\\\\\\\\\n    \\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\\\\\\n    import kickmix\\\\\\\\\\\\\\\\n    circuit = kickmix.Circuit.from_file(path, format=path.suffix.removeprefix(\\\\\\\\\\\\\\\\\\\\'.\\\\\\\\\\\\\\\\\\\\'))\\\\\\\\\\\\\\\\n    unsupported = set(circuit.operation_statistics()) - ALLOWED_INSTRUCTIONS\\\\\\\\\\\\\\\\n    if unsupported:\\\\\\\\\\\\\\\\n        raise ValueError(f\\\\\\\\\\\\\\\\\\\\'unsupported instructions {sorted(unsupported)}\\\\\\\\\\\\\\\\\\\\')\\\\\\\\\\\\\\\\n    largest_id = max(circuit.num_qubits, circuit.num_bits) - 1\\\\\\\\\\\\\\\\n    if largest_id >= MAX_QUBIT_OR_BIT_ID:\\\\\\\\\\\\\\\\n        raise ValueError(f\\\\\\\\\\\\\\\\\\\\'qubit or bit id {largest_id} is above the limit of {MAX_QUBIT_OR_BIT_ID - 1}\\\\\\\\\\\\\\\\\\\\')\\\\\\\\\\\\\\\\n    if circuit.num_registers > max_registers:\\\\\\\\\\\\\\\\n        raise ValueError(f\\\\\\\\\\\\\\\\\\\\'{circuit.num_registers} registers, above the limit of {max_registers} for this benchmark\\\\\\\\\\\\\\\\\\\\')\\\\\\\\\\\\\\\\n    if not all((isinstance(name, str) for name in circuit.register_data)):\\\\\\\\\\\\\\\\n        raise ValueError(\\\\\\\\\\\\\\\\\\\\'every register needs a name, given by its REGISTER line\\\\\\\\\\\\\\\\\\\\')\\\\\\\\\\\\\\\\n    return circuit\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ndef read_npz(path: pathlib.Path, spec: Mapping[str, tuple[str, tuple[int | str, ...]]]) -> dict[str, np.ndarray]:\\\\\\\\\\\\\\\\n    \\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\"Return the arrays `spec` names from an .npz; raise ValueError unless each is a plain number array as specified.\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    `spec` maps each key to the numpy dtype kinds it may have, such as \\\\\\\\\\\\\\\\\\\\'f\\\\\\\\\\\\\\\\\\\\' for floats, and its shape,\\\\\\\\\\\\\\\\n    in which a string names a dimension of any positive size that must agree wherever it recurs.\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n    Each array\\\\\\\\\\\\\\\\\\\\'s header is a Python literal of its dtype and shape, which np.load trusts: a few KB\\\\\\\\\\\\\\\\n    of deflated zeros can claim a terabyte-sized array, and the dtype can be anything numpy can\\\\\\\\\\\\\\\\n    describe, from structured and nested types to Python objects that need unpickling. So the\\\\\\\\\\\\\\\\n    headers are read first, and the arrays loaded only if each is a plain number type of its kind,\\\\\\\\\\\\\\\\n    not big-endian, with its shape, and they total at most MAX_NPZ_BYTES. Only format 1.0 headers,\\\\\\\\\\\\\\\\n    which numpy.savez writes, are accepted, and numpy refuses any over 10 KB before parsing it.\\\\\\\\\\\\\\\\n    \\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\\\\\\n    dimensions: dict[str, int] = {}\\\\\\\\\\\\\\\\n    total = 0\\\\\\\\\\\\\\\\n    with zipfile.ZipFile(path) as archive:\\\\\\\\\\\\\\\\n        members = {name.removesuffix(\\\\\\\\\\\\\\\\\\\\'.npy\\\\\\\\\\\\\\\\\\\\'): name for name in archive.namelist()}\\\\\\\\\\\\\\\\n        missing = [key for key in spec if key not in members]\\\\\\\\\\\\\\\\n        if missing:\\\\\\\\\\\\\\\\n            raise ValueError(f\\\\\\\\\\\\\\\\\\\\'{path.name} has no {missing}\\\\\\\\\\\\\\\\\\\\')\\\\\\\\\\\\\\\\n        for key, (kinds, expected_shape) in spec.items():\\\\\\\\\\\\\\\\n            with archive.open(members[key]) as member:\\\\\\\\\\\\\\\\n                if np.lib.format.read_magic(member) != (1, 0):\\\\\\\\\\\\\\\\n                    raise ValueError(f\\\\\\\\\\\\\\\\\\\\'{key} in {path.name} is not in .npy format 1.0, which numpy.savez writes\\\\\\\\\\\\\\\\\\\\')\\\\\\\\\\\\\\\\n                shape, _, dtype = np.lib.format.read_array_header_1_0(member)\\\\\\\\\\\\\\\\n            if dtype.kind not in kinds or dtype.names is not None or dtype.subdtype is not None or (dtype.byteorder == \\\\\\\\\\\\\\\\\\\\'>\\\\\\\\\\\\\\\\\\\\'):\\\\\\\\\\\\\\\\n                raise ValueError(f\\\\\\\\\\\\\\\\\\\\'{key} in {path.name} has dtype {dtype}, not a plain number type of numpy kind {kinds!r}\\\\\\\\\\\\\\\\\\\\')\\\\\\\\\\\\\\\\n            matches = len(shape) == len(expected_shape) and all((size > 0 and size == (dimensions.setdefault(expected, size) if isinstance(expected, str) else expected) for size, expected in zip(shape, expected_shape, strict=True)))\\\\\\\\\\\\\\\\n            if not matches:\\\\\\\\\\\\\\\\n                raise ValueError(f\\\\\\\\\\\\\\\\\\\\'{key} in {path.name} has shape {shape}, not {expected_shape} with its named dimensions as in {dimensions}\\\\\\\\\\\\\\\\\\\\')\\\\\\\\\\\\\\\\n            total += math.prod(shape) * dtype.itemsize\\\\\\\\\\\\\\\\n    if total > MAX_NPZ_BYTES:\\\\\\\\\\\\\\\\n        raise ValueError(f\\\\\\\\\\\\\\\\\\\\'the arrays in {path.name} take {total:,} bytes, above the limit of {MAX_NPZ_BYTES:,}\\\\\\\\\\\\\\\\\\\\')\\\\\\\\\\\\\\\\n    with np.load(path, allow_pickle=False) as npz:\\\\\\\\\\\\\\\\n        return {key: np.array(npz[key]) for key in spec}\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ndef find_one(root: pathlib.Path, name: str, description: str, is_dir: bool=False) -> pathlib.Path:\\\\\\\\\\\\\\\\n    \\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\"The one path called `name` (a glob) under `root`, where the submission unpacked; raise ParticipantVisibleError otherwise.\\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\"\\\\\\\\\\\\\\\\n    paths = [path for path in root.rglob(name) if path.is_dir() == is_dir and \\\\\\\\\\\\\\\\\\\\'__MACOSX\\\\\\\\\\\\\\\\\\\\' not in path.relative_to(root).parts]\\\\\\\\\\\\\\\\n    if len(paths) != 1:\\\\\\\\\\\\\\\\n        raise ParticipantVisibleError(f\\\\\\\\\\\\\\\\\\\\'The submission must contain exactly one {description}, found {len(paths)}.\\\\\\\\\\\\\\\\\\\\')\\\\\\\\\\\\\\\\n    return paths[0]\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\\ndef preflight_directory(directory):\\\\\\\\\\\\\\\\n    root = pathlib.Path(directory).resolve()\\\\\\\\\\\\\\\\n    inv_path = find_one(root, \\\\\\\\\\\\\\\\\\\\'invsqrt.km[xb]\\\\\\\\\\\\\\\\\\\\', \\\\\\\\\\\\\\\\\\\\'inverse circuit\\\\\\\\\\\\\\\\\\\\')\\\\\\\\\\\\\\\\n    dqi_path = find_one(root, \\\\\\\\\\\\\\\\\\\\'dqi.km[xb]\\\\\\\\\\\\\\\\\\\\', \\\\\\\\\\\\\\\\\\\\'DQI circuit\\\\\\\\\\\\\\\\\\\\')\\\\\\\\\\\\\\\\n    chemistry = find_one(root, \\\\\\\\\\\\\\\\\\\\'dfthcsos\\\\\\\\\\\\\\\\\\\\', \\\\\\\\\\\\\\\\\\\\'chemistry directory\\\\\\\\\\\\\\\\\\\\', is_dir=True)\\\\\\\\\\\\\\\\n    inv = read_circuit(inv_path, 1)\\\\\\\\\\\\\\\\n    inv_qubits = inv.num_qubits\\\\\\\\\\\\\\\\n    del inv\\\\\\\\\\\\\\\\n    decoder = read_circuit(dqi_path, 4095 + 70)\\\\\\\\\\\\\\\\n    decoder_qubits = decoder.num_qubits\\\\\\\\\\\\\\\\n    del decoder\\\\\\\\\\\\\\\\n    angles = sorted(chemistry.glob(\\\\\\\\\\\\\\\\\\\\'angle_k_*.km[xb]\\\\\\\\\\\\\\\\\\\\'))\\\\\\\\\\\\\\\\n    if not angles or {p.stem for p in angles} != {f\\\\\\\\\\\\\\\\\\\\'angle_k_{i}\\\\\\\\\\\\\\\\\\\\' for i in range(len(angles))}:\\\\\\\\\\\\\\\\n        raise ValueError(\\\\\\\\\\\\\\\\\\\\'Angle circuits must have consecutive numbering with no duplicate formats\\\\\\\\\\\\\\\\\\\\')\\\\\\\\\\\\\\\\n    angle_widths = []\\\\\\\\\\\\\\\\n    for path in angles:\\\\\\\\\\\\\\\\n        circuit = read_circuit(path, 128)\\\\\\\\\\\\\\\\n        if circuit.num_qubits > 128:\\\\\\\\\\\\\\\\n            raise ValueError(\\\\\\\\\\\\\\\\\\\\'ANGLE circuit exceeds the 128-qubit cap\\\\\\\\\\\\\\\\\\\\')\\\\\\\\\\\\\\\\n        angle_widths.append(circuit.num_qubits)\\\\\\\\\\\\\\\\n        del circuit\\\\\\\\\\\\\\\\n    specification = {\\\\\\\\\\\\\\\\n        \\\\\\\\\\\\\\\\\\\\'U\\\\\\\\\\\\\\\\\\\\': (\\\\\\\\\\\\\\\\\\\\'f\\\\\\\\\\\\\\\\\\\\', (\\\\\\\\\\\\\\\\\\\\'R\\\\\\\\\\\\\\\\\\\\', \\\\\\\\\\\\\\\\\\\\'B\\\\\\\\\\\\\\\\\\\\', 76)), \\\\\\\\\\\\\\\\\\\\'W\\\\\\\\\\\\\\\\\\\\': (\\\\\\\\\\\\\\\\\\\\'f\\\\\\\\\\\\\\\\\\\\', (\\\\\\\\\\\\\\\\\\\\'R\\\\\\\\\\\\\\\\\\\\', \\\\\\\\\\\\\\\\\\\\'B\\\\\\\\\\\\\\\\\\\\', \\\\\\\\\\\\\\\\\\\\'C\\\\\\\\\\\\\\\\\\\\')),\\\\\\\\\\\\\\\\n        \\\\\\\\\\\\\\\\\\\\'H2_I\\\\\\\\\\\\\\\\\\\\': (\\\\\\\\\\\\\\\\\\\\'f\\\\\\\\\\\\\\\\\\\\', (\\\\\\\\\\\\\\\\\\