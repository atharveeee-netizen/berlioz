mport search as pair_search\\\\\\\\nfrom gauge_cayley_search import run as cayley_search\\\\\\\\n\\\\\\\\ndef sha(p):\\\\\\\\n    with Path(p).open(\\\\'rb\\\\') as f:return hashlib.file_digest(f,\\\\'sha256\\\\').hexdigest()\\\\\\\\nPIN=\\\\'3a9e255aa5ecde5fe13c315cebb193d524ac40f16859948966766edd88233df4\\\\'\\\\\\\\nsource=next(p for p in INPUT.rglob(\\\\'submission.zip\\\\') if sha(p)==PIN)\\\\\\\\nwith zipfile.ZipFile(source) as z:\\\\\\\\n    assert len(z.namelist())==18 and len(set(z.namelist()))==18\\\\\\\\n    baseline_hashes={}\\\\\\\\n    for name in z.namelist():\\\\\\\\n        assert not Path(name).is_absolute() and \\\\'..\\\\' not in Path(name).parts\\\\\\\\n        path=SUB/name;path.parent.mkdir(exist_ok=True,parents=True)\\\\\\\\n        with z.open(name) as f,path.open(\\\\'wb\\\\') as g:shutil.copyfileobj(f,g)\\\\\\\\n        baseline_hashes[name]=sha(path)\\\\\\\\n\\\\\\\\nfactor=SUB/\\\\'dfthcsos/submission.npz\\\\'\\\\\\\\ninitial=WORK/\\\\'initial.npz\\\\';shutil.copyfile(factor,initial)\\\\\\\\nSALT=\\\\'quantumai-oct29-chemistry-comparison\\\\'\\\\\\\\nbaseline=chemistry.verify(str(factor.parent),salt=SALT)\\\\\\\\nassert baseline[\\\\'status\\\\']==\\\\'PASS\\\\'\\\\\\\\n(REPORTS/\\\\'baseline_chemistry.json\\\\').write_text(json.dumps(baseline,indent=2))\\\\\\\\n\\\\\\\\ndef numerical(path):\\\\\\\\n    with np.load(path,allow_pickle=False) as z:\\\\\\\\n        return chemistry.evaluate_words(chemistry.load_inputs(path),z[\\\\'angle_words\\\\'],z[\\\\'tree_edges\\\\'],int(z[\\\\'brot\\\\']))\\\\\\\\n\\\\\\\\ncurrent=initial\\\\\\\\nbase_numerical=numerical(initial)\\\\\\\\nbest_value=float(base_numerical[\\\\'lambda_eff\\\\']);history=[]\\\\\\\\ndef consider(path,stage):\\\\\\\\n    global current,best_value\\\\\\\\n    if not path.exists():return\\\\\\\\n    try:\\\\\\\\n        metrics=numerical(path)\\\\\\\\n        with np.load(initial,allow_pickle=False) as a,np.load(path,allow_pickle=False) as b:\\\\\\\\n            assert set(a.f